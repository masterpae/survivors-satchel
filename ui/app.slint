// Survivor's Satchel: the tray icon, the main window, and the Play card.
import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, Palette, ScrollView, Spinner, Switch, VerticalBox } from "std-widgets.slint";

// The tray colour, and the shape inside the satchel, is the sync state.
export enum TrayState { synced, busy, playing, needs-you, offline }

export struct CardLine {
    text: string,
    done: bool,
    warn: bool,
}

export struct PcTime {
    name: string,
    time: string,
    share: float,
}

// A line of Home's Recent activity; `kind` picks its icon: 0 sync, 1 addon, 2 game, 3 playtime,
// 4 warning, 5 the Satchel itself; `when`, right-aligned: "2 min ago", "yesterday 21:40".
export struct RecentLine {
    kind: int,
    text: string,
    when: string,
}

// One of the last seven days in Home's playtime chart: its weekday ("Thu", "Today" for the
// last), its minutes as the bar's share of the tallest day (0 to 1), and its minutes.
export struct DayBar {
    label: string,
    share: float,
    minutes: int,
}

// One session in the playtime card's table: its day, its PC, its length.
export struct SessionRow {
    day: string,
    pc: string,
    minutes: string,
}

// One PC in Home's Your PCs card: its name, whether it is this PC, and "played today · synced
// 2 min ago" for the right.
export struct PcRow {
    name: string,
    this-pc: bool,
    line: string,
}

// A button of a Needs-you question: its words, what it does (`action`, as the app numbers them:
// 0 keep this PC's progress, 1 use the other PC's, 2 keep this PC's game settings, 3 use the
// other PC's, 4 use this PC's own from before it joined, 5 keep this PC's addon settings, 6 use the
// other PC's, 7 Install anyway, 8 Show what it found, 9 Open Settings) and the addon it names.
export struct QuestionButton {
    text: string,
    action: int,
    id: string,
}

// One question on Home's Needs-you card.
export struct QuestionRow {
    text: string,
    buttons: [QuestionButton],
}

// One row of Settings' Progress versions: the version ("v27", or the file's name), when, the PC,
// the size, its note; `current`: the one you play (bold, no button); `can-bring`: Bring this one in.
export struct SaveRow {
    version: string,
    when: string,
    from: string,
    size: string,
    note: string,
    current: bool,
    can-bring: bool,
}

// A badge: its words, and `kind`, its colour (`Look.badge-ink`): 0 Discord Verified, 1 added by
// link or no longer listed, 2 from a file, 3 by hand, 4 SurvivorsForge lets it in (verified,
// scanned), 5 it waits for the player's OK (flagged, unscanned), 6 never (blocked).
export struct BadgeRow {
    text: string,
    kind: int,
}

// An addon in AddOns. `badge-kind` (the Initials' colour): 0 Discord Verified, 1 added by link,
// 2 from a file, 3 by hand, 4 SurvivorsForge only. `badges`: every badge that applies, shown in
// place of `badge` when there are any. `state-kind`: 0 plain, 1 an update, 2 needs a look. `icon`:
// its icon from SurvivorsForge, empty until the window holds it (the initials show).
export struct AddonRow {
    id: string,
    initials: string,
    icon: image,
    name: string,
    badge: string,
    badge-kind: int,
    badges: [BadgeRow],
    author: string,
    version: string,
    released: string,
    update: string,
    state: string,
    state-kind: int,
    on: bool,
    switchable: bool,
    problem: string,
    problems: string,
    notes: string,
    notes-title: string,
    back-to: string,
    pinned: bool,
    can-pin: bool,
    can-update: bool,
    has-page: bool,
    replace-with: string,
    installing: bool,
    // About the other PCs; `share-kind`: 0 plain, 1 news, 2 needs a look.
    share: string,
    share-kind: int,
    shared: bool,
    local-only: bool,
    settings-per-pc: bool,
    // Its settings changed here and on this PC: the player picks.
    ask-pc: string,
    // Another PC has it; it comes here at the next Play.
    incoming: bool,
    // SurvivorsForge's word against its update, as a sentence; `reason-kind` 1: it waits for the
    // player's OK (Update anyway), 2: never (no update button).
    reason: string,
    reason-kind: int,
    // The Safety column: SurvivorsForge's level (`safety`, coloured by `safety-kind` as its badge)
    // with "SurvivorsForge" under it (`safety-by`), else its badge's word on one line.
    safety: string,
    safety-kind: int,
    safety-by: string,
    // The Status column's one line; `status-kind` 0 plain, 1 good news, 2 needs a look, 3 never.
    status: string,
    status-kind: int,
}

// An addon removed on this PC (the Addons tab's Removed page).
export struct RemovedRow {
    id: string,
    initials: string,
    name: string,
    badge: string,
    badge-kind: int,
    version: string,
    when: string,
    detail: string,
    can-install: bool,
    note: string,
    // SurvivorsForge's word on the version it had: `reason-kind` 1 it waits for the player's OK
    // (its button reads Install anyway), 2 never (no button).
    reason: string,
    reason-kind: int,
}

// A block of a version's changes: `kind` 0 a paragraph, 1 a heading, 2 a point, 3 a point inside
// a point, 4 an aside in muted text (the game's notes: "The full notes are on the game's Discord").
export struct ChangelogBlock {
    kind: int,
    text: string,
}

export struct ChangelogEntry {
    version: string,
    date: string,
    blocks: [ChangelogBlock],
}

// The Settings fields as they are saved (every setting applies the moment it changes; Browse
// reads the SurvivorsForge switch from here).
export struct SettingsForm {
    game-dir: string,
    sync: bool,
    folder: string,
    pc-name: string,
    start-with-windows: bool,
    desktop-shortcut: bool,
    notifications: bool,
    addons-auto: bool,
    addons-shared: bool,
    addons-forge: bool,
    pause-when-away: bool,
    theme: int,
    game-shared: bool,
    // Browse's view as saved (list, cards, table): not one of Settings' fields.
    browse-view: string,
}

// An addon on offer in Browse: one card, list row or table row. `initials-kind` colours its
// Initials (0 our list, 4 SurvivorsForge only); `icon` stands in for them once the window holds it.
// `downloads`: "8,382 downloads", or empty. `action`, as its pane's: 0 Install, 1 Install anyway
// (it asks first: a click opens it), 2 Installing…, 3 Installed, 4 Update, 5 Update anyway (asks
// first, as 1). `installed`: in AddOns (a check mark after its name); `installed-id`: its row in
// the Installed tab, which Uninstall removes, and `installed-name` that row's name, which the
// question names (both empty when no row is this addon alone: no Uninstall). The lists it is on
// (`ours`, `forge`). The table's
// columns: who vouches for it (`safety`, coloured by `safety-kind` as its badge, with `safety-by`
// under it), its tags in a line, its downloads as a number (`popularity`, empty when unknown), and
// the Install column's button (`install-text`, the primary kind when `install-primary`).
export struct OfferRow {
    id: string,
    initials: string,
    icon: image,
    initials-kind: int,
    name: string,
    author: string,
    downloads: string,
    summary: string,
    badges: [BadgeRow],
    version: string,
    date: string,
    action: int,
    reason: string,
    warning: string,
    installed: bool,
    installed-id: string,
    installed-name: string,
    ours: bool,
    forge: bool,
    safety: string,
    safety-kind: int,
    safety-by: string,
    tags: string,
    popularity: string,
    install-text: string,
    install-primary: bool,
}

// A tag chip in Browse's filters, on or off (none on: every tag).
export struct TagRow {
    text: string,
    on: bool,
}

// One version's downloads in the panel: `share` of the largest count, for the bar's length.
export struct BarRow {
    label: string,
    count: string,
    share: float,
}

// One screenshot in an addon's pictures row: its shape, as its details give it, its caption, and
// its thumbnail once the window holds it (empty until then: the placeholder frame shows).
export struct PictureRow {
    width: int,
    height: int,
    caption: string,
    thumb: image,
}

// What Browse shows of the addon opened (the cards' panel, the list's open row, the table's pane);
// `id` names the offer it is for. `action`: 0 Install, 1 Install anyway, 2 Installing…,
// 3 Installed, 4 Update, 5 Update anyway (`reason` above 1 and 5). `pictures`: its pictures row.
export struct PanelRow {
    id: string,
    verified-author: bool,
    about: string,
    about-more: string,
    notes-title: string,
    notes: string,
    bars: [BarRow],
    scan: string,
    scan-more: bool,
    findings: [string],
    folders: string,
    pictures: [PictureRow],
    action: int,
    reason: string,
    loading: bool,
    error: string,
}

// One version in Versions…: `marks` ("installed", "kept on 20 Oct"), `detail` (date, downloads,
// size, the game range, what the scan found), SurvivorsForge's `badge`. `action`: 0 none, 1 Go back
// to this (`key` names its backup), 2 Install this version, 3 Install anyway (`key` its tag;
// `reason` says why it asks), 4 installing. `reason-kind` 1 it waits for an OK, 2 never.
export struct VersionItem {
    version: string,
    marks: string,
    detail: string,
    badge: string,
    badge-kind: int,
    action: int,
    key: string,
    reason: string,
    reason-kind: int,
}

// Versions… for one addon (`id`), newest first; `loading`: SurvivorsForge's versions on their way.
export struct VersionsRow {
    id: string,
    name: string,
    rows: [VersionItem],
    loading: bool,
}

// The app's own colours (0.9's design mock), each in a dark and a light version; `dark` follows
// the window's theme. The surfaces: the window, the panel (the rail, the cards, the tables, the
// pane, Settings' boxes), the alternate box, hover, the line, the selected row.
global Look {
    in-out property <bool> dark;
    out property <color> bg: dark ? #14171d : #f6f7f9;
    out property <color> panel: dark ? #1b1f27 : #ffffff;
    out property <color> alt: dark ? #171a21 : #fafbfc;
    out property <color> hover: dark ? #222733 : #eef0f4;
    out property <color> line: dark ? #2b313c : #d9dde4;
    out property <color> text: dark ? #e8ebf0 : #1b1f27;
    out property <color> muted: dark ? #9aa1ab : #5f6672;
    // Play, the links, the active tab's line; the gear.
    out property <color> accent: #2f7cf6;
    out property <color> accent2: #2766cc;
    out property <color> green: dark ? #3cb371 : #1f8a4c;
    out property <color> amber: dark ? #e0a526 : #b56d00;
    out property <color> red: dark ? #e5534b : #b3312a;
    out property <color> sel: dark ? #1c2a44 : #e3edfd;
    // The badges' papers: green (what is let in), amber (what waits for an OK).
    out property <color> gpaper: dark ? #183326 : #e3f3e9;
    out property <color> apaper: dark ? #3a2f14 : #fbf0dc;
    // The tray's gold on the progress dot while the game runs, and the blue for a download.
    out property <color> gold: dark ? #e0b453 : #a8770c;
    out property <color> blue: accent;
    // Text on a tinted panel (a passing message), and that panel.
    out property <color> ink: text;
    out property <color> note-paper: sel;
    // Who vouches for an addon: Discord Verified (green), added by link (blue), from a file
    // (gold), by hand (muted); then SurvivorsForge's word: it lets it in (green, as the mock has
    // it), it waits for the player's OK (amber), never (red). Every ink reads at 4.5:1 or more on
    // its paper, in both themes (checked in the 0.9 pull request).
    public pure function badge-ink(kind: int) -> color {
        kind == 0 || kind == 4 ? green : kind == 1 ? (dark ? #78a9f5 : #2361c4) : kind == 2 ? gold
            : kind == 5 ? (dark ? amber : #9a5c00) : kind == 6 ? (dark ? #f1867e : red) : muted
    }
    public pure function badge-paper(kind: int) -> color {
        kind == 0 || kind == 4 ? gpaper : kind == 5 ? apaper
            : dark ? (kind == 1 ? #1e2c46 : kind == 2 ? #3d3220 : kind == 6 ? #43231f : #2b2f36)
            : (kind == 1 ? #e6eefb : kind == 2 ? #f8efd9 : kind == 6 ? #fbe9e7 : #eceef1)
    }
    // The rail's dots: 0 green (synced), 1 blue (busy), 2 gold (playing), 3 amber (needs you or
    // offline), 4 muted (nothing yet).
    public pure function dot(kind: int) -> color {
        kind == 1 ? accent : kind == 2 ? gold : kind == 3 ? amber : kind == 4 ? muted : green
    }
}

export component SatchelTray inherits SystemTrayIcon {
    in property <TrayState> state: TrayState.synced;
    in property <string> status: "Starting";
    in property <bool> sync-on;
    callback open-tab(int);
    callback play();
    callback sync-now();
    callback quit();

    icon: root.state == TrayState.busy ? @image-url("icons/satchel-blue.svg")
        : root.state == TrayState.playing ? @image-url("icons/satchel-gold.svg")
        : root.state == TrayState.needs-you ? @image-url("icons/satchel-red.svg")
        : root.state == TrayState.offline ? @image-url("icons/satchel-amber.svg")
        : @image-url("icons/satchel-green.svg");
    tooltip: "Survivor's Satchel · " + root.status;
    clicked => { root.open-tab(-1); }

    Menu {
        MenuItem {
            title: "Play Azeroth Survivors";
            activated => { root.play(); }
        }
        MenuItem {
            title: "Sync now";
            enabled: root.sync-on;
            activated => { root.sync-now(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Home…";
            activated => { root.open-tab(0); }
        }
        MenuItem {
            title: "Addons…";
            activated => { root.open-tab(1); }
        }
        MenuItem {
            title: "Settings…";
            activated => { root.open-tab(2); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Exit";
            activated => { root.quit(); }
        }
    }
}

// The small card in the corner while Play runs; it grows with its lines.
export component PlayCard inherits Window {
    in property <[CardLine]> lines;
    in property <bool> asking;
    // The lines' text as it wraps at this width, counted by the app: a wrapped line isn't measured
    // until the card has been laid out once, and the card is placed before that.
    in property <int> text-lines: 1;
    out property <length> wanted-height: min(max(120px, 48px + root.text-lines * 20px + root.lines.length * 6px + (root.asking ? 46px : 0px)), 460px);
    callback cancel();
    callback play-anyway();
    // A newer Satchel downloaded from GitHub: its version, and the button that puts it in place.
    in property <string> update-version;
    callback update-now();
    // Dark or light, as Settings' theme says.
    in property <bool> dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }

    title: "Survivor's Satchel";
    no-frame: true;
    always-on-top: true;
    width: 380px;
    height: root.wanted-height;
    default-font-size: 13px;
    background: Look.panel;

    Rectangle {
        border-width: 1px;
        border-color: Look.line;

        body := VerticalBox {
            alignment: start;
            Text {
                text: "Survivor's Satchel";
                font-weight: 700;
                color: Look.text;
            }
            for line in root.lines: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: line.done ? "✓" : line.warn ? "!" : "…";
                    width: 14px;
                    color: line.warn ? Look.amber : line.done ? Look.green : Look.text;
                    font-weight: 700;
                }
                Text {
                    text: line.text;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    color: Look.text;
                }
            }
            if root.asking: HorizontalBox {
                padding: 0;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                if root.update-version != "": Button {
                    text: "Update now";
                    primary: true;
                    clicked => { root.update-now(); }
                }
                Button {
                    text: "Play anyway";
                    primary: root.update-version == "";
                    clicked => { root.play-anyway(); }
                }
            }
        }
    }
}

// One of Home's cards (and the first start's box): a 13 px bold heading, 12 px padding, the panel
// colour, a 1 px line, 6 px corners; it grows with its content. `heading-right`: words at the
// heading's right end (the playtime card's ▾).
component HomeCard inherits Rectangle {
    in property <string> heading;
    in property <string> heading-right;
    background: Look.panel;
    border-width: 1px;
    border-color: Look.line;
    border-radius: 6px;

    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        if root.heading != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.heading;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                color: Look.text;
            }
            if root.heading-right != "": Text {
                text: root.heading-right;
                font-size: 13px;
                color: Look.muted;
            }
        }
        @children
    }
}

// A panel over the whole window, or over part of it; it swallows clicks meant for what is
// underneath. `hovered`: the mouse is over it (Browse's Legend stays open while it is).
component Overlay inherits Rectangle {
    out property <bool> hovered: touch.has-hover;
    background: Look.bg;
    touch := TouchArea { }
    @children
}

// A small button that is on or off: the pane's About and Versions. `enabled: false` greys it out
// and it ignores clicks.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Look.accent : Look.line;
    background: root.active ? Look.sel : touch.has-hover && root.enabled ? Look.hover : transparent;

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        Text {
            text: root.text;
            font-size: 12.5px;
            color: root.active ? Look.text : root.enabled ? Look.muted : Look.muted.with-alpha(0.6);
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One part of a segmented control: the Addons page's sub-pages, Settings' theme. `filled`: the
// selected part on the accent colour (the theme), else on the selection colour (the sub-pages).
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> filled;
    in property <bool> first;
    callback clicked();
    height: 28px;
    background: root.active ? (root.filled ? Look.accent : Look.sel) : touch.has-hover ? Look.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.active;
    // The line between two parts.
    if !root.first: Rectangle {
        x: 0;
        width: 1px;
        height: parent.height;
        background: Look.line;
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        Text {
            text: root.text;
            font-size: 12.5px;
            vertical-alignment: center;
            color: root.active ? (root.filled ? #ffffff : Look.text) : Look.muted;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One line of the gear's Game options popup.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? Look.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 12.5px;
            vertical-alignment: center;
            color: root.enabled ? Look.text : Look.muted;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A plain button in the app's own look: a 1 px line, 6 px corners, the panel colour; `primary` on
// the accent colour. The std Button stays where it is; this one sits in the cards, the rows and
// Settings, where the std one's look clashes with the mock's surfaces.
component PlainButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <length> font-size: 12.5px;
    callback clicked();
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.primary ? Look.accent : Look.line;
    background: !root.enabled ? Look.hover : root.primary ? (touch.has-hover ? Look.accent2 : Look.accent) : touch.has-hover ? Look.hover : Look.panel;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: root.font-size;
            vertical-alignment: center;
            color: !root.enabled ? Look.muted : root.primary ? #ffffff : Look.text;
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The square with an addon's initials, in the colour of who vouches for it; its icon from
// SurvivorsForge in their place once the window holds one. The square's size never changes.
component Initials inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <image> icon;
    in property <length> side: 34px;
    width: root.side;
    height: root.side;
    border-radius: root.side * 7 / 34;
    // An icon comes with the square's corners rounded already.
    background: root.icon.width > 0 ? transparent : Look.badge-paper(root.kind);
    clip: true;

    if root.icon.width == 0: Text {
        text: root.text;
        font-size: root.side * 12 / 34;
        font-weight: 700;
        color: Look.badge-ink(root.kind);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon.width > 0: Image {
        source: root.icon;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
}

// Who vouches for an addon; always shown.
component Badge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    border-radius: 4px;
    background: Look.badge-paper(root.kind);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: Look.badge-ink(root.kind);
            vertical-alignment: center;
        }
    }
}

// An install under way, where its button was; `text` names another wait (a check for updates).
// `small`: in a table's cell, its spinner and words smaller.
component Installing inherits HorizontalLayout {
    in property <string> text: "Installing…";
    in property <bool> small;
    spacing: root.small ? 4px : 6px;
    alignment: start;
    // A fixed size overrides the spinner's own 30px minimum.
    Spinner {
        indeterminate: true;
        width: root.small ? 14px : 20px;
        height: root.small ? 14px : 20px;
    }
    if !root.small: Text {
        text: root.text;
        vertical-alignment: center;
        color: Look.muted;
    }
    if root.small: Text {
        text: root.text;
        font-size: 11px;
        vertical-alignment: center;
        color: Look.muted;
    }
}

// The bold green check mark after an installed addon's name, 18 px, much bigger than 0.8's.
component CheckMark inherits Rectangle {
    width: 18px;
    height: 18px;
    accessible-role: image;
    accessible-label: "installed";
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 3 9.5 L 7.5 14 L 15.5 4.5";
        stroke: Look.green;
        stroke-width: 2.8px;
        fill: transparent;
    }
}

// A small button in a table's cell: the primary kind filled, the plain one outlined.
component RowButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.primary ? Look.accent : Look.line;
    background: !root.enabled ? Look.hover
        : root.primary ? (touch.has-hover ? Look.accent2 : Look.accent)
        : touch.has-hover ? Look.hover : Look.panel;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: root.primary ? 600 : 400;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: !root.enabled ? Look.muted : root.primary ? #ffffff : Look.text;
        }
    }
    // Greyed, a click on it still does nothing else: it never falls through to the row under it.
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The Safety column's cell: who vouches for an addon, its level coloured as its badge, and who gave
// the level under it (`by`, empty: one line).
component SafetyText inherits VerticalLayout {
    in property <string> word;
    in property <int> kind;
    in property <string> by;
    in property <bool> small;
    alignment: center;
    Text {
        text: root.word;
        font-size: root.small ? 11px : 11.5px;
        font-weight: 600;
        overflow: elide;
        // "scanned" is let in but not vouched for: plain, as the mock has it.
        color: root.word == "scanned" ? Look.text : Look.badge-ink(root.kind);
    }
    if root.by != "": Text {
        text: root.by;
        font-size: 10px;
        overflow: elide;
        color: Look.muted;
    }
}

// The Installed tab's columns, as wide as its rows and its headings both take them.
global InstalledColumns {
    out property <length> safety: 96px;
    out property <length> version: 120px;
    out property <length> released: 84px;
    out property <length> on: 52px;
    out property <length> spacing: 8px;
}

// One installed addon, a row of the Installed tab's columns: its square, name and author; who
// vouches for it; its version, and the one an update brings; when it was released; its status in
// one line (`status-width` wide); its switch. A click on the row opens what can be done with it
// under the row: its badges, every line about it whole, the problems, the notes, the buttons and the
// check boxes.
component AddonTableRow inherits Rectangle {
    in property <AddonRow> addon;
    in property <bool> open;
    in property <bool> busy;
    in property <length> status-width;
    callback toggle();
    callback switched(bool);
    callback update();
    // SurvivorsForge asks first about its update: the player OKs it.
    callback update-anyway();
    callback replace();
    callback back();
    callback keep(bool);
    callback page();
    callback folder();
    callback remove();
    callback local-only(bool);
    callback settings-per-pc(bool);
    callback settings-choice(bool);
    // Versions…, for an installed addon.
    callback versions();
    // An incoming addon that waits for the player's OK: Install anyway.
    callback install-anyway();
    property <color> status-ink: root.addon.status-kind == 1 ? Look.green
        : root.addon.status-kind == 2 ? Look.amber : root.addon.status-kind == 3 ? Look.red : Look.muted;

    // The line under the row.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Look.line;
    }
    VerticalLayout {
        Rectangle {
            height: 48px;
            background: root.open ? Look.sel : row-touch.has-hover ? Look.hover : transparent;
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                // Clear of the scroll bar, as the headings are.
                padding-right: 14px;
                spacing: InstalledColumns.spacing;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    min-width: 140px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Initials {
                            text: root.addon.initials;
                            kind: root.addon.badge-kind;
                            icon: root.addon.icon;
                            side: 28px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.addon.name;
                            font-size: 12px;
                            font-weight: 600;
                            overflow: elide;
                            color: Look.text;
                        }
                        if root.addon.author != "": Text {
                            text: root.addon.author;
                            font-size: 10px;
                            color: Look.muted;
                            overflow: elide;
                        }
                    }
                }
                SafetyText {
                    width: InstalledColumns.safety;
                    word: root.addon.safety;
                    kind: root.addon.safety-kind;
                    by: root.addon.safety-by;
                }
                HorizontalLayout {
                    width: InstalledColumns.version;
                    spacing: 4px;
                    Text {
                        text: root.addon.version;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.addon.update != "": Text {
                        text: "→ " + root.addon.update;
                        font-size: 11px;
                        font-weight: 600;
                        color: Look.green;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    width: InstalledColumns.released;
                    text: root.addon.released;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    width: root.status-width;
                    text: root.addon.status;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    color: root.status-ink;
                }
                VerticalLayout {
                    width: InstalledColumns.on;
                    alignment: center;
                    if !root.addon.incoming: HorizontalLayout {
                        alignment: end;
                        Switch {
                            checked: root.addon.on;
                            enabled: root.addon.switchable && !root.busy;
                            toggled => { root.switched(self.checked); }
                        }
                    }
                }
            }
        }
        if root.open: VerticalLayout {
            padding: 10px;
            padding-top: 6px;
            spacing: 6px;
            // Every badge that applies; a row without them shows its one badge.
            HorizontalLayout {
                spacing: 4px;
                if root.addon.badges.length == 0: VerticalLayout {
                    alignment: center;
                    Badge {
                        text: root.addon.badge;
                        kind: root.addon.badge-kind;
                    }
                }
                for badge in root.addon.badges: VerticalLayout {
                    alignment: center;
                    Badge {
                        text: badge.text;
                        kind: badge.kind;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // Every line about it, whole: where it stands, SurvivorsForge's word, the other PCs.
            if root.addon.state != "": Text {
                text: root.addon.state;
                font-size: 12px;
                wrap: word-wrap;
                color: root.addon.state-kind == 1 ? Look.green : root.addon.state-kind == 2 ? Look.amber : Look.muted;
            }
            if root.addon.reason != "": Text {
                text: root.addon.reason;
                font-size: 12px;
                wrap: word-wrap;
                color: root.addon.reason-kind == 2 ? Look.red : Look.amber;
            }
            if root.addon.share != "": Text {
                text: root.addon.share;
                font-size: 12px;
                wrap: word-wrap;
                color: root.addon.share-kind == 1 ? Look.green : root.addon.share-kind == 2 ? Look.amber : Look.muted;
            }
            if root.addon.problems != "": Text {
                text: root.addon.problems;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.amber;
            }
            if root.addon.notes != "": Text {
                text: root.addon.notes-title;
                font-size: 12px;
                font-weight: 600;
            }
            if root.addon.notes != "": Text {
                text: root.addon.notes;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.addon.ask-pc != "": HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button {
                    text: "Keep this PC's";
                    enabled: !root.busy;
                    clicked => { root.settings-choice(true); }
                }
                Button {
                    text: "Use " + root.addon.ask-pc + "'s";
                    enabled: !root.busy;
                    clicked => { root.settings-choice(false); }
                }
            }
            // Another PC has it, and SurvivorsForge asks first here: the player's OK, on its row.
            if root.addon.incoming: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.addon.installing: Installing {}
                if root.addon.reason-kind == 1 && !root.addon.installing: Button {
                    text: "Install anyway";
                    enabled: !root.busy;
                    clicked => { root.install-anyway(); }
                }
                if root.addon.has-page: Button {
                    text: "GitHub page";
                    clicked => { root.page(); }
                }
            }
            if !root.addon.incoming: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.addon.installing: Installing {}
                // Update now; Update anyway when SurvivorsForge asks first; none when it says never.
                if root.addon.can-update && !root.addon.installing && root.addon.reason-kind == 0: Button {
                    text: "Update now";
                    primary: true;
                    enabled: !root.busy;
                    clicked => { root.update(); }
                }
                if root.addon.can-update && !root.addon.installing && root.addon.reason-kind == 1: Button {
                    text: "Update anyway";
                    enabled: !root.busy;
                    clicked => { root.update-anyway(); }
                }
                if root.addon.replace-with != "" && !root.addon.installing && root.addon.reason-kind != 2: Button {
                    text: "Replace with " + root.addon.replace-with;
                    enabled: !root.busy;
                    clicked => { root.replace(); }
                }
                if root.addon.back-to != "": Button {
                    text: "Go back to " + root.addon.back-to;
                    enabled: !root.busy;
                    clicked => { root.back(); }
                }
                Button {
                    text: "Versions…";
                    clicked => { root.versions(); }
                }
            }
            if !root.addon.incoming: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.addon.has-page: Button {
                    text: "GitHub page";
                    clicked => { root.page(); }
                }
                Button {
                    text: "Folder";
                    clicked => { root.folder(); }
                }
                Button {
                    text: "Remove…";
                    enabled: !root.busy;
                    clicked => { root.remove(); }
                }
            }
            if root.addon.can-pin: CheckBox {
                text: "Keep this version: no updates until I untick this";
                checked: root.addon.pinned;
                toggled => { root.keep(self.checked); }
            }
            if root.addon.shared: CheckBox {
                text: "Only on this PC: not shared with my other PCs";
                checked: root.addon.local-only;
                toggled => { root.local-only(self.checked); }
            }
            if root.addon.shared && !root.addon.local-only: CheckBox {
                text: "Settings per PC: each PC keeps its own (on every PC)";
                checked: root.addon.settings-per-pc;
                toggled => { root.settings-per-pc(self.checked); }
            }
        }
    }
}

// One addon in Browse, as a card; a click anywhere but its button opens its panel. Its badges
// go one per line: two side by side don't fit a card of the two columns at 540 px, and Slint has
// no layout that wraps. Cards in one row of the grid share its height; the footer stays at the foot.
component OfferItem inherits Rectangle {
    in property <OfferRow> offer;
    // Its panel is open.
    in property <bool> current;
    in property <bool> busy;
    callback open();
    callback install();
    border-width: 1px;
    border-color: root.current ? Look.accent : Look.line;
    border-radius: 6px;
    background: touch.has-hover ? Look.hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: root.offer.name;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    if root.offer.installed: VerticalLayout {
                        alignment: center;
                        CheckMark {}
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.offer.author + (root.offer.downloads != "" ? " · " + root.offer.downloads : "");
                    font-size: 11px;
                    color: Look.muted;
                    overflow: elide;
                }
            }
        }
        // Two lines at most.
        Text {
            text: root.offer.summary;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            max-height: 34px;
        }
        if root.offer.warning != "": Text {
            text: "⚠ " + root.offer.warning;
            font-size: 11px;
            wrap: word-wrap;
            color: Look.amber;
        }
        VerticalLayout {
            spacing: 3px;
            for badge in root.offer.badges: HorizontalLayout {
                Badge {
                    text: badge.text;
                    kind: badge.kind;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.offer.version + (root.offer.date != "" ? " · " + root.offer.date : "");
                font-size: 12px;
                color: Look.muted;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            // Installed, with a newer version or not (its panel has Update).
            if root.offer.action >= 3: Text {
                text: "Installed";
                font-size: 12px;
                color: Look.green;
                vertical-alignment: center;
            }
            if root.offer.action == 2: Installing {}
            if root.offer.action == 0: Button {
                text: "Install";
                enabled: !root.busy;
                clicked => { root.install(); }
            }
            // It asks first: the panel says why, with Install anyway.
            if root.offer.action == 1: Button {
                text: "Install…";
                enabled: !root.busy;
                clicked => { root.open(); }
            }
        }
    }
}

// A line of Browse's Legend: a badge, and what it means. The badge column fits the longest
// badge, "SurvivorsForge · no longer listed".
component LegendLine inherits HorizontalLayout {
    in property <string> badge;
    in property <int> kind;
    in property <string> text;
    spacing: 8px;
    VerticalLayout {
        alignment: start;
        width: 214px;
        HorizontalLayout {
            Badge {
                text: root.badge;
                kind: root.kind;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Text {
        text: root.text;
        font-size: 11px;
        wrap: word-wrap;
        horizontal-stretch: 1;
        color: Look.muted;
    }
}

// One section of Settings: a bordered box with its 13 px bold heading, 10 px padding; the boxes
// alternate the panel and the alternate colour, so each is easy to find.
component Section inherits Rectangle {
    in property <string> heading;
    in property <bool> alternate;
    border-radius: 6px;
    border-width: 1px;
    border-color: Look.line;
    background: root.alternate ? Look.alt : Look.panel;
    VerticalLayout {
        padding: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 2px;
        Text {
            text: root.heading;
            font-size: 13px;
            font-weight: 600;
            color: Look.text;
        }
        @children
    }
}

// One row of a Settings section: its words (and a smaller line under them) on the left, "✓ Saved"
// in the 54 px before its control, and the control (a switch, a segmented choice, a field) on
// the right. "✓ Saved" shows the moment the value applied and fades out over 0.4 s after a second.
component SettingRow inherits HorizontalLayout {
    in property <string> text;
    in property <string> detail;
    in property <bool> saved;
    spacing: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12.5px;
            wrap: word-wrap;
            color: Look.text;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 11.5px;
            wrap: word-wrap;
            color: Look.muted;
        }
    }
    Text {
        text: "✓ Saved";
        width: 54px;
        font-size: 11.5px;
        color: Look.green;
        vertical-alignment: center;
        opacity: root.saved ? 1 : 0;
        animate opacity { duration: root.saved ? 0ms : 400ms; }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

component LinkText inherits Rectangle {
    in property <string> text;
    in property <color> ink: Look.muted;
    in property <length> font-size: 11px;
    callback clicked();
    HorizontalLayout {
        Text {
            text: root.text;
            font-size: root.font-size;
            color: touch.has-hover ? Look.text : root.ink;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One of Browse's three views in its switch, as a small glyph (0 list, 1 cards, 2 table); marked
// when it is the view shown.
component ViewButton inherits Rectangle {
    in property <int> glyph;
    in property <bool> active;
    in property <string> label;
    callback clicked();
    property <color> ink: root.active ? Look.accent : touch.has-hover ? Look.text : Look.muted;
    width: 28px;
    height: 26px;
    background: root.active ? Look.sel : touch.has-hover ? Look.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;

    // List: three lines.
    if root.glyph == 0: Rectangle {
        x: 7px;
        y: 7px;
        width: 14px;
        height: 12px;
        Rectangle { x: 0; y: 0; width: 14px; height: 2px; background: root.ink; }
        Rectangle { x: 0; y: 5px; width: 14px; height: 2px; background: root.ink; }
        Rectangle { x: 0; y: 10px; width: 14px; height: 2px; background: root.ink; }
    }
    // Cards: four of them.
    if root.glyph == 1: Rectangle {
        x: 7px;
        y: 7px;
        width: 14px;
        height: 12px;
        Rectangle { x: 0; y: 0; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 8px; y: 0; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 0; y: 7px; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 8px; y: 7px; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
    }
    // Table: a frame with its header and a column.
    if root.glyph == 2: Rectangle {
        x: 7px;
        y: 7px;
        width: 14px;
        height: 12px;
        border-width: 1.5px;
        border-color: root.ink;
        border-radius: 1px;
        Rectangle { x: 0; y: 3.5px; width: 14px; height: 1.5px; background: root.ink; }
        Rectangle { x: 5px; y: 3.5px; width: 1.5px; height: 8.5px; background: root.ink; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An addon's pictures as a row of thumbnails: as many 88 × 55 px frames as fit the width it has
// (`room`; four at the narrowest pane, five from about 490 px), the last one carrying "+N" over it
// when more pictures exist. Their thumbnails come from the app, asked for as soon as the row shows
// (`frames` says how many frames it shows); until one is here, or when it couldn't be decoded, its
// frame holds a small landscape. A click on a frame opens the viewer on that picture.
component PicturesRow inherits HorizontalLayout {
    in property <[PictureRow]> pictures;
    in property <length> room: 400px;
    callback open(int);
    callback frames(int);
    // Frames of 88 px and their 6 px gaps.
    property <int> fit: max(1, floor((root.room + 6px) / 94px));
    property <int> shown: min(root.fit, root.pictures.length);
    property <int> more: root.pictures.length - root.shown;
    init => { root.frames(root.shown); }
    changed shown => { root.frames(root.shown); }
    spacing: 6px;
    alignment: start;
    for i in root.shown: Rectangle {
        width: 88px;
        height: 55px;
        background: Look.hover;
        accessible-role: button;
        accessible-label: "Picture " + (i + 1) + (root.pictures[i].caption != "" ? ": " + root.pictures[i].caption : "")
            + (i == root.shown - 1 && root.more > 0 ? ", and " + root.more + " more" : "");
        // Until its thumbnail is here: a sun and a hill.
        if root.pictures[i].thumb.width == 0: Rectangle {
            Rectangle {
                x: parent.width / 2 + 6px;
                y: 13px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Look.muted;
            }
            Path {
                x: parent.width / 2 - 14px;
                y: 22px;
                width: 28px;
                height: 20px;
                viewbox-width: 20;
                viewbox-height: 14;
                commands: "M 0 14 L 6 5 L 10 10 L 13 7 L 20 14 Z";
                fill: Look.muted;
            }
        }
        if root.pictures[i].thumb.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.pictures[i].thumb;
            image-fit: cover;
        }
        // The last frame, when more pictures exist: how many more, over it.
        if i == root.shown - 1 && root.more > 0: Rectangle {
            background: #0b0e13a8;
            Text {
                text: "+" + root.more;
                font-size: 15px;
                font-weight: 700;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        // The frame's edge, over the picture.
        Rectangle {
            border-width: 1px;
            border-radius: 3px;
            border-color: frame-touch.has-hover ? Look.accent : Look.line;
        }
        frame-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(i); }
        }
    }
}

// The opened addon's button, as its card says until the app's answer: Install, Install anyway,
// Installing…, Installed, Update, Update anyway.
component OfferAction inherits HorizontalLayout {
    in property <int> action;
    in property <bool> busy;
    callback install();
    callback install-anyway();
    callback update();
    callback update-anyway();
    spacing: 8px;
    if root.action == 3: Text {
        text: "Installed";
        font-size: 12px;
        color: Look.green;
        vertical-alignment: center;
    }
    if root.action == 2: Installing {}
    if root.action == 0: Button {
        text: "Install";
        primary: true;
        enabled: !root.busy;
        clicked => { root.install(); }
    }
    if root.action == 1: Button {
        text: "Install anyway";
        enabled: !root.busy;
        clicked => { root.install-anyway(); }
    }
    if root.action == 4: Button {
        text: "Update";
        primary: true;
        enabled: !root.busy;
        clicked => { root.update(); }
    }
    if root.action == 5: Button {
        text: "Update anyway";
        enabled: !root.busy;
        clicked => { root.update-anyway(); }
    }
}

// What an addon's details say about it: About (shown at once, its longer text behind "more"),
// What's new, and its downloads per version.
component AboutBlock inherits VerticalLayout {
    in property <PanelRow> panel;
    // The app's content for this addon has come.
    in property <bool> ready;
    in property <string> about;
    in property <bool> more-open;
    in property <bool> notes: true;
    in property <bool> bars: true;
    // About and its "more"; without, What's new and the downloads only.
    in property <bool> about-part: true;
    callback toggle-more();
    spacing: 8px;
    if root.about-part && root.about != "": Text {
        text: "About";
        font-weight: 600;
    }
    if root.about-part && root.about != "": Text {
        text: root.about;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.about-part && root.ready && root.panel.about-more != "" && root.more-open: Text {
        text: root.panel.about-more;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.about-part && root.ready && root.panel.about-more != "": HorizontalLayout {
        LinkText {
            text: root.more-open ? "less" : "more";
            ink: Look.blue;
            font-size: 12px;
            clicked => { root.toggle-more(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.ready && root.notes && root.panel.notes != "": Text {
        text: root.panel.notes-title;
        font-weight: 600;
    }
    if root.ready && root.notes && root.panel.notes != "": Text {
        text: root.panel.notes;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.ready && root.bars && root.panel.bars.length > 0: VerticalLayout {
        spacing: 4px;
        Text {
            text: "Downloads per version";
            font-weight: 600;
        }
        for bar in root.panel.bars: HorizontalLayout {
            spacing: 8px;
            Text {
                text: bar.label;
                width: 110px;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Rectangle {
                    height: 10px;
                    border-radius: 3px;
                    background: Look.hover;
                    Rectangle {
                        x: 0;
                        width: parent.width * bar.share;
                        height: parent.height;
                        border-radius: 3px;
                        background: Look.blue;
                    }
                }
            }
            Text {
                text: bar.count;
                width: 64px;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// SurvivorsForge's scan of the version shown, and what it found when asked.
component ScanBlock inherits VerticalLayout {
    in property <PanelRow> panel;
    callback show-scan();
    spacing: 4px;
    Text {
        text: "Scan";
        font-weight: 600;
    }
    Text {
        text: root.panel.scan;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.panel.scan-more: HorizontalLayout {
        LinkText {
            text: "Show what it found";
            ink: Look.blue;
            font-size: 12px;
            clicked => { root.show-scan(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    for finding in root.panel.findings: Text {
        text: "• " + finding;
        font-size: 11px;
        wrap: word-wrap;
    }
}

// One version in Versions…, with its one button.
component VersionLineItem inherits Rectangle {
    in property <VersionItem> item;
    in property <bool> busy;
    callback install(bool);
    callback back();
    border-width: 1px;
    border-color: Look.line;
    border-radius: 6px;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.version;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.item.badge != "": VerticalLayout {
                    alignment: center;
                    Badge {
                        text: root.item.badge;
                        kind: root.item.badge-kind;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.item.marks != "": Text {
                text: root.item.marks;
                font-size: 11px;
                wrap: word-wrap;
                color: Look.green;
            }
            if root.item.detail != "": Text {
                text: root.item.detail;
                font-size: 11px;
                wrap: word-wrap;
                color: Look.muted;
            }
            if root.item.reason != "": Text {
                text: root.item.reason;
                font-size: 11px;
                wrap: word-wrap;
                color: root.item.reason-kind == 2 ? Look.red : Look.amber;
            }
        }
        VerticalLayout {
            alignment: center;
            if root.item.action == 1: Button {
                text: "Go back to this";
                enabled: !root.busy;
                clicked => { root.back(); }
            }
            if root.item.action == 2: Button {
                text: "Install this version";
                enabled: !root.busy;
                clicked => { root.install(false); }
            }
            if root.item.action == 3: Button {
                text: "Install anyway";
                enabled: !root.busy;
                clicked => { root.install(true); }
            }
            if root.item.action == 4: Installing {}
        }
    }
}

// Versions… of one addon, newest first: the one installed, the ones kept for going back, every
// release and SurvivorsForge version known; one button each. It scrolls on its own.
component VersionsList inherits VerticalLayout {
    in property <VersionsRow> versions;
    // The app's list is for the addon asked for.
    in property <bool> ready;
    in property <bool> busy;
    callback install(string, bool);
    callback back(string);
    spacing: 6px;
    if !root.ready || root.versions.loading: Installing {
        text: "Loading…";
    }
    if root.ready && !root.versions.loading && root.versions.rows.length == 0: Text {
        text: "No versions of it are known here yet.";
        font-size: 12px;
        color: Look.muted;
    }
    versions-scroll := ScrollView {
        vertical-stretch: 1;
        content-height: versions-list.preferred-height;
        versions-list := VerticalLayout {
            width: versions-scroll.visible-width;
            height: self.preferred-height;
            alignment: start;
            spacing: 6px;
            if root.ready: VerticalLayout {
                spacing: 6px;
                for item in root.versions.rows: VersionLineItem {
                    item: item;
                    busy: root.busy;
                    install(anyway) => { root.install(item.key, anyway); }
                    back => { root.back(item.key); }
                }
            }
        }
    }
}

// One addon in Browse's list view, the whole width: the square, its name, author and badges, and
// under them one line with its summary, version and date. A click opens it in place (one row open
// at a time) with what its details say, its pictures, the scan in one line, Versions…, its GitHub
// page and its button.
component OfferListItem inherits Rectangle {
    in property <OfferRow> offer;
    in property <bool> open;
    in property <bool> busy;
    // The opened addon's content, once the app sent it for this row (`ready`).
    in property <PanelRow> panel;
    in property <bool> ready;
    in property <bool> more-open;
    callback toggle();
    callback toggle-more();
    callback picture(int);
    // Its pictures row shows this many frames.
    callback frames(int);
    callback versions();
    callback page();
    callback install();
    callback install-anyway();
    callback update();
    callback update-anyway();
    property <int> action: root.ready ? root.panel.action : root.offer.action;
    property <string> reason: root.ready ? root.panel.reason : root.offer.reason;
    property <string> about: root.ready && root.panel.about != "" ? root.panel.about : root.offer.summary;
    border-width: 1px;
    border-color: root.open ? Look.accent : Look.line;
    border-radius: 6px;
    background: touch.has-hover && !root.open ? Look.hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.offer.name;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    if root.offer.installed: VerticalLayout {
                        alignment: center;
                        CheckMark {}
                    }
                    Text {
                        text: root.offer.author;
                        font-size: 11px;
                        color: Look.muted;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    for badge in root.offer.badges: VerticalLayout {
                        alignment: center;
                        Badge {
                            text: badge.text;
                            kind: badge.kind;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: (root.offer.summary != "" ? root.offer.summary + " · " : "") + root.offer.version + (root.offer.date != "" ? " · " + root.offer.date : "");
                    font-size: 12px;
                    color: Look.muted;
                    overflow: elide;
                }
            }
            // Installed, with a newer version or not (the row opened has Update).
            if !root.open && root.action >= 3: VerticalLayout {
                alignment: center;
                Text {
                    text: "Installed";
                    font-size: 12px;
                    color: Look.green;
                }
            }
            if !root.open && root.action == 2: VerticalLayout {
                alignment: center;
                Installing {}
            }
        }
        if root.open: VerticalLayout {
            spacing: 8px;
            if !root.ready || root.panel.loading: Installing {
                text: "Loading…";
            }
            if root.ready && root.panel.error != "": Text {
                text: root.panel.error;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.amber;
            }
            if root.ready && root.panel.pictures.length > 0: PicturesRow {
                pictures: root.panel.pictures;
                room: root.width - 16px;
                open(i) => { root.picture(i); }
                frames(n) => { root.frames(n); }
            }
            AboutBlock {
                panel: root.panel;
                ready: root.ready;
                about: root.about;
                more-open: root.more-open;
                notes: false;
                bars: false;
                toggle-more => { root.toggle-more(); }
            }
            if root.ready && root.panel.scan != "": Text {
                text: "Scan: " + root.panel.scan;
                font-size: 12px;
                overflow: elide;
            }
            if root.offer.warning != "" && root.action < 3: Text {
                text: "⚠ " + root.offer.warning;
                font-size: 11px;
                wrap: word-wrap;
                color: Look.amber;
            }
            if (root.action == 1 || root.action == 5) && root.reason != "": Text {
                text: root.reason;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.amber;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Versions…";
                    clicked => { root.versions(); }
                }
                VerticalLayout {
                    alignment: center;
                    LinkText {
                        text: "GitHub page";
                        ink: Look.blue;
                        font-size: 12px;
                        clicked => { root.page(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                OfferAction {
                    action: root.action;
                    busy: root.busy;
                    install => { root.install(); }
                    install-anyway => { root.install-anyway(); }
                    update => { root.update(); }
                    update-anyway => { root.update-anyway(); }
                }
            }
        }
    }
}

// A column's heading in Browse's table; a sorting one says which way it sorts when it is the one
// sorted by (`mark`), and sorts by itself when clicked.
component TableHead inherits Rectangle {
    in property <string> text;
    in property <string> mark;
    in property <bool> sorts;
    // At the minimum window: smaller, and a heading may take two lines.
    in property <bool> small;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    callback clicked();
    height: root.small ? 34px : 28px;
    HorizontalLayout {
        Text {
            text: root.text + (root.mark != "" ? " " + root.mark : "");
            font-size: root.small ? 10.5px : 11.5px;
            overflow: elide;
            wrap: root.small ? TextWrap.word-wrap : TextWrap.no-wrap;
            horizontal-alignment: root.align;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.mark != "" || (root.sorts && head-touch.has-hover) ? Look.text : Look.muted;
        }
    }
    head-touch := TouchArea {
        enabled: root.sorts;
        mouse-cursor: root.sorts ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Browse's table's columns, as wide as its rows and its headings both take them; narrower at the
// minimum window (`small`), where the headings take two lines.
global TableColumns {
    public pure function safety(small: bool) -> length { small ? 92px : 110px }
    public pure function version(small: bool) -> length { small ? 60px : 76px }
    out property <length> tags: 150px;
    public pure function updated(small: bool) -> length { small ? 62px : 92px }
    public pure function popularity(small: bool) -> length { small ? 56px : 82px }
    public pure function install(small: bool) -> length { small ? 62px : 88px }
    public pure function spacing(small: bool) -> length { small ? 2px : 4px }
    public pure function padding(small: bool) -> length { small ? 6px : 10px }
    public pure function square(small: bool) -> length { small ? 24px : 28px }
}

// One addon in Browse's table: the square, its name (a check mark after it when it is installed)
// and author; who vouches for it; its version; its tags (`wide` only); Last updated; Popularity;
// and its Install column's button. A click on the row selects it; a click on the button does what
// it says, and selects the row only where the pane must say why it asks first (Install…, Update…).
component OfferTableRow inherits Rectangle {
    in property <OfferRow> offer;
    in property <bool> current;
    in property <bool> wide;
    in property <bool> small;
    in property <bool> busy;
    callback select();
    callback install();
    callback update();
    callback uninstall();
    height: 48px;
    background: root.current ? Look.sel : row-touch.has-hover ? Look.hover : transparent;
    property <length> text-size: root.small ? 11.5px : 12px;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    // The line under the row.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Look.line;
    }
    HorizontalLayout {
        padding-left: TableColumns.padding(root.small);
        // Clear of the scroll bar, as the headings are.
        padding-right: TableColumns.padding(root.small) + 4px;
        spacing: TableColumns.spacing(root.small);
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 70px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                    side: TableColumns.square(root.small);
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: root.offer.name;
                        font-size: root.text-size;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    if root.offer.installed: VerticalLayout {
                        alignment: center;
                        CheckMark {}
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.offer.author;
                    font-size: 10px;
                    color: Look.muted;
                    overflow: elide;
                }
            }
        }
        SafetyText {
            width: TableColumns.safety(root.small);
            word: root.offer.safety;
            kind: root.offer.safety-kind;
            by: root.offer.safety-by;
            small: root.small;
        }
        Text {
            width: TableColumns.version(root.small);
            text: root.offer.version;
            font-size: root.text-size;
            overflow: elide;
            vertical-alignment: center;
            color: Look.text;
        }
        if root.wide: Text {
            width: TableColumns.tags;
            text: root.offer.tags;
            font-size: root.text-size;
            color: Look.muted;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            width: TableColumns.updated(root.small);
            text: root.offer.date;
            font-size: root.text-size;
            overflow: elide;
            vertical-alignment: center;
            color: Look.text;
        }
        Text {
            width: TableColumns.popularity(root.small);
            text: root.offer.popularity;
            font-size: root.text-size;
            horizontal-alignment: right;
            overflow: elide;
            vertical-alignment: center;
            color: Look.text;
        }
        VerticalLayout {
            width: TableColumns.install(root.small);
            alignment: center;
            if root.offer.action == 2: Installing {
                small: true;
                text: root.offer.install-text;
            }
            // Installed, and the Installed tab's row isn't known: no Uninstall to offer.
            if root.offer.action == 3 && root.offer.installed-id == "": Text {
                text: "Installed";
                font-size: 11px;
                color: Look.green;
            }
            if root.offer.action != 2 && root.offer.install-text != "" && !(root.offer.action == 3 && root.offer.installed-id == ""): RowButton {
                text: root.offer.install-text;
                primary: root.offer.install-primary;
                enabled: !root.busy;
                clicked => {
                    if (root.offer.action == 0) {
                        root.install();
                    } else if (root.offer.action == 3) {
                        root.uninstall();
                    } else if (root.offer.action == 4) {
                        root.update();
                    } else {
                        // Install… and Update…: the pane says why it asks, with its button.
                        root.select();
                    }
                }
            }
        }
    }
}

// When the game isn't on this PC, or the Satchel can't find it: the way to it, in a column of the
// other tabs' width, centred.
component NoGame inherits Rectangle {
    callback find();
    callback choose();
    callback get-game();
    VerticalBox {
        width: min(680px, parent.width);
        height: parent.height;
        x: (parent.width - self.width) / 2;
        y: 0;
        alignment: center;
        Text {
            text: "Azeroth Survivors isn't here";
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "The Satchel can't find the game on this PC. If it's installed, let the Satchel look for it, or choose its folder. If it isn't, it comes from the game's website.";
            wrap: word-wrap;
            horizontal-alignment: center;
            color: Look.muted;
        }
        HorizontalBox {
            alignment: center;
            Button {
                text: "Find it";
                primary: true;
                clicked => { root.find(); }
            }
            Button {
                text: "Choose its folder";
                clicked => { root.choose(); }
            }
            Button {
                text: "Get the game";
                clicked => { root.get-game(); }
            }
        }
    }
}

// The Removed page's columns, in the table's style.
global RemovedColumns {
    out property <length> safety: 110px;
    out property <length> version: 76px;
    out property <length> removed: 120px;
    out property <length> button: 100px;
    out property <length> spacing: 6px;
}

// An addon removed on this PC, as a row of the Removed table: its square, name and author; who
// vouched for it; the version it had; when it was removed; its note, elided; and the way back
// (Install again, Install anyway where SurvivorsForge asks first, or none). A click on the row
// shows the whole note, and the reason, in a line under it.
component RemovedTableRow inherits Rectangle {
    in property <RemovedRow> removed;
    in property <bool> open;
    in property <bool> busy;
    in property <length> name-width;
    callback toggle();
    callback install();
    // SurvivorsForge asks first about the version it had: the player's OK.
    callback install-anyway();
    background: root.open ? Look.sel : row-touch.has-hover ? Look.hover : transparent;
    // The whole note: where its settings went, or why it can't come back, then SurvivorsForge's word.
    property <string> note: root.removed.note != "" ? root.removed.note : root.removed.detail;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Look.line;
    }
    VerticalLayout {
        HorizontalLayout {
            height: 48px;
            padding-left: 12px;
            padding-right: 14px;
            spacing: RemovedColumns.spacing;
            HorizontalLayout {
                width: root.name-width;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Initials {
                        text: root.removed.initials;
                        kind: root.removed.badge-kind;
                        side: 28px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.removed.name;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        color: Look.text;
                    }
                }
            }
            SafetyText {
                width: RemovedColumns.safety;
                word: root.removed.badge;
                kind: root.removed.badge-kind;
            }
            Text {
                width: RemovedColumns.version;
                text: root.removed.version;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                color: Look.text;
            }
            Text {
                width: RemovedColumns.removed;
                text: root.removed.when;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                color: Look.text;
            }
            Text {
                horizontal-stretch: 1;
                min-width: 80px;
                text: root.note;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                color: root.removed.note != "" ? Look.amber : Look.muted;
            }
            VerticalLayout {
                width: RemovedColumns.button;
                alignment: center;
                if root.removed.can-install && root.removed.reason-kind == 0: RowButton {
                    text: "Install again";
                    enabled: !root.busy;
                    clicked => { root.install(); }
                }
                if root.removed.can-install && root.removed.reason-kind == 1: RowButton {
                    text: "Install anyway";
                    enabled: !root.busy;
                    clicked => { root.install-anyway(); }
                }
            }
        }
        if root.open: VerticalLayout {
            padding-left: 12px;
            padding-right: 14px;
            padding-bottom: 8px;
            spacing: 4px;
            Text {
                text: root.note;
                font-size: 12px;
                wrap: word-wrap;
                color: root.removed.note != "" ? Look.amber : Look.muted;
            }
            if root.removed.reason != "": Text {
                text: root.removed.reason;
                font-size: 12px;
                wrap: word-wrap;
                color: root.removed.reason-kind == 2 ? Look.red : Look.amber;
            }
        }
    }
}

// A version's blocks, one under the other: What's new's and the game's patch notes'.
component BlockLines inherits VerticalLayout {
    in property <[ChangelogBlock]> blocks;
    spacing: 4px;
    // The point's mark is always there (empty for a paragraph): a conditional beside wrapped
    // text would lose the text's height.
    for block in root.blocks: HorizontalLayout {
        padding-left: block.kind == 3 ? 30px : block.kind == 2 ? 12px : 0px;
        padding-top: block.kind == 1 ? 6px : 0px;
        VerticalLayout {
            alignment: start;
            width: block.kind == 2 || block.kind == 3 ? 14px : 0px;
            Text {
                text: block.kind == 3 ? "–" : block.kind == 2 ? "•" : "";
                color: Look.muted;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Text {
                text: block.text;
                wrap: word-wrap;
                font-weight: block.kind == 1 ? 600 : 400;
                color: block.kind == 4 ? Look.muted : Look.text;
            }
        }
    }
}

// One version in What's new; a click opens what changed in it.
component ChangelogItem inherits Rectangle {
    in property <ChangelogEntry> entry;
    in property <bool> current;
    in property <bool> open;
    callback toggle();
    border-width: 1px;
    border-color: root.open ? Look.accent : Look.line;
    border-radius: 6px;

    TouchArea {
        clicked => { root.toggle(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: (root.open ? "▾ " : "▸ ") + root.entry.version;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.current: VerticalLayout {
                alignment: center;
                Badge {
                    text: "This version";
                    kind: 0;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.entry.date;
                font-size: 12px;
                color: Look.muted;
                vertical-alignment: center;
            }
        }
        if root.open: BlockLines {
            blocks: root.entry.blocks;
        }
    }
}

// One version of the game's patch notes, open as it is: the version and its date (when one is
// known), the newest build marked, then its paragraph and lines.
component GameNoteItem inherits Rectangle {
    in property <ChangelogEntry> entry;
    in property <bool> current;
    border-width: 1px;
    border-color: Look.line;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.entry.version;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.current: VerticalLayout {
                alignment: center;
                Badge {
                    text: "Newest build";
                    kind: 0;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.entry.date;
                font-size: 12px;
                color: Look.muted;
                vertical-alignment: center;
            }
        }
        if root.entry.blocks.length > 0: BlockLines {
            blocks: root.entry.blocks;
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 1px;
    Text {
        text: root.label;
        font-size: 11px;
        color: Look.muted;
    }
    Text {
        text: root.value;
        wrap: word-wrap;
    }
}

// The table's selected addon, beside the table: its name and badges, the tabs About and Versions,
// its button at the foot; ✕ closes it. About: its pictures row, what it does (its longer text
// behind "more"), one Safety line (SurvivorsForge's scan of the version shown, with what it found
// when asked; for an addon on our list it doesn't scan, the game's verified-addons channel), one
// Folders line, then What's new and its downloads per version.
component TablePane inherits Rectangle {
    in property <OfferRow> offer;
    in property <PanelRow> panel;
    // The app's content for this addon has come.
    in property <bool> ready;
    in-out property <int> tab;
    in property <bool> more-open;
    in property <bool> busy;
    in property <VersionsRow> versions;
    in property <bool> versions-ready;
    // The day the built-in list was last compared with the game's verified-addons channel.
    in property <string> discord-checked;
    callback close();
    callback tab-picked(int);
    callback toggle-more();
    callback show-scan();
    callback picture(int);
    // Its pictures row shows this many frames.
    callback frames(int);
    callback page();
    callback install();
    callback install-anyway();
    callback update();
    callback update-anyway();
    callback version-install(string, bool);
    callback version-back(string);
    property <int> action: root.ready ? root.panel.action : root.offer.action;
    property <string> reason: root.ready ? root.panel.reason : root.offer.reason;
    property <string> about: root.ready && root.panel.about != "" ? root.panel.about : root.offer.summary;
    function pick(tab: int) {
        root.tab = tab;
        root.tab-picked(tab);
    }
    // Opened on the tab left open before (Versions, say): what it shows is asked for.
    init => { root.tab-picked(root.tab); }
    border-width: 1px;
    border-color: Look.line;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.offer.name;
                    font-size: 15px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.offer.author + (root.ready && root.panel.verified-author ? " · verified author" : "")
                        + (root.offer.downloads != "" ? " · " + root.offer.downloads : "");
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }
            }
            VerticalLayout {
                alignment: start;
                Button {
                    text: "✕";
                    clicked => { root.close(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            for badge in root.offer.badges: VerticalLayout {
                alignment: center;
                Badge {
                    text: badge.text;
                    kind: badge.kind;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 4px;
            Chip {
                text: "About";
                active: root.tab == 0;
                clicked => { root.pick(0); }
            }
            Chip {
                text: "Versions";
                active: root.tab == 1;
                clicked => { root.pick(1); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.tab == 0: pane-scroll := ScrollView {
            vertical-stretch: 1;
            content-height: pane-list.preferred-height;
            pane-list := VerticalLayout {
                width: pane-scroll.visible-width;
                height: self.preferred-height;
                alignment: start;
                spacing: 8px;
                // Details and versions on their way.
                if !root.ready || root.panel.loading: Installing {
                    text: "Loading…";
                }
                if root.ready && root.panel.error != "": Text {
                    text: root.panel.error;
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.amber;
                }
                if root.ready && root.panel.pictures.length > 0: PicturesRow {
                    pictures: root.panel.pictures;
                    room: pane-scroll.visible-width;
                    open(i) => { root.picture(i); }
                    frames(n) => { root.frames(n); }
                }
                AboutBlock {
                    panel: root.panel;
                    ready: root.ready;
                    about: root.about;
                    more-open: root.more-open;
                    notes: false;
                    bars: false;
                    toggle-more => { root.toggle-more(); }
                }
                if root.ready && root.panel.scan != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Safety: " + root.panel.scan;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.panel.scan-more: HorizontalLayout {
                        LinkText {
                            text: "Show what it found";
                            ink: Look.blue;
                            font-size: 12px;
                            clicked => { root.show-scan(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    for finding in root.panel.findings: Text {
                        text: "• " + finding;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                if root.ready && root.panel.scan == "" && root.offer.ours: Text {
                    text: "Safety: Discord Verified · on the game's verified-addons channel"
                        + (root.discord-checked != "" ? ", checked on " + root.discord-checked : "");
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.ready: Text {
                    text: root.panel.folders != "" ? root.panel.folders : "Its folders show once it is installed.";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.offer.warning != "" && root.action < 3: Text {
                    text: "⚠ " + root.offer.warning;
                    font-size: 11px;
                    wrap: word-wrap;
                    color: Look.amber;
                }
                AboutBlock {
                    panel: root.panel;
                    ready: root.ready;
                    about-part: false;
                }
            }
        }
        if root.tab == 1: VersionsList {
            vertical-stretch: 1;
            versions: root.versions;
            ready: root.versions-ready;
            busy: root.busy;
            install(tag, anyway) => { root.version-install(tag, anyway); }
            back(backup) => { root.version-back(backup); }
        }
        // The action stays in sight at the foot, the reason above it.
        if (root.action == 1 || root.action == 5) && root.reason != "": Text {
            text: root.reason;
            font-size: 12px;
            wrap: word-wrap;
            color: Look.amber;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.offer.version + (root.offer.date != "" ? " · " + root.offer.date : "");
                font-size: 12px;
                color: Look.muted;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: "View on GitHub";
                clicked => { root.page(); }
            }
            OfferAction {
                action: root.action;
                busy: root.busy;
                install => { root.install(); }
                install-anyway => { root.install-anyway(); }
                update => { root.update(); }
                update-anyway => { root.update-anyway(); }
            }
        }
    }
}

// Previous or next (`next`) on the viewer's picture: a round button on its edge, greyed at the
// ends. Greyed, a click on it still does nothing else: it never closes the viewer.
component RoundButton inherits Rectangle {
    in property <bool> next;
    in property <bool> enabled: true;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: !root.enabled ? #00000033 : touch.has-hover ? #000000c4 : #00000094;
    accessible-role: button;
    accessible-label: root.next ? "Next picture" : "Previous picture";
    Path {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.next ? "M 7.5 4 L 13.5 10 L 7.5 16" : "M 12.5 4 L 6.5 10 L 12.5 16";
        stroke: root.enabled ? #ffffff : #ffffff59;
        stroke-width: 2.5px;
        fill: transparent;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// One of the top bar's three tabs: 14 px text, muted; the active one in the text colour with a
// 2 px accent line under it; hover brightens. Greyed and inert while the first start shows.
component TopTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 14px;
            vertical-alignment: center;
            color: !root.enabled ? Look.muted.with-alpha(0.45) : root.active || touch.has-hover ? Look.text : Look.muted;
        }
    }
    if root.active: Rectangle {
        x: 12px;
        y: parent.height - 2px;
        width: parent.width - 24px;
        height: 2px;
        background: root.enabled ? Look.accent : Look.accent.with-alpha(0.45);
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One of the rail's status lines: a mark in front (a dot coloured by the tray's state, or the
// Build line's square, filled while the newest note is unseen), then the words, elided, and an
// optional link after them ("What's new").
component RailLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> link;
    // 0 a dot, 1 the square, -1 none.
    in property <int> mark;
    in property <int> dot;
    in property <bool> filled;
    in property <bool> amber;
    in property <bool> muted;
    // The muted line without a mark (no build known yet) may take two lines.
    in property <bool> wrap;
    callback clicked();
    spacing: 7px;
    height: root.wrap ? self.preferred-height : 16px;
    VerticalLayout {
        alignment: center;
        if root.mark == 0: HorizontalLayout {
            padding-left: 2px;
            padding-right: 3px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Look.dot(root.dot);
            }
        }
        if root.mark == 1: Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 3px;
            border-width: 1.5px;
            border-color: Look.accent;
            background: root.filled ? Look.accent : transparent;
        }
    }
    Text {
        text: root.text;
        font-size: 11.5px;
        overflow: elide;
        wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
        vertical-alignment: center;
        horizontal-stretch: root.link == "" ? 1 : 0;
        color: root.amber ? Look.amber : root.muted ? Look.muted : Look.text;
    }
    if root.link != "": Text {
        text: "· ";
        font-size: 11.5px;
        vertical-alignment: center;
        color: Look.text;
    }
    if root.link != "": VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        LinkText {
            text: root.link;
            ink: Look.accent;
            font-size: 11.5px;
            clicked => { root.clicked(); }
        }
    }
}

// One filter group in the rail's Addons block: a heading row (12 px bold, the number of ticked
// boxes after it in the accent colour, ▸ at the right, ▾ when open) and its check boxes under it
// while open.
component FilterGroup inherits VerticalLayout {
    in property <string> text;
    in property <[TagRow]> boxes;
    in property <bool> open;
    in property <int> on;
    callback toggled(string);
    callback opened();
    Rectangle {
        height: 1px;
        background: Look.line;
    }
    Rectangle {
        height: 28px;
        head := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.opened(); }
        }
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 6px;
            Text {
                text: root.text;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                color: Look.text;
            }
            if root.on > 0: Text {
                text: "· " + root.on;
                font-size: 12px;
                vertical-alignment: center;
                color: Look.accent;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.open ? "▾" : "▸";
                font-size: 12px;
                vertical-alignment: center;
                color: Look.muted;
            }
        }
    }
    if root.open: VerticalLayout {
        padding-left: 4px;
        padding-bottom: 6px;
        for box in root.boxes: CheckBox {
            text: box.text;
            checked: box.on;
            toggled => { root.toggled(box.text); }
        }
    }
}

export component MainWindow inherits Window {
    // The rail and the top bar: the tray's state, the Play button, the three status lines, the
    // last line, and the update pill.
    in property <TrayState> state;
    in property <bool> busy;
    in property <bool> sync-on;
    // The game runs: Play reads "Playing…" and is greyed.
    in property <bool> playing;
    // "Build 0.141.0" with "What's new" beside it (`build-link`); without a build, the muted line.
    in property <string> build-line;
    in property <bool> build-link;
    in property <string> progress-line;
    in property <int> progress-dot;
    in property <bool> progress-amber;
    in property <string> addons-line;
    in property <int> addons-dot;
    in property <string> last-line;
    // The update pill: its words, its link's words, and what the link does (0 nothing: no pill;
    // 1 Update now; 2 see what's new).
    in property <string> pill-text;
    in property <string> pill-link;
    in property <int> pill-kind;
    callback play();
    callback sync-now();
    callback open-folder();
    callback open-game-folder();

    // Home: the game's newest note, Your PCs, Needs you, Recent activity, Playtime.
    in property <[ChangelogBlock]> news-blocks;
    in property <[PcRow]> pcs;
    in property <string> pcs-week;
    in property <[QuestionRow]> questions;
    callback question-action(int, string);
    in property <[RecentLine]> recent;
    in property <string> playtime-week;
    in property <int> playtime-week-sessions;
    in property <string> playtime-today;
    in property <string> playtime-all;
    in property <[DayBar]> playtime-days;
    in property <[PcTime]> pc-times;
    in property <[SessionRow]> sessions;
    in-out property <bool> playtime-open;
    in-out property <bool> sessions-all;

    // The Addons page: 0 Installed, 1 Browse, 2 Removed; the Add box over the table.
    in-out property <int> addons-page: 0;
    in-out property <bool> add-open;
    in property <[AddonRow]> addon-rows;
    in property <int> addons-count;
    in property <string> addons-header;
    in property <string> addons-share;
    in property <bool> can-update-all;
    in property <string> addons-footer;
    in property <string> addons-notice;
    in property <string> addons-message;
    in-out property <string> addon-open;
    callback addon-switch(string, bool);
    callback addon-update(string);
    // SurvivorsForge asks first about this update, and the player OKs it.
    callback addon-update-anyway(string);
    callback addon-back(string);
    callback addon-keep(string, bool);
    callback addon-remove(string, bool);
    callback addon-page(string);
    callback addon-folder(string);
    callback addon-local-only(string, bool);
    callback addon-settings-per-pc(string, bool);
    callback addon-settings-choice(string, bool);
    callback addons-check();
    callback addons-update-all();
    callback addons-open-folder();
    // Browse: the ones shown are filtered on the UI thread (`browse-filter`) by the rail's search
    // and filters, and sorted by `browse-sort` (0 name, 1 last updated, 2 popularity, the one it
    // starts with: the most downloads first). The Installed table takes the search and the Lists
    // and Safety filters too; Removed the search only.
    in property <[OfferRow]> offer-rows;
    in property <string> browse-note;
    in-out property <string> browse-search;
    in-out property <int> browse-sort: 2;
    // The rail's filter groups: Lists (Discord Verified, SurvivorsForge), Safety (the levels),
    // Groups (the catalog's groups); one open at a time (`filter-open`: 0 Lists, 1 Safety, 2 Groups,
    // -1 none; Safety opens by default the first time the Addons tab shows); `filters-on` counts
    // every ticked box; `browse-installed-only` is the box under the groups.
    in-out property <[TagRow]> filter-lists;
    in-out property <[TagRow]> filter-safety;
    in-out property <[TagRow]> filter-groups;
    in-out property <int> filter-open: 1;
    in property <int> filters-on;
    in-out property <bool> browse-installed-only;
    callback filter-toggled(int, string);
    callback filters-clear();
    // Every group, for the Legend: "Combat · Cursors · …".
    in property <string> browse-tag-line;
    // The grid: two columns, three from about 900 px of content.
    property <int> browse-cols: content.width >= 900px ? 3 : 2;
    property <int> browse-card-rows: floor((root.offer-rows.length + root.browse-cols - 1) / root.browse-cols);
    // The panel: the offer whose panel is open ("" none), its card (kept current by the app), and
    // what the app sends for it; it shows only while `panel.id` is the open one.
    in-out property <string> browse-panel-id;
    in-out property <OfferRow> panel-offer;
    in property <PanelRow> panel;
    property <bool> panel-ready: root.panel.id == root.browse-panel-id && root.browse-panel-id != "";
    property <bool> panel-about-open;
    // The Legend, pinned open by a click; the mouse on its link.
    in-out property <bool> legend-pinned;
    property <bool> legend-link-hover;
    // SurvivorsForge: Browse's status line ("" nothing to say), Settings' line under its switch,
    // and whether it hasn't answered for an hour (both lines amber).
    in property <string> forge-status;
    in property <string> forge-answer;
    in property <bool> forge-offline;
    // The day the built-in list was last compared with the game's verified-addons channel.
    in property <string> discord-checked;
    // SurvivorsForge's repository and website: the credit's links in About.
    in property <string> forge-repo-url;
    in property <string> forge-site-url;
    callback browse-install(string);
    callback browse-filter();
    callback browse-open(string);
    callback browse-close();
    callback browse-install-anyway(string);
    callback forge-show-scan(string);
    // Browse's three views, one shown at a time (`browse-view`: list, cards, table, the default),
    // as kept in settings.toml; the switch tells the app.
    in-out property <string> browse-view: "table";
    callback browse-view-changed(string);
    function pick-view(view: string) {
        root.browse-view = view;
        root.browse-view-changed(view);
        // The table picked: its top row opens when nothing is.
        root.table-fresh = view == "table";
        root.browse-filter();
    }
    // An addon opened in Browse, as a click on it opens it: its panel, row or pane, and the app
    // asked for what it shows. The app opens the table's top row with it too.
    public function open-offer(offer: OfferRow) {
        root.panel-about-open = false;
        root.panel-offer = offer;
        root.browse-panel-id = offer.id;
        root.browse-open(offer.id);
        if (root.browse-view == "table" && root.table-tab == 1) {
            root.versions-id = offer.id;
            root.versions-open(offer.id);
        }
    }
    // Home's "Show what it found" for an addon on offer: Browse with its pane, and the findings
    // asked for; for one not on offer, Installed with its row opened.
    public function show-scan(id: string, offered: bool) {
        root.tab = 1;
        if (offered) {
            root.addons-page = 1;
            root.browse-view = "table";
        } else {
            root.addons-page = 0;
            root.addon-open = id;
        }
    }
    // Browse entered, or the table picked, since the last filter: the app opens the table's top
    // row when no addon is open (`browse-filter`).
    in-out property <bool> table-fresh;
    // The open addon's pictures row shows this many frames: the app asks for their thumbnails.
    callback thumbs-shown(string, int);
    // A table column's heading clicked: sorted by it, or the other way round when it already is.
    function sort-table(column: int) {
        if (root.browse-sort == column) {
            root.browse-sort-reverse = !root.browse-sort-reverse;
        } else {
            root.browse-sort = column;
            root.browse-sort-reverse = false;
        }
        root.browse-filter();
    }
    // The table's column's direction (the other way round from each sort's own when set).
    in-out property <bool> browse-sort-reverse;
    // The selected addon's tab: 0 About, 1 Versions.
    in-out property <int> table-tab: 0;
    // The Addons tab, or its Installed or Browse page, came into view (-1: left): their icons.
    // Browse entered: the table's top row opens when no addon is open.
    callback addons-shown(int);
    function addons-view-changed() {
        root.addons-shown(root.tab == 1 ? root.addons-page : -1);
        if (root.tab == 1 && root.addons-page == 1) {
            root.table-fresh = true;
            root.browse-filter();
        }
    }
    changed tab => { root.addons-view-changed(); }
    changed addons-page => { root.addons-view-changed(); }
    // The picture viewer, over the window: the open addon's screenshot `viewer-index`, its pixels
    // from the app (`viewer-state` 0 loading, 1 shown, 2 not available). Only the one shown is held.
    in-out property <bool> viewer-open;
    in-out property <int> viewer-index;
    in-out property <image> viewer-image;
    in-out property <int> viewer-state;
    callback picture-show(string, int);
    callback picture-close();
    // Versions…: the addon it is asked for (`versions-id`), and what the app sends for it; over the
    // window when `versions-overlay`, else in the table's Versions tab.
    in property <VersionsRow> versions;
    in-out property <string> versions-id;
    in-out property <bool> versions-overlay;
    callback versions-open(string);
    callback versions-close();
    callback version-install(string, string, bool);
    callback version-back(string, string);
    function open-versions(id: string) {
        root.versions-id = id;
        root.versions-overlay = true;
        root.versions-open(id);
    }
    function close-versions() {
        root.versions-overlay = false;
        root.versions-id = "";
        root.versions-close();
    }
    // An incoming addon's, and a removed one's, Install anyway: the player's OK.
    callback incoming-install-anyway(string);
    callback install-again-anyway(string);
    // A SurvivorsForge link; the app opens only its repository and website, and GitHub
    // repositories.
    callback open-link(string);
    // Add: 0 nothing yet, 1 looking, 2 found, 3 failed.
    in-out property <string> link-text;
    in property <int> link-state;
    in property <string> link-message;
    in property <string> link-owner;
    in property <string> link-release;
    in property <string> link-goes;
    in property <string> link-note;
    in property <bool> link-warn;
    in property <bool> link-installing;
    callback link-lookup(string);
    callback link-install();
    callback link-clear();
    callback import-zip();
    // "Remove…" asks first.
    in-out property <string> remove-id;
    in-out property <string> remove-name;
    in-out property <bool> remove-settings;
    // The Removed table: the row clicked shows its whole note.
    in property <[RemovedRow]> removed-rows;
    in-out property <string> removed-open;
    callback install-again(string);

    // Settings. Every setting applies the moment it changes: a switch or a segmented choice on
    // click (`setting-bool`, `setting-theme`), a text field when it loses focus or Enter is pressed
    // (`setting-text`: "folder", "pc-name", "game-dir"). The app answers with the form as saved, and
    // names the row that applied (`saved-key`): its "✓ Saved" shows for a second.
    in-out property <string> game-dir;
    in property <string> game-status;
    in property <bool> game-ok;
    in-out property <bool> sync-switch;
    in-out property <string> sync-folder;
    in property <string> folder-status;
    // 0 muted, 1 green (it answers), 2 red (refused).
    in property <int> folder-status-kind;
    in-out property <string> pc-name;
    // Why the name typed wasn't saved (another PC syncing there has it); empty otherwise.
    in-out property <string> name-status;
    in-out property <bool> start-with-windows;
    in-out property <bool> desktop-shortcut;
    in-out property <bool> notifications;
    in-out property <bool> addons-auto;
    in-out property <bool> addons-shared;
    in-out property <bool> addons-forge;
    in-out property <bool> pause-when-away;
    in property <string> settings-path;
    // 0 System, 1 Light, 2 Dark.
    in-out property <int> theme;
    in-out property <bool> game-shared;
    callback setting-bool(string, bool);
    callback setting-theme(int);
    callback setting-text(string, string);
    callback restore-defaults();
    callback detect-game();
    in-out property <string> saved-key;
    // "✓ Saved" fades out after a second.
    saved-timer := Timer {
        interval: 1s;
        running: root.saved-key != "";
        triggered => { root.saved-key = ""; }
    }
    // The game's own settings on every PC: where they stand with the other PCs (`game-line-kind`
    // 0 plain, 1 news, 2 needs a look); the choice itself is on Home's Needs-you card.
    in property <string> game-line;
    in property <int> game-line-kind;
    in property <string> game-ask-pc;
    callback game-settings-choice(bool);
    in property <string> game-own;
    in property <string> game-note;
    callback game-settings-own();
    // A newer Satchel: the version Update now puts in place (empty: none downloaded yet).
    in property <string> update-text;
    in property <string> update-version;
    in property <bool> update-gated;
    callback update-now();
    // About's Check for updates, and what it found (empty before a check). `checking`: from the
    // click until the answer, "Checking…" stands where the button was.
    callback check-updates();
    in-out property <string> check-result;
    in property <bool> checking;
    in property <SettingsForm> saved-form;
    // Progress versions: the rows, newest first, the summary line, and whether the table is open.
    in property <[SaveRow]> save-rows;
    in property <string> saves-summary;
    in property <string> saves-note;
    in-out property <bool> saves-open;
    callback bring-back(int);
    callback open-saves-folder();

    // About the Satchel itself, and What's new (every version's changes).
    in property <string> app-version;
    in property <string> app-released;
    in property <string> app-build;
    in property <string> repo-url;
    // Report a problem: the repository's bug report form with this version filled in (there
    // whenever `repo-url` is).
    in property <string> issue-url;
    in property <[ChangelogEntry]> changelog;
    in-out property <bool> whats-new-open;
    in-out property <string> changelog-open;
    callback whats-new-seen();
    callback open-url(string);
    function open-whats-new() {
        root.changelog-open = root.app-version;
        root.whats-new-open = true;
        root.whats-new-seen();
    }
    // Where addons come from, and where the game's notes come from: About's two overlays.
    in-out property <bool> sources-open;
    in-out property <bool> news-sources-open;
    // The game's patch notes: the newest build (`game-news-version`, empty when none is known
    // here; `game-news-new`: not opened for that build yet), the panel's versions, newest first,
    // its last line when older ones are left out, what it says with nothing cached, and About's
    // two answer times.
    in property <bool> game-news-new;
    in property <string> game-news-version;
    in property <[ChangelogEntry]> game-notes;
    in property <string> game-notes-footer;
    in property <string> game-notes-empty;
    in property <string> game-news-latest-answer;
    in property <string> game-news-notes-answer;
    in-out property <bool> game-news-open;
    callback game-news-seen();
    function open-game-news() {
        root.game-news-open = true;
        root.game-news-seen();
    }

    // The game isn't in its folder: Home and Addons say so; Settings stays reachable.
    in property <bool> game-found: true;
    callback find-game();
    callback open-game-site();
    callback pick-game-folder();

    // Dark or light, as Settings' theme says.
    in property <bool> dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }

    // Home, Addons, Settings.
    in-out property <int> tab: 0;

    // "Needs you": two PCs moved on separately (the blocking question at Play; Home's card lists it
    // too).
    in property <bool> needs-you;
    in property <string> needs-here;
    in property <string> needs-other;
    in property <string> needs-other-pc;
    callback keep-here();
    callback use-other();
    callback decide-later();

    // First start: one screen over the content; the tabs and Play greyed.
    in property <bool> setup;
    // "Sync is on · <folder>" when the defaults file beside the exe turned sync on; empty otherwise.
    in property <string> setup-sync-line;
    callback finish-setup();

    title: "Survivor's Satchel";
    icon: @image-url("icons/satchel.svg");
    default-font-size: 13px;
    background: Look.bg;
    // 16:9: 1,280 × 720, and never smaller than 1,120 × 630, so the rail, the table and the pane fit.
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 1120px;
    min-height: 630px;
    // The minimum window: the table's columns narrow and its headings take two lines.
    property <bool> small: root.width < 1200px;

    // The shell: the top bar over everything, then the rail and the content beside it.
    VerticalLayout {
        top-bar := Rectangle {
            height: 44px;
            background: Look.bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                TopTab {
                    text: "Home";
                    active: root.tab == 0;
                    enabled: !root.setup;
                    clicked => { root.tab = 0; }
                }
                TopTab {
                    text: "Addons";
                    active: root.tab == 1;
                    enabled: !root.setup;
                    clicked => { root.tab = 1; }
                }
                TopTab {
                    text: "Settings";
                    active: root.tab == 2;
                    enabled: !root.setup;
                    clicked => { root.tab = 2; }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.pill-kind != 0: VerticalLayout {
                    alignment: center;
                    padding-right: 8px;
                    Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Look.line;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 4px;
                            Text {
                                text: root.pill-text + (root.pill-link != "" ? " ·" : "");
                                font-size: 12px;
                                vertical-alignment: center;
                                color: Look.muted;
                            }
                            if root.pill-link != "": VerticalLayout {
                                alignment: center;
                                LinkText {
                                    text: root.pill-link;
                                    ink: Look.accent;
                                    font-size: 12px;
                                    clicked => {
                                        if (root.pill-kind == 1) {
                                            root.update-now();
                                        } else {
                                            root.open-whats-new();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Look.line;
            }
        }
        HorizontalLayout {
            // The rail: the art, the three status lines, the Addons block, Play, the last line.
            rail := Rectangle {
                width: 232px;
                background: Look.panel;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Look.line;
                }
                VerticalLayout {
                    padding-right: 1px;
                    art := Rectangle {
                        height: 120px;
                        clip: true;
                        background: @linear-gradient(160deg, #4a2414 0%, #221632 55%, #0c1726 100%);
                        // A soft highlight, up and to the left.
                        Rectangle {
                            x: -70px;
                            y: -90px;
                            width: 280px;
                            height: 240px;
                            background: @radial-gradient(circle, #e8aa5059 0%, #e8aa5000 60%);
                        }
                        VerticalLayout {
                            padding-left: 18px;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "AZEROTH";
                                font-size: 25px;
                                font-weight: 800;
                                letter-spacing: 3px;
                                color: #f0cf8a;
                            }
                            Text {
                                text: "SURVIVORS";
                                font-size: 15px;
                                font-weight: 700;
                                letter-spacing: 5.4px;
                                color: #f0cf8a;
                            }
                        }
                    }
                    VerticalLayout {
                        padding: 10px;
                        padding-top: 12px;
                        padding-bottom: 0;
                        spacing: 7px;
                        RailLine {
                            text: root.build-line;
                            link: root.build-link ? "What's new" : "";
                            mark: root.build-link ? 1 : -1;
                            wrap: !root.build-link;
                            filled: root.build-link && root.game-news-new;
                            muted: !root.build-link;
                            clicked => { root.open-game-news(); }
                        }
                        if !root.setup: RailLine {
                            text: root.progress-line;
                            dot: root.progress-dot;
                            amber: root.progress-amber;
                        }
                        if !root.setup: RailLine {
                            text: root.addons-line;
                            dot: root.addons-dot;
                            muted: root.addons-dot == 4;
                        }
                    }
                    // The Addons block, while the Addons tab shows: the search and the filters. It
                    // scrolls on its own when the Groups list is long; the Play row stays pinned.
                    if root.tab == 1 && !root.setup: VerticalLayout {
                        vertical-stretch: 1;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 12px;
                        VerticalLayout {
                            vertical-stretch: 0;
                            Rectangle {
                                height: 1px;
                                background: Look.line;
                            }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    placeholder-text: "Search addons";
                                    text <=> root.browse-search;
                                    font-size: 12.5px;
                                    horizontal-stretch: 1;
                                    min-width: 80px;
                                    edited => { root.browse-filter(); }
                                }
                                if root.filters-on > 0: VerticalLayout {
                                    alignment: center;
                                    LinkText {
                                        text: "Clear";
                                        ink: Look.accent;
                                        font-size: 12px;
                                        clicked => { root.filters-clear(); }
                                    }
                                }
                            }
                            Rectangle { height: 6px; }
                        }
                        filters-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-height: filters-list.preferred-height;
                            filters-list := VerticalLayout {
                                width: filters-scroll.visible-width;
                                height: self.preferred-height;
                                alignment: start;
                                FilterGroup {
                                    text: "Lists";
                                    boxes: root.filter-lists;
                                    open: root.filter-open == 0;
                                    on: root.filter-lists.length > 0 ? (root.filter-lists[0].on ? 1 : 0) + (root.filter-lists.length > 1 && root.filter-lists[1].on ? 1 : 0) : 0;
                                    toggled(name) => { root.filter-toggled(0, name); }
                                    opened => { root.filter-open = root.filter-open == 0 ? -1 : 0; }
                                }
                                FilterGroup {
                                    text: "Safety";
                                    boxes: root.filter-safety;
                                    open: root.filter-open == 1;
                                    on: root.filters-on - root.lists-on - root.groups-on;
                                    toggled(name) => { root.filter-toggled(1, name); }
                                    opened => { root.filter-open = root.filter-open == 1 ? -1 : 1; }
                                }
                                FilterGroup {
                                    text: "Groups";
                                    boxes: root.filter-groups;
                                    open: root.filter-open == 2;
                                    on: root.groups-on;
                                    toggled(name) => { root.filter-toggled(2, name); }
                                    opened => { root.filter-open = root.filter-open == 2 ? -1 : 2; }
                                }
                                if root.addons-page != 0: VerticalLayout {
                                    padding-top: 4px;
                                    Rectangle {
                                        height: 1px;
                                        background: Look.line;
                                    }
                                    CheckBox {
                                        text: "Installed only";
                                        checked <=> root.browse-installed-only;
                                        toggled => { root.browse-filter(); }
                                    }
                                }
                            }
                        }
                    }
                    if root.tab != 1 || root.setup: Rectangle { vertical-stretch: 1; }
                    // Play and the gear, pinned to the bottom.
                    HorizontalLayout {
                        padding: 12px;
                        padding-bottom: 4px;
                        spacing: 2px;
                        play-button := Rectangle {
                            horizontal-stretch: 1;
                            height: 48px;
                            border-top-left-radius: 6px;
                            border-bottom-left-radius: 6px;
                            property <bool> inert: root.playing || root.setup || root.busy;
                            background: self.inert ? Look.hover : play-touch.has-hover ? Look.accent2 : Look.accent;
                            accessible-role: button;
                            accessible-label: root.playing ? "Playing" : "Play";
                            accessible-enabled: !self.inert;
                            Text {
                                text: root.playing ? "Playing…" : "Play";
                                font-size: root.playing ? 16px : 18px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: play-button.inert ? Look.muted : #ffffff;
                            }
                            play-touch := TouchArea {
                                enabled: !play-button.inert;
                                mouse-cursor: pointer;
                                clicked => { root.play(); }
                            }
                        }
                        gear-button := Rectangle {
                            width: 48px;
                            height: 48px;
                            border-top-right-radius: 6px;
                            border-bottom-right-radius: 6px;
                            background: root.setup ? Look.hover : gear-touch.has-hover ? Look.accent : Look.accent2;
                            accessible-role: button;
                            accessible-label: "Game options";
                            accessible-enabled: !root.setup;
                            Path {
                                width: 20px;
                                height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 20;
                                viewbox-height: 20;
                                commands: "M 16.91 8.90 L 19.14 8.92 L 19.14 11.08 L 16.91 11.10 L 15.66 14.11 L 17.22 15.70 L 15.70 17.22 L 14.11 15.66 L 11.10 16.91 L 11.08 19.14 L 8.92 19.14 L 8.90 16.91 L 5.89 15.66 L 4.30 17.22 L 2.78 15.70 L 4.34 14.11 L 3.09 11.10 L 0.86 11.08 L 0.86 8.92 L 3.09 8.90 L 4.34 5.89 L 2.78 4.30 L 4.30 2.78 L 5.89 4.34 L 8.90 3.09 L 8.92 0.86 L 11.08 0.86 L 11.10 3.09 L 14.11 4.34 L 15.70 2.78 L 17.22 4.30 L 15.66 5.89 Z M 13.0 10 A 3.0 3.0 0 1 0 7.0 10 A 3.0 3.0 0 1 0 13.0 10 Z";
                                fill: root.setup ? Look.muted : #ffffff;
                                fill-rule: evenodd;
                            }
                            gear-touch := TouchArea {
                                enabled: !root.setup;
                                mouse-cursor: pointer;
                                clicked => { gear-menu.show(); }
                            }
                            // Game options: Sync now and the network folder (sync on), the game's
                            // folder, Game settings…
                            gear-menu := PopupWindow {
                                x: -140px;
                                y: -(root.sync-on ? 4 : 2) * 32px - 20px;
                                width: 188px;
                                Rectangle {
                                    background: Look.panel;
                                    border-width: 1px;
                                    border-color: Look.line;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 6px;
                                        Text {
                                            text: "Game options";
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: Look.muted;
                                            height: 20px;
                                            vertical-alignment: center;
                                        }
                                        if root.sync-on: MenuRow {
                                            text: "Sync now";
                                            enabled: !root.busy;
                                            clicked => { root.sync-now(); }
                                        }
                                        if root.sync-on: MenuRow {
                                            text: "Open the network folder";
                                            clicked => { root.open-folder(); }
                                        }
                                        MenuRow {
                                            text: "Open the game's folder";
                                            clicked => { root.open-game-folder(); }
                                        }
                                        MenuRow {
                                            text: "Game settings…";
                                            clicked => { root.tab = 2; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 12px;
                        Text {
                            text: root.setup ? "Not played from the Satchel yet" : root.last-line;
                            font-size: 11.5px;
                            wrap: word-wrap;
                            color: Look.muted;
                        }
                    }
                }
            }

            // The content area: the page, 16 px padding, scrolling when a page is taller than it.
            content := Rectangle {
                horizontal-stretch: 1;
                clip: true;

                // Home: two columns, 1.25 : 1, the pair capped at 1,100 px and centred; the cards grow
                // with their content; the page is top-aligned.
                if root.tab == 0: home-scroll := ScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-height: pair.height + 32px;
                    pair := Rectangle {
                        property <length> room: min(1100px, home-scroll.visible-width - 32px);
                        x: (home-scroll.visible-width - self.width) / 2;
                        y: 16px;
                        width: self.room;
                        height: max(left-column.preferred-height, right-column.preferred-height);
                        // The left column, 1.25 to the right one's 1.
                        left-column := VerticalLayout {
                                    x: 0;
                                    y: 0;
                                    width: (pair.room - 12px) * 1.25 / 2.25;
                                    height: self.preferred-height;
                                    alignment: start;
                                    spacing: 12px;
                                    HomeCard {
                                        heading: "What's new in the game" + (root.game-news-version != "" ? " · " + root.game-news-version : "");
                                        if root.news-blocks.length == 0: Text {
                                            text: "The game's notes show here once the Satchel has read them.";
                                            font-size: 13px;
                                            wrap: word-wrap;
                                            color: Look.muted;
                                        }
                                        // Each line at the width it has: the card's width less its
                                        // padding and the point's indent, so its wrapped height counts
                                        // in the card's.
                                        for block in root.news-blocks: HorizontalLayout {
                                            padding-left: block.kind == 3 ? 28px : block.kind == 2 ? 10px : 0px;
                                            Text {
                                                width: left-column.width - 30px - (block.kind == 3 ? 28px : block.kind == 2 ? 10px : 0px);
                                                text: (block.kind == 2 ? "•  " : block.kind == 3 ? "–  " : "") + block.text;
                                                font-size: block.kind == 0 ? 13px : 12.5px;
                                                font-weight: block.kind == 1 ? 600 : 400;
                                                wrap: word-wrap;
                                                color: block.kind == 0 || block.kind == 1 ? Look.text : Look.muted;
                                            }
                                        }
                                        if root.news-blocks.length > 0: HorizontalLayout {
                                            LinkText {
                                                text: "Older notes ▾";
                                                ink: Look.muted;
                                                font-size: 13px;
                                                clicked => { root.open-game-news(); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    if root.sync-on: HomeCard {
                                        heading: "Your PCs";
                                        VerticalLayout {
                                            for pc in root.pcs: VerticalLayout {
                                                HorizontalLayout {
                                                    padding-top: 4px;
                                                    padding-bottom: 4px;
                                                    spacing: 8px;
                                                    HorizontalLayout {
                                                        spacing: 4px;
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: pc.name;
                                                            font-size: 12.5px;
                                                            font-weight: pc.this-pc ? 600 : 400;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                            color: Look.text;
                                                        }
                                                        if pc.this-pc: Text {
                                                            text: "(this PC)";
                                                            font-size: 12.5px;
                                                            vertical-alignment: center;
                                                            color: Look.muted;
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                    Text {
                                                        text: pc.line;
                                                        font-size: 11.5px;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                        color: Look.muted;
                                                    }
                                                }
                                                Rectangle {
                                                    height: 1px;
                                                    background: Look.line;
                                                }
                                            }
                                        }
                                        if root.pcs-week != "": Text {
                                            text: root.pcs-week;
                                            font-size: 12px;
                                            color: Look.muted;
                                        }
                                    }
                                }
                                // The right column.
                                right-column := VerticalLayout {
                                    x: left-column.width + 12px;
                                    y: 0;
                                    width: (pair.room - 12px) / 2.25;
                                    height: self.preferred-height;
                                    alignment: start;
                                    spacing: 12px;
                                    if root.questions.length > 0: HomeCard {
                                        heading: "Needs you · " + root.questions.length;
                                        for question in root.questions: HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 3px;
                                                background: Look.amber;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 8px;
                                                Text {
                                                    text: question.text;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    color: Look.text;
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    for button in question.buttons: PlainButton {
                                                        text: button.text;
                                                        enabled: !root.busy;
                                                        clicked => { root.question-action(button.action, button.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    HomeCard {
                                        heading: "Recent activity";
                                        if root.recent.length == 0: Text {
                                            text: "Nothing yet. What the Satchel does on this PC shows here.";
                                            font-size: 12.5px;
                                            wrap: word-wrap;
                                            color: Look.muted;
                                        }
                                        for line in root.recent: HorizontalLayout {
                                            spacing: 6px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            VerticalLayout {
                                                width: 18px;
                                                alignment: center;
                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: line.kind == 1 ? @image-url("icons/kind-addon.svg")
                                                        : line.kind == 2 ? @image-url("icons/kind-game.svg")
                                                        : line.kind == 3 ? @image-url("icons/kind-playtime.svg")
                                                        : line.kind == 4 ? @image-url("icons/kind-warning.svg")
                                                        : line.kind == 5 ? @image-url("icons/kind-satchel.svg")
                                                        : @image-url("icons/kind-sync.svg");
                                                    colorize: line.kind == 4 ? Look.amber : line.kind == 1 ? Look.accent : line.kind == 2 ? Look.gold : line.kind == 0 ? Look.green : Look.muted;
                                                }
                                            }
                                            Text {
                                                text: line.text;
                                                font-size: 12.5px;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                                color: Look.text;
                                            }
                                            Text {
                                                text: line.when;
                                                font-size: 11.5px;
                                                vertical-alignment: center;
                                                color: Look.muted;
                                            }
                                        }
                                    }
                                    // Playtime: a card that opens on click.
                                    Rectangle {
                                        playtime-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.playtime-open = !root.playtime-open; }
                                        }
                                        HomeCard {
                                            heading: "Playtime · this week " + root.playtime-week + " · " + root.playtime-week-sessions + (root.playtime-week-sessions == 1 ? " session" : " sessions");
                                            heading-right: root.playtime-open ? "▴" : "▾";
                                            border-color: playtime-touch.has-hover ? Look.muted : Look.line;
                                            // The last seven days as bars, 28 px tall, the weekday under each.
                                            VerticalLayout {
                                                spacing: 3px;
                                                HorizontalLayout {
                                                    height: 28px;
                                                    spacing: 2px;
                                                    for day in root.playtime-days: Rectangle {
                                                        horizontal-stretch: 1;
                                                        if day.minutes > 0: Rectangle {
                                                            width: min(28px, parent.width * 0.6);
                                                            height: max(2px, parent.height * day.share);
                                                            x: (parent.width - self.width) / 2;
                                                            y: parent.height - self.height;
                                                            border-top-left-radius: 3px;
                                                            border-top-right-radius: 3px;
                                                            background: Look.accent;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    height: 1px;
                                                    background: Look.line;
                                                }
                                                HorizontalLayout {
                                                    spacing: 2px;
                                                    for day in root.playtime-days: Text {
                                                        horizontal-stretch: 1;
                                                        text: day.label;
                                                        font-size: 10.5px;
                                                        horizontal-alignment: center;
                                                        color: Look.muted;
                                                    }
                                                }
                                            }
                                            if root.playtime-open: VerticalLayout {
                                                spacing: 6px;
                                                padding-top: 4px;
                                                Text {
                                                    text: "Today " + root.playtime-today + " · In all " + root.playtime-all;
                                                    font-size: 12.5px;
                                                    color: Look.text;
                                                }
                                                if root.sync-on && root.pc-times.length > 0: Text {
                                                    text: "This week, per PC";
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    color: Look.text;
                                                }
                                                if root.sync-on: VerticalLayout {
                                                    spacing: 4px;
                                                    for row in root.pc-times: HorizontalLayout {
                                                        spacing: 8px;
                                                        Text {
                                                            text: row.name;
                                                            width: 90px;
                                                            font-size: 12px;
                                                            overflow: elide;
                                                            color: Look.text;
                                                        }
                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            alignment: center;
                                                            Rectangle {
                                                                height: 8px;
                                                                border-radius: 3px;
                                                                background: Look.hover;
                                                                Rectangle {
                                                                    x: 0;
                                                                    width: parent.width * row.share;
                                                                    height: parent.height;
                                                                    border-radius: 3px;
                                                                    background: Look.accent;
                                                                }
                                                            }
                                                        }
                                                        Text {
                                                            text: row.time;
                                                            width: 70px;
                                                            font-size: 12px;
                                                            horizontal-alignment: right;
                                                            color: Look.text;
                                                        }
                                                    }
                                                }
                                                // The last sessions: day · PC · minutes, newest first.
                                                VerticalLayout {
                                                    for session[i] in root.sessions: VerticalLayout {
                                                        if root.sessions-all || i < 8: HorizontalLayout {
                                                            padding-top: 5px;
                                                            padding-bottom: 5px;
                                                            spacing: 8px;
                                                            Text {
                                                                text: session.day;
                                                                width: 100px;
                                                                font-size: 12.5px;
                                                                overflow: elide;
                                                                color: Look.text;
                                                            }
                                                            Text {
                                                                text: session.pc;
                                                                font-size: 12.5px;
                                                                overflow: elide;
                                                                horizontal-stretch: 1;
                                                                color: Look.text;
                                                            }
                                                            Text {
                                                                text: session.minutes;
                                                                font-size: 12.5px;
                                                                horizontal-alignment: right;
                                                                color: Look.text;
                                                            }
                                                        }
                                                        if root.sessions-all || i < 8: Rectangle {
                                                            height: 1px;
                                                            background: Look.line;
                                                        }
                                                    }
                                                }
                                                if root.sessions.length > 8: HorizontalLayout {
                                                    LinkText {
                                                        text: root.sessions-all ? "Fewer sessions ▴" : "All sessions ▾";
                                                        ink: Look.muted;
                                                        font-size: 12.5px;
                                                        clicked => { root.sessions-all = !root.sessions-all; }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                            }
                                        }
                                    }
                                }
                    }
                }

                // Addons: the row above the table, then the view and the pane.
                if root.tab == 1: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    // Esc closes the Add box or the addon opened (the panel, the row, the table's
                    // pane), else unpins the Legend; a key a field doesn't take comes up to here.
                    browse-keys := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Escape && root.add-open) {
                                root.add-open = false;
                                return accept;
                            }
                            if (event.text == Key.Escape && root.browse-panel-id != "") {
                                root.browse-panel-id = "";
                                root.browse-close();
                                return accept;
                            }
                            if (event.text == Key.Escape && root.legend-pinned) {
                                root.legend-pinned = false;
                                return accept;
                            }
                            return reject;
                        }
                        VerticalLayout {
                            padding: root.small ? 12px : 16px;
                            spacing: root.small ? 8px : 10px;
                            // The sub-pages as a segmented control; + Add; on Browse the sort, the
                            // view icons and Legend.
                            top-row := HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    border-width: 1px;
                                    border-color: Look.line;
                                    border-radius: 6px;
                                    clip: true;
                                    HorizontalLayout {
                                        Segment {
                                            text: "Installed" + (root.addons-count > 0 ? " · " + root.addons-count : "");
                                            active: root.addons-page == 0;
                                            first: true;
                                            clicked => { root.addons-page = 0; }
                                        }
                                        Segment {
                                            text: "Browse";
                                            active: root.addons-page == 1;
                                            clicked => { root.addons-page = 1; }
                                        }
                                        Segment {
                                            text: root.removed-rows.length > 0 ? "Removed · " + root.removed-rows.length : "Removed";
                                            active: root.addons-page == 2;
                                            clicked => { root.addons-page = 2; }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                PlainButton {
                                    text: "+ Add";
                                    clicked => { root.add-open = true; }
                                }
                                if root.addons-page == 1: ComboBox {
                                    width: 150px;
                                    model: ["Sort: Name", "Sort: Last updated", "Sort: Popularity"];
                                    current-index <=> root.browse-sort;
                                    selected => {
                                        root.browse-sort-reverse = false;
                                        root.browse-filter();
                                    }
                                }
                                // The switch: cards, list, table.
                                if root.addons-page == 1: Rectangle {
                                    border-width: 1px;
                                    border-color: Look.line;
                                    border-radius: 6px;
                                    clip: true;
                                    HorizontalLayout {
                                        ViewButton {
                                            glyph: 1;
                                            label: "Cards";
                                            active: root.browse-view != "list" && root.browse-view != "table";
                                            clicked => { root.pick-view("cards"); }
                                        }
                                        ViewButton {
                                            glyph: 0;
                                            label: "List";
                                            active: root.browse-view == "list";
                                            clicked => { root.pick-view("list"); }
                                        }
                                        ViewButton {
                                            glyph: 2;
                                            label: "Table";
                                            active: root.browse-view == "table";
                                            clicked => { root.pick-view("table"); }
                                        }
                                    }
                                }
                                // The row's whole height answers the mouse, so it can go down onto
                                // the Legend without the Legend closing.
                                if root.addons-page == 1: Rectangle {
                                    legend-hover := TouchArea {
                                        mouse-cursor: pointer;
                                        changed has-hover => { root.legend-link-hover = self.has-hover; }
                                        clicked => { root.legend-pinned = !root.legend-pinned; }
                                    }
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: "Legend";
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: legend-hover.has-hover || root.legend-pinned ? Look.text : Look.accent;
                                        }
                                    }
                                }
                            }
                            if root.addons-message != "": Rectangle {
                                border-radius: 6px;
                                background: Look.note-paper;
                                HorizontalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.addons-message;
                                        wrap: word-wrap;
                                        color: Look.ink;
                                    }
                                }
                            }
                            if root.addons-notice != "": Text {
                                text: root.addons-notice;
                                font-size: 12px;
                                wrap: word-wrap;
                                color: Look.muted;
                            }

                            // Installed: its header line, the table, its sharing line and its footer.
                            if root.addons-page == 0: VerticalLayout {
                                spacing: 8px;
                                vertical-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.addons-header;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        color: root.can-update-all ? Look.green : Look.text;
                                    }
                                    if root.can-update-all: PlainButton {
                                        text: "Update all";
                                        primary: true;
                                        enabled: !root.busy;
                                        clicked => { root.addons-update-all(); }
                                    }
                                }
                                // The columns, in the table's style: the name takes what the others
                                // leave, and the status line a share of it.
                                installed-box := Rectangle {
                                    vertical-stretch: 1;
                                    background: Look.panel;
                                    border-width: 1px;
                                    border-color: Look.line;
                                    border-radius: 6px;
                                    clip: true;
                                    property <length> fixed: InstalledColumns.safety + InstalledColumns.version + InstalledColumns.released + InstalledColumns.on
                                        + 5 * InstalledColumns.spacing + 26px;
                                    property <length> status-width: clamp((self.width - self.fixed) * 0.55, 150px, 460px);
                                    VerticalLayout {
                                        padding: 1px;
                                        // The headings over their columns, both clear of the scroll bar,
                                        // which is drawn over the rows' right edge.
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 14px;
                                            spacing: InstalledColumns.spacing;
                                            TableHead {
                                                horizontal-stretch: 1;
                                                min-width: 140px;
                                                text: "Name";
                                            }
                                            TableHead {
                                                width: InstalledColumns.safety;
                                                text: "Safety";
                                            }
                                            TableHead {
                                                width: InstalledColumns.version;
                                                text: "Version";
                                            }
                                            TableHead {
                                                width: InstalledColumns.released;
                                                text: "Released";
                                            }
                                            TableHead {
                                                width: installed-box.status-width;
                                                text: "Status";
                                            }
                                            TableHead {
                                                width: InstalledColumns.on;
                                                text: "On";
                                                align: TextHorizontalAlignment.right;
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Look.line;
                                        }
                                        // The viewport is as tall as the whole list, so the rows keep their height and scroll.
                                        installed-scroll := ScrollView {
                                            vertical-stretch: 1;
                                            content-height: installed-list.preferred-height;
                                            installed-list := VerticalLayout {
                                                width: installed-scroll.visible-width;
                                                height: self.preferred-height;
                                                alignment: start;
                                                for row in root.addon-rows: AddonTableRow {
                                                    addon: row;
                                                    open: root.addon-open == row.id;
                                                    busy: root.busy;
                                                    status-width: installed-box.status-width;
                                                    toggle => { root.addon-open = root.addon-open == row.id ? "" : row.id; }
                                                    switched(on) => { root.addon-switch(row.id, on); }
                                                    update => { root.addon-update(row.id); }
                                                    update-anyway => { root.addon-update-anyway(row.id); }
                                                    replace => { root.browse-install(row.id); }
                                                    back => { root.addon-back(row.id); }
                                                    keep(on) => { root.addon-keep(row.id, on); }
                                                    page => { root.addon-page(row.id); }
                                                    folder => { root.addon-folder(row.id); }
                                                    local-only(on) => { root.addon-local-only(row.id, on); }
                                                    settings-per-pc(on) => { root.addon-settings-per-pc(row.id, on); }
                                                    settings-choice(keep) => { root.addon-settings-choice(row.id, keep); }
                                                    versions => { root.open-versions(row.id); }
                                                    install-anyway => { root.incoming-install-anyway(row.id); }
                                                    remove => {
                                                        root.remove-settings = false;
                                                        root.remove-name = row.name;
                                                        root.remove-id = row.id;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.addons-share != "": Text {
                                    text: root.addons-share;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    color: Look.muted;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.addons-footer;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        color: Look.muted;
                                    }
                                    PlainButton {
                                        text: "Check now";
                                        clicked => { root.addons-check(); }
                                    }
                                    PlainButton {
                                        text: "Open AddOns folder";
                                        clicked => { root.addons-open-folder(); }
                                    }
                                }
                            }

                            // Browse in one of three views, each a subtree of its own bound to
                            // `browse-view`: cards, a panel sliding in over them from the right; the
                            // list, its rows opening in place; the table, the selected addon beside it.
                            if root.addons-page == 1: Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                VerticalLayout {
                                    spacing: 8px;
                                    if root.forge-status != "": Text {
                                        text: root.forge-status;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        color: root.forge-offline ? Look.amber : Look.muted;
                                    }
                                    // Cards: two columns, three from about 900 px; each row as tall as its
                                    // tallest card.
                                    if root.browse-view != "list" && root.browse-view != "table": offer-scroll := ScrollView {
                                        vertical-stretch: 1;
                                        content-height: offer-grid.preferred-height;
                                        offer-grid := VerticalLayout {
                                            width: offer-scroll.visible-width;
                                            height: self.preferred-height;
                                            alignment: start;
                                            spacing: 8px;
                                            for r in root.browse-card-rows: HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                for c in min(root.browse-cols, root.offer-rows.length - r * root.browse-cols): OfferItem {
                                                    width: (offer-scroll.visible-width - (root.browse-cols - 1) * 8px) / root.browse-cols;
                                                    offer: root.offer-rows[r * root.browse-cols + c];
                                                    current: root.browse-panel-id == self.offer.id;
                                                    busy: root.busy;
                                                    install => { root.browse-install(self.offer.id); }
                                                    // The panel opens at its top; the app sends its content
                                                    // (browse-open), and browse-filter shows what it has.
                                                    open => {
                                                        root.open-offer(self.offer);
                                                        panel-scroll.content-y = 0;
                                                        browse-keys.focus();
                                                        root.browse-filter();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // The list: one row per addon, the whole width; one open at a time.
                                    if root.browse-view == "list": list-scroll := ScrollView {
                                        vertical-stretch: 1;
                                        content-height: list-rows.preferred-height;
                                        list-rows := VerticalLayout {
                                            width: list-scroll.visible-width;
                                            height: self.preferred-height;
                                            alignment: start;
                                            spacing: 6px;
                                            for offer in root.offer-rows: OfferListItem {
                                                offer: offer;
                                                open: root.browse-panel-id == offer.id;
                                                busy: root.busy;
                                                panel: root.panel;
                                                ready: root.panel-ready && root.browse-panel-id == offer.id;
                                                more-open: root.panel-about-open;
                                                toggle => {
                                                    if (root.browse-panel-id == offer.id) {
                                                        root.browse-panel-id = "";
                                                        root.browse-close();
                                                    } else {
                                                        root.open-offer(offer);
                                                        browse-keys.focus();
                                                        root.browse-filter();
                                                    }
                                                }
                                                toggle-more => { root.panel-about-open = !root.panel-about-open; }
                                                picture(i) => { root.picture-show(offer.id, i); }
                                                frames(n) => { root.thumbs-shown(offer.id, n); }
                                                versions => { root.open-versions(offer.id); }
                                                page => { root.addon-page(offer.id); }
                                                install => { root.browse-install(offer.id); }
                                                install-anyway => { root.browse-install-anyway(offer.id); }
                                                update => { root.addon-update(offer.id); }
                                                update-anyway => { root.addon-update-anyway(offer.id); }
                                            }
                                        }
                                    }
                                    // The table, and the selected addon beside it: the pane 400 px at the
                                    // default size, 40 % of the area up to 520 px when wider.
                                    if root.browse-view == "table": split := HorizontalLayout {
                                        vertical-stretch: 1;
                                        spacing: root.small ? 8px : 12px;
                                        property <length> pane-width: root.width <= 1280px ? 400px : clamp(content.width * 0.4, 400px, 520px);
                                        // The tags too, where the table has room for them beside the pane.
                                        property <bool> wide: self.width >= 1240px;
                                        table-box := Rectangle {
                                            horizontal-stretch: 1;
                                            background: Look.panel;
                                            border-width: 1px;
                                            border-color: Look.line;
                                            border-radius: 6px;
                                            clip: true;
                                            // The marks of the column sorted by: ▲ A to Z, oldest or fewest
                                            // first; ▼ the other way.
                                            property <string> down: root.browse-sort-reverse ? "▲" : "▼";
                                            property <string> up: root.browse-sort-reverse ? "▼" : "▲";
                                            VerticalLayout {
                                                padding: 1px;
                                                // The headings over their columns, both clear of the scroll bar,
                                                // which is drawn over the rows' right edge.
                                                HorizontalLayout {
                                                    padding-left: TableColumns.padding(root.small);
                                                    padding-right: TableColumns.padding(root.small) + 4px;
                                                    spacing: TableColumns.spacing(root.small);
                                                    TableHead {
                                                        horizontal-stretch: 1;
                                                        min-width: 70px;
                                                        text: "Name";
                                                        sorts: true;
                                                        small: root.small;
                                                        mark: root.browse-sort == 0 ? table-box.up : "";
                                                        clicked => { root.sort-table(0); }
                                                    }
                                                    TableHead {
                                                        width: TableColumns.safety(root.small);
                                                        text: "Safety";
                                                        small: root.small;
                                                    }
                                                    TableHead {
                                                        width: TableColumns.version(root.small);
                                                        text: "Version";
                                                        small: root.small;
                                                    }
                                                    if split.wide: TableHead {
                                                        width: TableColumns.tags;
                                                        text: "Tags";
                                                        small: root.small;
                                                    }
                                                    TableHead {
                                                        width: TableColumns.updated(root.small);
                                                        text: "Last updated";
                                                        sorts: true;
                                                        small: root.small;
                                                        mark: root.browse-sort == 1 ? table-box.down : "";
                                                        clicked => { root.sort-table(1); }
                                                    }
                                                    TableHead {
                                                        width: TableColumns.popularity(root.small);
                                                        text: "Popularity";
                                                        align: TextHorizontalAlignment.right;
                                                        sorts: true;
                                                        small: root.small;
                                                        mark: root.browse-sort == 2 ? table-box.down : "";
                                                        clicked => { root.sort-table(2); }
                                                    }
                                                    TableHead {
                                                        width: TableColumns.install(root.small);
                                                        text: "Install";
                                                        small: root.small;
                                                    }
                                                }
                                                Rectangle {
                                                    height: 1px;
                                                    background: Look.line;
                                                }
                                                table-scroll := ScrollView {
                                                    vertical-stretch: 1;
                                                    content-height: table-rows.preferred-height;
                                                    table-rows := VerticalLayout {
                                                        width: table-scroll.visible-width;
                                                        height: self.preferred-height;
                                                        alignment: start;
                                                        for offer in root.offer-rows: OfferTableRow {
                                                            offer: offer;
                                                            wide: split.wide;
                                                            small: root.small;
                                                            busy: root.busy;
                                                            current: root.browse-panel-id == offer.id;
                                                            select => {
                                                                if (root.browse-panel-id != offer.id) {
                                                                    root.open-offer(offer);
                                                                    browse-keys.focus();
                                                                    root.browse-filter();
                                                                }
                                                            }
                                                            install => { root.browse-install(offer.id); }
                                                            update => { root.addon-update(offer.id); }
                                                            // The question the Installed tab's Remove… asks,
                                                            // naming the row it removes.
                                                            uninstall => {
                                                                root.remove-settings = false;
                                                                root.remove-name = offer.installed-name;
                                                                root.remove-id = offer.installed-id;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if root.browse-panel-id != "": TablePane {
                                            width: split.pane-width;
                                            offer: root.panel-offer;
                                            panel: root.panel;
                                            ready: root.panel-ready;
                                            tab <=> root.table-tab;
                                            more-open: root.panel-about-open;
                                            busy: root.busy;
                                            versions: root.versions;
                                            versions-ready: root.versions.id == root.browse-panel-id && root.versions-id == root.browse-panel-id;
                                            discord-checked: root.discord-checked;
                                            close => {
                                                root.browse-panel-id = "";
                                                root.browse-close();
                                            }
                                            tab-picked(tab) => {
                                                if (tab == 1) {
                                                    root.versions-id = root.browse-panel-id;
                                                    root.versions-open(root.browse-panel-id);
                                                }
                                            }
                                            toggle-more => { root.panel-about-open = !root.panel-about-open; }
                                            show-scan => { root.forge-show-scan(root.browse-panel-id); }
                                            picture(i) => { root.picture-show(root.browse-panel-id, i); }
                                            frames(n) => { root.thumbs-shown(root.browse-panel-id, n); }
                                            page => { root.addon-page(root.browse-panel-id); }
                                            install => { root.browse-install(root.browse-panel-id); }
                                            install-anyway => { root.browse-install-anyway(root.browse-panel-id); }
                                            update => { root.addon-update(root.browse-panel-id); }
                                            update-anyway => { root.addon-update-anyway(root.browse-panel-id); }
                                            version-install(tag, anyway) => { root.version-install(root.browse-panel-id, tag, anyway); }
                                            version-back(backup) => { root.version-back(root.browse-panel-id, backup); }
                                        }
                                    }
                                    Text {
                                        text: root.browse-note;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        color: Look.muted;
                                    }
                                }

                                // The cards' panel: against the right edge, at most 560 px wide; it
                                // slides in, and scrolls on its own. ✕ or Esc closes it. The list and the
                                // table show the same content in their own places.
                                panel-box := Overlay {
                                    property <float> slide: root.browse-panel-id != "" && root.browse-view != "list" && root.browse-view != "table" ? 1 : 0;
                                    // Before the app's answer, what the card says.
                                    property <int> action: root.panel-ready ? root.panel.action : root.panel-offer.action;
                                    property <string> reason: root.panel-ready ? root.panel.reason : root.panel-offer.reason;
                                    property <string> about: root.panel-ready && root.panel.about != "" ? root.panel.about : root.panel-offer.summary;
                                    animate slide {
                                        duration: 180ms;
                                        easing: ease-out;
                                    }
                                    visible: self.slide > 0;
                                    width: min(560px, parent.width);
                                    x: parent.width - self.width * self.slide;
                                    y: 0;
                                    height: parent.height;
                                    background: Look.panel;
                                    border-width: 1px;
                                    border-color: Look.line;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: start;
                                                Initials {
                                                    text: root.panel-offer.initials;
                                                    kind: root.panel-offer.initials-kind;
                                                    icon: root.panel-offer.icon;
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text {
                                                    text: root.panel-offer.name;
                                                    font-size: 15px;
                                                    font-weight: 700;
                                                    wrap: word-wrap;
                                                    color: Look.text;
                                                }
                                                Text {
                                                    text: root.panel-offer.author + (root.panel-ready && root.panel.verified-author ? " · verified author" : "")
                                                        + (root.panel-offer.downloads != "" ? " · " + root.panel-offer.downloads : "");
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                    color: Look.muted;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: start;
                                                PlainButton {
                                                    text: "✕";
                                                    clicked => {
                                                        root.browse-panel-id = "";
                                                        root.browse-close();
                                                    }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            for badge in root.panel-offer.badges: VerticalLayout {
                                                alignment: center;
                                                Badge {
                                                    text: badge.text;
                                                    kind: badge.kind;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        panel-scroll := ScrollView {
                                            vertical-stretch: 1;
                                            content-height: panel-list.preferred-height;
                                            panel-list := VerticalLayout {
                                                width: panel-scroll.visible-width;
                                                height: self.preferred-height;
                                                alignment: start;
                                                spacing: 8px;
                                                // Details and versions on their way.
                                                if !root.panel-ready || root.panel.loading: Installing {
                                                    text: "Loading…";
                                                }
                                                if root.panel-ready && root.panel.error != "": Text {
                                                    text: root.panel.error;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                    color: Look.amber;
                                                }
                                                // Only while the cards show it: the panel stays in place,
                                                // hidden, in the other views.
                                                if root.browse-view != "list" && root.browse-view != "table" && root.panel-ready && root.panel.pictures.length > 0: PicturesRow {
                                                    pictures: root.panel.pictures;
                                                    room: panel-scroll.visible-width;
                                                    open(i) => { root.picture-show(root.browse-panel-id, i); }
                                                    frames(n) => { root.thumbs-shown(root.browse-panel-id, n); }
                                                }
                                                AboutBlock {
                                                    panel: root.panel;
                                                    ready: root.panel-ready;
                                                    about: panel-box.about;
                                                    more-open: root.panel-about-open;
                                                    notes: false;
                                                    bars: false;
                                                    toggle-more => { root.panel-about-open = !root.panel-about-open; }
                                                }
                                                AboutBlock {
                                                    panel: root.panel;
                                                    ready: root.panel-ready;
                                                    about-part: false;
                                                }
                                                if root.panel-ready && root.panel.scan != "": ScanBlock {
                                                    panel: root.panel;
                                                    show-scan => { root.forge-show-scan(root.panel.id); }
                                                }
                                                if root.panel-ready && root.panel.folders != "": Text {
                                                    text: root.panel.folders;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                    color: Look.muted;
                                                }
                                            }
                                        }
                                        // The action stays in sight at the foot, the reason above it.
                                        if (panel-box.action == 1 || panel-box.action == 5) && panel-box.reason != "": Text {
                                            text: panel-box.reason;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            color: Look.amber;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.panel-offer.version + (root.panel-offer.date != "" ? " · " + root.panel-offer.date : "");
                                                font-size: 12px;
                                                color: Look.muted;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }
                                            Button {
                                                text: "Versions…";
                                                clicked => { root.open-versions(root.browse-panel-id); }
                                            }
                                            Button {
                                                text: "View on GitHub";
                                                clicked => { root.addon-page(root.browse-panel-id); }
                                            }
                                            OfferAction {
                                                action: panel-box.action;
                                                busy: root.busy;
                                                install => { root.browse-install(root.browse-panel-id); }
                                                install-anyway => { root.browse-install-anyway(root.browse-panel-id); }
                                                update => { root.addon-update(root.browse-panel-id); }
                                                update-anyway => { root.addon-update-anyway(root.browse-panel-id); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Removed: a table of the same style.
                            if root.addons-page == 2: VerticalLayout {
                                spacing: 8px;
                                vertical-stretch: 1;
                                Text {
                                    text: root.removed-rows.length == 0
                                        ? "Nothing removed on this PC yet. Addons you remove show here, with the way back."
                                        : "Removed on this PC, newest first. Their folders are in the Recycle Bin; Install again brings back the version each had.";
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    color: Look.muted;
                                }
                                removed-box := Rectangle {
                                    vertical-stretch: 1;
                                    background: Look.panel;
                                    border-width: 1px;
                                    border-color: Look.line;
                                    border-radius: 6px;
                                    clip: true;
                                    property <length> fixed: RemovedColumns.safety + RemovedColumns.version + RemovedColumns.removed + RemovedColumns.button + 5 * RemovedColumns.spacing + 26px;
                                    property <length> name-width: clamp((self.width - self.fixed) * 0.4, 140px, 360px);
                                    VerticalLayout {
                                        padding: 1px;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 14px;
                                            spacing: RemovedColumns.spacing;
                                            TableHead {
                                                width: removed-box.name-width;
                                                text: "Name";
                                            }
                                            TableHead {
                                                width: RemovedColumns.safety;
                                                text: "Safety";
                                            }
                                            TableHead {
                                                width: RemovedColumns.version;
                                                text: "Version";
                                            }
                                            TableHead {
                                                width: RemovedColumns.removed;
                                                text: "Removed";
                                            }
                                            TableHead {
                                                horizontal-stretch: 1;
                                                min-width: 80px;
                                                text: "Note";
                                            }
                                            TableHead {
                                                width: RemovedColumns.button;
                                                text: "";
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Look.line;
                                        }
                                        removed-scroll := ScrollView {
                                            vertical-stretch: 1;
                                            content-height: removed-list.preferred-height;
                                            removed-list := VerticalLayout {
                                                width: removed-scroll.visible-width;
                                                height: self.preferred-height;
                                                alignment: start;
                                                for row in root.removed-rows: RemovedTableRow {
                                                    removed: row;
                                                    open: root.removed-open == row.id;
                                                    busy: root.busy;
                                                    name-width: removed-box.name-width;
                                                    toggle => { root.removed-open = root.removed-open == row.id ? "" : row.id; }
                                                    install => { root.install-again(row.id); }
                                                    install-anyway => { root.install-again-anyway(row.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // The Legend, under its link: shown while the mouse is on the link or on it,
                        // or pinned by a click on the link (✕ or a second click unpins it). Not a
                        // PopupWindow, which would close at any click outside it.
                        if root.addons-page == 1: legend-card := Overlay {
                            visible: root.legend-link-hover || self.hovered || root.legend-pinned;
                            x: parent.width - self.width - 16px;
                            y: top-row.y + top-row.height + 16px;
                            width: min(460px, parent.width);
                            height: legend-list.preferred-height;
                            background: Look.panel;
                            border-width: 1px;
                            border-color: Look.line;
                            border-radius: 6px;
                            // Every badge Browse, Installed and Removed can show; short lines, so
                            // it fits under the top row at the smallest window.
                            legend-list := VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Legend";
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        color: Look.text;
                                    }
                                    if root.legend-pinned: PlainButton {
                                        text: "✕";
                                        clicked => { root.legend-pinned = false; }
                                    }
                                }
                                LegendLine {
                                    badge: "Discord Verified";
                                    kind: 0;
                                    text: "In the game's verified-addons channel" + (root.discord-checked != "" ? ", checked on " + root.discord-checked : "");
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · verified";
                                    kind: 4;
                                    text: "An admin approved this exact file";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · scanned";
                                    kind: 4;
                                    text: "Its scan found nothing; no admin has looked yet";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · flagged";
                                    kind: 5;
                                    text: "Its scan found something: it waits for your OK";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · unscanned";
                                    kind: 5;
                                    text: "Not scanned yet: it waits for your OK";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · no longer listed";
                                    kind: 5;
                                    text: "It left SurvivorsForge's list: it waits for your OK until checked";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · blocked";
                                    kind: 6;
                                    text: "Also · source changed and · another file: never installed; a copy you have stays, without updates";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge";
                                    kind: 4;
                                    text: "From SurvivorsForge; no level when removed, off or not answering";
                                }
                                LegendLine {
                                    badge: "Added by you";
                                    kind: 1;
                                    text: "Added by its GitHub link; it asks before each update";
                                }
                                LegendLine {
                                    badge: "From a file";
                                    kind: 2;
                                    text: "Imported from a zip file";
                                }
                                LegendLine {
                                    badge: "Installed by hand";
                                    kind: 3;
                                    text: "Found in AddOns, not installed by the Satchel";
                                }
                                LegendLine {
                                    badge: "No longer listed";
                                    kind: 1;
                                    text: "It left the Discord Verified list: no updates";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: start;
                                        width: 214px;
                                        HorizontalLayout {
                                            CheckMark { }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    Text {
                                        text: "Installed on this PC";
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        color: Look.muted;
                                    }
                                }
                                Text {
                                    text: "Groups: our list's groups and SurvivorsForge's categories";
                                    font-size: 11px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    color: Look.text;
                                }
                                Text {
                                    text: root.browse-tag-line;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    color: Look.muted;
                                }
                            }
                        }

                        // + Add: today's Add panel as a box over the table, 520 px wide, with its own ✕.
                        if root.add-open: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: #05070a99;
                            TouchArea {
                                clicked => { root.add-open = false; }
                            }
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: top-row.y + top-row.height + 16px;
                                width: min(520px, parent.width - 32px);
                                height: add-box.preferred-height;
                                background: Look.panel;
                                border-width: 1px;
                                border-color: Look.line;
                                border-radius: 6px;
                                TouchArea { }
                                add-box := VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "Add an addon";
                                            font-size: 13px;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            color: Look.text;
                                        }
                                        PlainButton {
                                            text: "✕";
                                            clicked => { root.add-open = false; }
                                        }
                                    }
                                    Text {
                                        text: "A GitHub link, or owner/name";
                                        font-size: 12.5px;
                                        color: Look.muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            text <=> root.link-text;
                                            placeholder-text: "github.com/owner/addon";
                                            horizontal-stretch: 1;
                                            accepted(text) => { root.link-lookup(text); }
                                        }
                                        PlainButton {
                                            text: "Look up";
                                            enabled: root.link-text != "" && root.link-state != 1;
                                            clicked => { root.link-lookup(root.link-text); }
                                        }
                                    }
                                    if root.link-state == 1: Text {
                                        text: root.link-message;
                                        color: Look.muted;
                                    }
                                    if root.link-state == 3: Text {
                                        text: root.link-message;
                                        wrap: word-wrap;
                                        color: Look.red;
                                    }
                                    if root.link-state == 2: Rectangle {
                                        border-width: root.link-warn ? 2px : 1px;
                                        border-color: root.link-warn ? Look.red : Look.line;
                                        border-radius: 6px;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 8px;
                                            Field {
                                                label: "Owner";
                                                value: root.link-owner;
                                            }
                                            Field {
                                                label: "Latest release";
                                                value: root.link-release;
                                            }
                                            Field {
                                                label: "Goes into AddOns";
                                                value: root.link-goes;
                                            }
                                            Text {
                                                text: root.link-note;
                                                wrap: word-wrap;
                                                font-weight: root.link-warn ? 600 : 400;
                                                color: root.link-warn ? Look.red : Look.muted;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "Or a zip file, as friends share them on Discord. Addons are text, pictures, fonts and sounds; anything else in a zip is left out.";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        color: Look.muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        PlainButton {
                                            text: "Import a zip file…";
                                            enabled: !root.busy;
                                            clicked => { root.import-zip(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        if (root.link-state == 2 || root.link-state == 3) && !root.link-installing: PlainButton {
                                            text: "Cancel";
                                            clicked => { root.link-clear(); }
                                        }
                                        if root.link-installing: Installing {}
                                        if !root.link-installing: PlainButton {
                                            text: "Install";
                                            primary: true;
                                            enabled: root.link-state == 2 && !root.busy;
                                            clicked => { root.link-install(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Settings: one column, 680 px, 900 px when the content area is 1,500 px or wider,
                // centred; the sections as boxes; Restore defaults under the last.
                if root.tab == 2: settings-scroll := ScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-height: settings-page.preferred-height;
                    settings-page := VerticalLayout {
                        width: settings-scroll.visible-width;
                        height: self.preferred-height;
                        padding: 16px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: center;
                            settings-list := VerticalLayout {
                                width: min(settings-scroll.visible-width - 32px, content.width >= 1500px ? 900px : 680px);
                                alignment: start;
                                spacing: 10px;
                                Section {
                                    heading: "General";
                                    SettingRow {
                                        text: "Start with Windows, in the tray";
                                        saved: root.saved-key == "start-with-windows";
                                        Switch {
                                            checked <=> root.start-with-windows;
                                            toggled => { root.setting-bool("start-with-windows", self.checked); }
                                        }
                                    }
                                    SettingRow {
                                        text: "Desktop shortcut \"Play Azeroth Survivors\"";
                                        saved: root.saved-key == "desktop-shortcut";
                                        Switch {
                                            checked <=> root.desktop-shortcut;
                                            toggled => { root.setting-bool("desktop-shortcut", self.checked); }
                                        }
                                    }
                                    SettingRow {
                                        text: "Windows notifications";
                                        saved: root.saved-key == "notifications";
                                        Switch {
                                            checked <=> root.notifications;
                                            toggled => { root.setting-bool("notifications", self.checked); }
                                        }
                                    }
                                    SettingRow {
                                        text: "Theme";
                                        saved: root.saved-key == "theme";
                                        Rectangle {
                                            border-width: 1px;
                                            border-color: Look.line;
                                            border-radius: 6px;
                                            clip: true;
                                            HorizontalLayout {
                                                Segment {
                                                    text: "System";
                                                    active: root.theme == 0;
                                                    filled: true;
                                                    first: true;
                                                    clicked => {
                                                        root.theme = 0;
                                                        root.setting-theme(0);
                                                    }
                                                }
                                                Segment {
                                                    text: "Light";
                                                    active: root.theme == 1;
                                                    filled: true;
                                                    clicked => {
                                                        root.theme = 1;
                                                        root.setting-theme(1);
                                                    }
                                                }
                                                Segment {
                                                    text: "Dark";
                                                    active: root.theme == 2;
                                                    filled: true;
                                                    clicked => {
                                                        root.theme = 2;
                                                        root.setting-theme(2);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                Section {
                                    heading: "Sync";
                                    alternate: true;
                                    SettingRow {
                                        text: "Sync my progress across PCs";
                                        detail: "Off by default. Turn it on on every PC that shares the folder.";
                                        saved: root.saved-key == "sync";
                                        Switch {
                                            checked <=> root.sync-switch;
                                            toggled => { root.setting-bool("sync", self.checked); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 2px;
                                        Text {
                                            text: "Network folder";
                                            width: 96px;
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.muted;
                                        }
                                        folder-edit := LineEdit {
                                            text <=> root.sync-folder;
                                            font-size: 12px;
                                            placeholder-text: "\\\\server\\share\\Azeroth Survivors Saves";
                                            horizontal-stretch: 1;
                                            accepted(text) => { root.setting-text("folder", text); }
                                            changed has-focus => {
                                                if (!self.has-focus) {
                                                    root.setting-text("folder", self.text);
                                                }
                                            }
                                        }
                                    }
                                    if root.folder-status != "": HorizontalLayout {
                                        spacing: 10px;
                                        padding-bottom: 6px;
                                        Rectangle { width: 96px; }
                                        Text {
                                            text: root.folder-status;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            color: root.folder-status-kind == 1 ? Look.green : root.folder-status-kind == 2 ? Look.red : Look.muted;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            text: "This PC's name";
                                            width: 96px;
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.muted;
                                        }
                                        LineEdit {
                                            text <=> root.pc-name;
                                            font-size: 12px;
                                            width: 200px;
                                            accepted(text) => { root.setting-text("pc-name", text); }
                                            changed has-focus => {
                                                if (!self.has-focus) {
                                                    root.setting-text("pc-name", self.text);
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if root.name-status != "": HorizontalLayout {
                                        spacing: 10px;
                                        padding-bottom: 6px;
                                        Rectangle { width: 96px; }
                                        Text {
                                            text: root.name-status;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            color: Look.red;
                                        }
                                    }
                                    if root.sync-switch: SettingRow {
                                        text: "The game's own settings on every PC";
                                        detail: "Interface options, key bindings, macros, chat, camera, where windows sit, and the HUD switches. Graphics stay on each PC."
                                            + (root.game-line != "" ? " · " + root.game-line : "");
                                        saved: root.saved-key == "game-shared";
                                        Switch {
                                            checked <=> root.game-shared;
                                            toggled => { root.setting-bool("game-shared", self.checked); }
                                        }
                                    }
                                    if root.sync-switch && root.game-note != "": Text {
                                        text: root.game-note;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        color: Look.accent;
                                    }
                                }
                                Section {
                                    heading: "Addons";
                                    SettingRow {
                                        text: "Updates go in by themselves before Play";
                                        detail: "For Discord Verified and SurvivorsForge addons; one you added by link always asks first.";
                                        saved: root.saved-key == "addons-auto";
                                        Switch {
                                            checked <=> root.addons-auto;
                                            toggled => { root.setting-bool("addons-auto", self.checked); }
                                        }
                                    }
                                    if root.sync-switch: SettingRow {
                                        text: "The same addons and their settings on every PC";
                                        saved: root.saved-key == "addons-shared";
                                        Switch {
                                            checked <=> root.addons-shared;
                                            toggled => { root.setting-bool("addons-shared", self.checked); }
                                        }
                                    }
                                    SettingRow {
                                        text: "More addons, descriptions and trust levels from SurvivorsForge";
                                        detail: "SurvivorsForge, Rezondes' addon registry: it scans every version of the addons it lists."
                                            + (root.forge-answer != "" ? " · " + root.forge-answer : "");
                                        saved: root.saved-key == "addons-forge";
                                        Switch {
                                            checked <=> root.addons-forge;
                                            toggled => { root.setting-bool("addons-forge", self.checked); }
                                        }
                                    }
                                }
                                Section {
                                    heading: "Game";
                                    alternate: true;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            text: "Game folder";
                                            width: 96px;
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.muted;
                                        }
                                        LineEdit {
                                            text <=> root.game-dir;
                                            font-size: 12px;
                                            horizontal-stretch: 1;
                                            accepted(text) => { root.setting-text("game-dir", text); }
                                            changed has-focus => {
                                                if (!self.has-focus) {
                                                    root.setting-text("game-dir", self.text);
                                                }
                                            }
                                        }
                                        Text {
                                            text: root.game-ok ? "✓ found" : "not found";
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: root.game-ok ? Look.green : Look.red;
                                        }
                                        PlainButton {
                                            text: "Find it";
                                            clicked => { root.detect-game(); }
                                        }
                                    }
                                    if !root.game-ok && root.game-status != "": HorizontalLayout {
                                        spacing: 10px;
                                        padding-bottom: 6px;
                                        Rectangle { width: 96px; }
                                        Text {
                                            text: root.game-status;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            color: Look.red;
                                        }
                                    }
                                    SettingRow {
                                        text: "Pause the game when I switch away (experimental)";
                                        detail: "Alt-Tab, the Windows key or a click elsewhere: the Satchel presses Esc in the game. If a menu is already open, that Esc closes it.";
                                        saved: root.saved-key == "pause-when-away";
                                        Switch {
                                            checked <=> root.pause-when-away;
                                            toggled => { root.setting-bool("pause-when-away", self.checked); }
                                        }
                                    }
                                }
                                Section {
                                    heading: "About";
                                    HorizontalLayout {
                                        spacing: 14px;
                                        padding-top: 6px;
                                        padding-bottom: 4px;
                                        alignment: start;
                                        Text {
                                            text: "Survivor's Satchel " + root.app-version;
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.text;
                                        }
                                        // "Checking…" in its place until the answer: a second click can't ask again.
                                        if !root.checking: PlainButton {
                                            text: "Check for updates";
                                            clicked => { root.check-updates(); }
                                        }
                                        if root.checking: Installing {
                                            text: "Checking…";
                                        }
                                        if root.update-version != "": PlainButton {
                                            text: "Update to " + root.update-version;
                                            primary: true;
                                            enabled: !root.busy;
                                            clicked => { root.update-now(); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 14px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        alignment: start;
                                        LinkText {
                                            text: "What's new";
                                            ink: Look.accent;
                                            font-size: 12.5px;
                                            clicked => { root.open-whats-new(); }
                                        }
                                        LinkText {
                                            text: "Where addons come from";
                                            ink: Look.accent;
                                            font-size: 12.5px;
                                            clicked => { root.sources-open = true; }
                                        }
                                        LinkText {
                                            text: "Where the game's notes come from";
                                            ink: Look.accent;
                                            font-size: 12.5px;
                                            clicked => { root.news-sources-open = true; }
                                        }
                                        if root.issue-url != "": LinkText {
                                            text: "Report a problem";
                                            ink: Look.accent;
                                            font-size: 12.5px;
                                            clicked => { root.open-url(root.issue-url); }
                                        }
                                        if root.repo-url != "": LinkText {
                                            text: "The Satchel on GitHub";
                                            ink: Look.accent;
                                            font-size: 12.5px;
                                            clicked => { root.open-url(root.repo-url); }
                                        }
                                    }
                                    // Hidden while a check runs (the last result would mislead) until its answer.
                                    if root.check-result != "" && !root.checking: Text {
                                        text: root.check-result;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        color: Look.muted;
                                    }
                                    if root.update-text != "" && root.update-gated: Text {
                                        text: root.update-text;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        color: Look.amber;
                                    }
                                    Text {
                                        text: (root.app-released != "" ? root.app-released + " · " : "") + root.app-build;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        color: Look.muted;
                                    }
                                    Text {
                                        text: "Settings are saved in " + root.settings-path;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        color: Look.muted;
                                    }
                                }
                                Section {
                                    heading: "Progress versions";
                                    alternate: true;
                                    Text {
                                        text: root.saves-note != "" ? root.saves-note : "Every copy of your progress the Satchel kept; bring an older one back if something went wrong.";
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        color: Look.muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            text: root.saves-summary + (root.save-rows.length > 0 ? " ·" : "");
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.text;
                                        }
                                        if root.save-rows.length > 0: VerticalLayout {
                                            alignment: center;
                                            LinkText {
                                                text: root.saves-open ? "Hide ▴" : "Show ▾";
                                                ink: Look.accent;
                                                font-size: 12.5px;
                                                clicked => { root.saves-open = !root.saves-open; }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if root.saves-open: VerticalLayout {
                                        HorizontalLayout {
                                            spacing: 8px;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            TableHead { width: 70px; text: "Version"; }
                                            TableHead { width: 120px; text: "When"; }
                                            TableHead { width: 90px; text: "From"; }
                                            TableHead { width: 60px; text: "Size"; }
                                            TableHead { horizontal-stretch: 1; text: "Note"; }
                                            TableHead { width: 120px; text: ""; }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Look.line;
                                        }
                                        for row[i] in root.save-rows: VerticalLayout {
                                            HorizontalLayout {
                                                spacing: 8px;
                                                padding: 8px;
                                                padding-top: 5px;
                                                padding-bottom: 5px;
                                                Text {
                                                    width: 70px;
                                                    text: row.version;
                                                    font-size: 12.5px;
                                                    font-weight: row.current ? 700 : 400;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    color: Look.text;
                                                }
                                                Text {
                                                    width: 120px;
                                                    text: row.when;
                                                    font-size: 12.5px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    color: Look.text;
                                                }
                                                Text {
                                                    width: 90px;
                                                    text: row.from;
                                                    font-size: 12.5px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    color: Look.text;
                                                }
                                                Text {
                                                    width: 60px;
                                                    text: row.size;
                                                    font-size: 12.5px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    color: Look.text;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: row.note;
                                                    font-size: 12.5px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    color: Look.muted;
                                                }
                                                VerticalLayout {
                                                    width: 120px;
                                                    alignment: center;
                                                    if row.can-bring: PlainButton {
                                                        text: "Bring this one in";
                                                        font-size: 12px;
                                                        height: 26px;
                                                        enabled: !root.busy;
                                                        clicked => { root.bring-back(i); }
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                height: 1px;
                                                background: Look.line;
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-top: 10px;
                                            padding-bottom: 2px;
                                            alignment: start;
                                            PlainButton {
                                                text: "Open the folder";
                                                clicked => { root.open-saves-folder(); }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: end;
                                    Text {
                                        text: "✓ Defaults restored";
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        color: Look.green;
                                        opacity: root.saved-key == "defaults" ? 1 : 0;
                                        animate opacity { duration: root.saved-key == "defaults" ? 0ms : 400ms; }
                                    }
                                    PlainButton {
                                        text: "Restore defaults";
                                        clicked => { root.restore-defaults(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // The game isn't on this PC: over Home and Addons; Settings stays reachable.
                if !root.game-found && root.tab != 2 && !root.setup: Overlay {
                    width: parent.width;
                    height: parent.height;
                    NoGame {
                        find => { root.find-game(); }
                        choose => { root.tab = 2; }
                        get-game => { root.open-game-site(); }
                    }
                }

                // The first start: one screen over the content.
                if root.setup: Overlay {
                    width: parent.width;
                    height: parent.height;
                    HomeCard {
                        width: min(520px, parent.width - 32px);
                        height: self.preferred-height;
                        x: (parent.width - self.width) / 2;
                        y: max(16px, (parent.height - self.height) / 2 - 40px);
                        VerticalLayout {
                            padding: 12px;
                            padding-top: 8px;
                            spacing: 16px;
                            Text {
                                text: "Welcome to Survivor's Satchel";
                                font-size: 20px;
                                font-weight: 600;
                                color: Look.text;
                            }
                            Rectangle {
                                background: Look.bg;
                                border-width: 1px;
                                border-color: Look.line;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 10px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Your game";
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.muted;
                                        }
                                        Text {
                                            text: root.game-ok ? root.game-dir : "Not found";
                                            font-size: 13px;
                                            font-weight: 600;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            color: root.game-ok ? Look.text : Look.red;
                                        }
                                        if root.game-ok: Text {
                                            text: "✓ found";
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            color: Look.green;
                                        }
                                        if root.game-ok: VerticalLayout {
                                            alignment: center;
                                            LinkText {
                                                text: "Change…";
                                                ink: Look.muted;
                                                font-size: 12.5px;
                                                clicked => { root.pick-game-folder(); }
                                            }
                                        }
                                        if !root.game-ok: PlainButton {
                                            text: "Find it";
                                            primary: true;
                                            clicked => { root.pick-game-folder(); }
                                        }
                                    }
                                    if root.setup-sync-line != "": Text {
                                        text: root.setup-sync-line;
                                        font-size: 12px;
                                        overflow: elide;
                                        color: Look.muted;
                                    }
                                }
                            }
                            PlainButton {
                                text: "Start";
                                primary: true;
                                height: 44px;
                                font-size: 15px;
                                enabled: root.game-ok;
                                clicked => { root.finish-setup(); }
                            }
                            Text {
                                text: "Play on more than one PC? Turn on sync in Settings whenever you like.";
                                font-size: 12.5px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                color: Look.muted;
                            }
                        }
                    }
                }
            }
        }
    }
    // The ticked boxes of the Lists and Groups filters, for the headings' counts.
    property <int> lists-on: root.filter-lists.length > 0 ? (root.filter-lists[0].on ? 1 : 0) + (root.filter-lists.length > 1 && root.filter-lists[1].on ? 1 : 0) : 0;
    in property <int> groups-on;

    // Versions… over the window, for the addon it was asked for: newest first, one button each.
    // Esc or Close closes it.
    if root.versions-overlay: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        versions-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-versions();
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                // Its column, at most 760 px wide, centred.
                width: min(760px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Versions of " + (root.versions.id == root.versions-id && root.versions.name != "" ? root.versions.name : "…");
                        font-size: 20px;
                        font-weight: 700;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    VerticalLayout {
                        alignment: start;
                        PlainButton {
                            text: "Close";
                            clicked => { root.close-versions(); }
                        }
                    }
                }
                Text {
                    text: "Newest first: the version installed, the ones kept on this PC to go back to, and every release known. A version you install or go back to here stays until you let it update.";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }
                // What the last action did, as the Addons tab says it under this.
                if root.addons-message != "": Rectangle {
                    border-radius: 6px;
                    background: Look.note-paper;
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.addons-message;
                            wrap: word-wrap;
                            color: Look.ink;
                        }
                    }
                }
                VersionsList {
                    vertical-stretch: 1;
                    versions: root.versions;
                    ready: root.versions.id == root.versions-id;
                    busy: root.busy;
                    install(tag, anyway) => { root.version-install(root.versions-id, tag, anyway); }
                    back(backup) => { root.version-back(root.versions-id, backup); }
                }
            }
        }
    }

    // The picture viewer: a box over the window, the window darkened behind it. In the box, the
    // title line with ✕, the open addon's screenshot `viewer-index` fitted inside at most 80 % of
    // the window's height, previous and next as round buttons on its edges (the arrow keys too),
    // and its caption under it. Esc, ✕, a click on the picture or on the darkened window closes it;
    // the buttons never do. Its pixels come from the app, and only the one shown is held.
    if root.viewer-open: viewer-box := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        property <int> count: root.panel-ready ? root.panel.pictures.length : 0;
        property <string> caption: self.count > root.viewer-index ? root.panel.pictures[root.viewer-index].caption : "";
        property <bool> has-previous: root.viewer-index > 0;
        property <bool> has-next: root.viewer-index + 1 < self.count;
        // The box's width; the picture's area as tall as its shape asks, at most 80 % of the
        // window's height and always room for the title line and the caption.
        property <length> box-width: min(1000px, root.width * 0.8);
        property <float> shape: self.count > root.viewer-index && root.panel.pictures[root.viewer-index].width > 0
            ? root.panel.pictures[root.viewer-index].height / root.panel.pictures[root.viewer-index].width : 0.5625;
        property <length> picture-height: min(min(root.height * 0.8, root.height - 116px), (self.box-width - 24px) * self.shape);
        viewer-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.picture-close();
                    return accept;
                }
                if (event.text == Key.LeftArrow && viewer-box.has-previous) {
                    root.picture-show(root.browse-panel-id, root.viewer-index - 1);
                    return accept;
                }
                if (event.text == Key.RightArrow && viewer-box.has-next) {
                    root.picture-show(root.browse-panel-id, root.viewer-index + 1);
                    return accept;
                }
                return reject;
            }
            // The window darkened behind the box: a click on it closes the viewer.
            Rectangle {
                background: #05070ab8;
            }
            TouchArea {
                clicked => { root.picture-close(); }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: viewer-box.box-width;
                height: box-layout.preferred-height;
                border-radius: 6px;
                border-width: 1px;
                border-color: Look.line;
                background: Look.panel;
                // A click on the box, off the picture and the buttons, does nothing.
                TouchArea { }
                box-layout := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.panel-offer.name + " · picture " + (root.viewer-index + 1) + " of " + max(1, viewer-box.count);
                            font-size: 12.5px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            color: Look.text;
                        }
                        LinkText {
                            text: "✕";
                            ink: Look.accent;
                            font-size: 13px;
                            clicked => { root.picture-close(); }
                        }
                    }
                    Rectangle {
                        height: viewer-box.picture-height;
                        border-radius: 4px;
                        background: Look.dark ? #0b0e13 : #1d2433;
                        if root.viewer-state == 1: Image {
                            source: root.viewer-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                            accessible-role: image;
                            accessible-label: viewer-box.caption != "" ? viewer-box.caption : "Picture " + (root.viewer-index + 1);
                        }
                        if root.viewer-state == 0: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Spinner {
                                    indeterminate: true;
                                    width: 28px;
                                    height: 28px;
                                }
                            }
                        }
                        if root.viewer-state == 2: Text {
                            text: "This picture isn't available.";
                            color: #c7ccd4;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // A click on the picture closes the viewer.
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.picture-close(); }
                        }
                        RoundButton {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            next: false;
                            enabled: viewer-box.has-previous;
                            clicked => { root.picture-show(root.browse-panel-id, root.viewer-index - 1); }
                        }
                        RoundButton {
                            x: parent.width - self.width - 10px;
                            y: (parent.height - self.height) / 2;
                            next: true;
                            enabled: viewer-box.has-next;
                            clicked => { root.picture-show(root.browse-panel-id, root.viewer-index + 1); }
                        }
                    }
                    if viewer-box.caption != "": Text {
                        text: viewer-box.caption;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: Look.muted;
                    }
                }
            }
        }
    }

    if root.whats-new-open: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at most 760 px wide, centred.
            width: min(760px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "What's new";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    color: Look.text;
                }
                PlainButton {
                    text: "Close";
                    clicked => { root.whats-new-open = false; }
                }
            }
            Text {
                text: "Survivor's Satchel " + root.app-version + (root.app-released != "" ? ", " + root.app-released : "") + ". What changed in each version, newest first.";
                font-size: 12px;
                wrap: word-wrap;
                color: Look.muted;
            }
            changelog-scroll := ScrollView {
                vertical-stretch: 1;
                content-height: changelog-list.preferred-height;
                changelog-list := VerticalLayout {
                    width: changelog-scroll.visible-width - 14px;
                    height: self.preferred-height;
                    alignment: start;
                    spacing: 6px;
                    for entry in root.changelog: ChangelogItem {
                        entry: entry;
                        current: entry.version == root.app-version;
                        open: root.changelog-open == entry.version;
                        toggle => { root.changelog-open = root.changelog-open == entry.version ? "" : entry.version; }
                    }
                }
            }
        }
    }

    // The game's patch notes over the window, newest first, every version open: the newest
    // build's note from the game's update server, the full notes from the Satchel's repository.
    // Esc or Close closes it.
    if root.game-news-open: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        news-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.game-news-open = false;
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                // Its column, at most 760 px wide, centred.
                width: min(760px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "What's new in the game";
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    PlainButton {
                        text: "Close";
                        clicked => { root.game-news-open = false; }
                    }
                }
                Text {
                    text: "Azeroth Survivors' patch notes, newest first: the newest build's note from the game's own update server, and the full notes kept with the Satchel. The text is the game developer's.";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }
                if root.game-notes-empty != "": Text {
                    text: root.game-notes-empty;
                    wrap: word-wrap;
                    color: Look.text;
                }
                news-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-height: news-list.preferred-height;
                    news-list := VerticalLayout {
                        width: news-scroll.visible-width - 14px;
                        height: self.preferred-height;
                        alignment: start;
                        spacing: 6px;
                        for entry in root.game-notes: GameNoteItem {
                            entry: entry;
                            current: entry.version == root.game-news-version;
                        }
                        if root.game-notes-footer != "": Text {
                            text: root.game-notes-footer;
                            font-size: 12px;
                            color: Look.muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // Where addons come from: both lists, the Sources list and SurvivorsForge's credit and links.
    if root.sources-open: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        sources-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.sources-open = false;
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                width: min(760px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Where addons come from";
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    PlainButton {
                        text: "Close";
                        clicked => { root.sources-open = false; }
                    }
                }
                Text {
                    text: "Discord Verified: the addons confirmed in the game's verified-addons channel on Discord. The list is built into the Satchel"
                        + (root.discord-checked != "" ? ", as we last checked the channel on " + root.discord-checked : "")
                        + ", and each addon downloads from its author's own GitHub releases.";
                    wrap: word-wrap;
                    color: Look.text;
                }
                Text {
                    text: "SurvivorsForge: Rezondes' addon registry, which scans every version of the addons it lists, while its admins approve exact files. The Satchel shows its trust levels and follows them: a version it blocks never installs, and one it flags, or hasn't scanned yet, waits for your OK. It can be turned off in Settings, under Addons"
                        + (root.forge-answer != "" ? " (" + root.forge-answer + ")" : "") + ".";
                    wrap: word-wrap;
                    color: root.forge-offline ? Look.amber : Look.text;
                }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    LinkText {
                        text: "SurvivorsForge on GitHub";
                        ink: Look.accent;
                        font-size: 12.5px;
                        clicked => { root.open-link(root.forge-repo-url); }
                    }
                    LinkText {
                        text: "SurvivorsForge website";
                        ink: Look.accent;
                        font-size: 12.5px;
                        clicked => { root.open-link(root.forge-site-url); }
                    }
                }
                Text {
                    text: "Sources";
                    font-weight: 600;
                    color: Look.text;
                }
                Text {
                    text: "✓ Discord Verified: the addons in the game's verified-addons channel"
                        + (root.discord-checked != "" ? ", checked on " + root.discord-checked : "")
                        + "; built into this Satchel";
                    wrap: word-wrap;
                    color: Look.text;
                }
                Text {
                    text: (root.saved-form.addons-forge ? "✓ " : "✗ ") + "SurvivorsForge: more addons, descriptions and trust levels"
                        + (root.saved-form.addons-forge ? "" : " (off in Settings)");
                    wrap: word-wrap;
                    color: Look.text;
                }
                Text {
                    text: "✓ Addons you add by link or from a zip file";
                    wrap: word-wrap;
                    color: Look.text;
                }
            }
        }
    }

    // Where the game's patch notes come from: its update server, and the notes file in the
    // Satchel's repository, with when each last answered.
    if root.news-sources-open: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        news-sources-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.news-sources-open = false;
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                width: min(760px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Where the game's notes come from";
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    PlainButton {
                        text: "Close";
                        clicked => { root.news-sources-open = false; }
                    }
                }
                Text {
                    text: "The newest build's note comes from the game's own update server, the file Azeroth Survivors reads to update itself (" + root.game-news-latest-answer + ").";
                    wrap: word-wrap;
                    color: Look.text;
                }
                Text {
                    text: "The full notes come from game/patch-notes.md in the Satchel's repository, kept by hand from the game's Discord posts; an edit there reaches every PC within half an hour, without an update of the Satchel (" + root.game-news-notes-answer + ").";
                    wrap: word-wrap;
                    color: Look.text;
                }
                HorizontalLayout {
                    alignment: start;
                    PlainButton {
                        text: "What's new in the game";
                        clicked => {
                            root.news-sources-open = false;
                            root.open-game-news();
                        }
                    }
                }
            }
        }
    }

    if root.remove-id != "": Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at most 760 px wide, centred.
            width: min(760px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            alignment: start;
            Text {
                text: "Remove " + root.remove-name + "?";
                font-size: 20px;
                font-weight: 700;
                wrap: word-wrap;
                color: Look.text;
            }
            Text {
                text: "Its folder goes to the Recycle Bin, so you can still get it back from there.";
                wrap: word-wrap;
                color: Look.text;
            }
            CheckBox {
                text: "Also remove its settings (where its windows sit, what it shows)";
                checked <=> root.remove-settings;
            }
            Text {
                text: "A copy of its settings stays in the Satchel's backups either way.";
                font-size: 12px;
                wrap: word-wrap;
                color: Look.muted;
            }
            HorizontalBox {
                padding: 0;
                alignment: end;
                PlainButton {
                    text: "Cancel";
                    clicked => { root.remove-id = ""; }
                }
                PlainButton {
                    text: "Remove";
                    primary: true;
                    clicked => {
                        root.addon-remove(root.remove-id, !root.remove-settings);
                        root.remove-id = "";
                    }
                }
            }
        }
    }

    // The blocking question at Play: two PCs moved on separately.
    if root.needs-you: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at most 760 px wide, centred.
            width: min(760px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            alignment: start;
            Text {
                text: "Needs you";
                font-size: 20px;
                font-weight: 700;
                color: Look.red;
            }
            Text {
                text: "Two PCs moved on separately";
                font-weight: 600;
                color: Look.text;
            }
            Text {
                text: "Your progress changed here and on " + root.needs-other-pc + " since this PC last synced. Pick the one to continue with. The other one is kept as a version.";
                wrap: word-wrap;
                color: Look.text;
            }
            HorizontalBox {
                padding: 0;
                HomeCard {
                    heading: "This PC";
                    horizontal-stretch: 1;
                    Text {
                        text: "Keep this PC's";
                        font-size: 18px;
                        font-weight: 700;
                        color: Look.text;
                    }
                    Text {
                        text: root.needs-here;
                        wrap: word-wrap;
                        color: Look.text;
                    }
                }
                HomeCard {
                    heading: "Network folder · from " + root.needs-other-pc;
                    horizontal-stretch: 1;
                    Text {
                        text: "Use " + root.needs-other-pc + "'s";
                        font-size: 18px;
                        font-weight: 700;
                        color: Look.text;
                    }
                    Text {
                        text: root.needs-other;
                        wrap: word-wrap;
                        color: Look.text;
                    }
                }
            }
            HorizontalBox {
                padding: 0;
                PlainButton {
                    text: "Keep this PC's";
                    horizontal-stretch: 1;
                    clicked => { root.keep-here(); }
                }
                PlainButton {
                    text: "Use " + root.needs-other-pc + "'s";
                    horizontal-stretch: 1;
                    clicked => { root.use-other(); }
                }
            }
            HorizontalBox {
                padding: 0;
                alignment: end;
                PlainButton {
                    text: "Decide later";
                    clicked => { root.decide-later(); }
                }
            }
        }
    }
}
