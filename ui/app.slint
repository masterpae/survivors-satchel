// Survivor's Satchel: the tray icon, the main window, and the Play card.
import { AboutSlint, Button, CheckBox, ComboBox, HorizontalBox, LineEdit, Palette, ScrollView, Spinner, StandardTableView, Switch, TabWidget, VerticalBox } from "std-widgets.slint";

// The tray colour, and the shape inside the satchel, is the sync state.
export enum TrayState { synced, busy, playing, needs-you, offline }

export struct CardLine {
    text: string,
    done: bool,
    warn: bool,
}

export struct PcTime {
    name: string,
    time: string,
    share: float,
}

// A line of "Recent on this PC"; `kind` picks its icon: 0 sync, 1 addon, 2 game, 3 playtime,
// 4 warning, 5 the Satchel itself.
export struct RecentLine {
    kind: int,
    text: string,
}

// A badge: its words, and `kind`, its colour (`Look.badge-ink`): 0 Discord Verified, 1 added by
// link or no longer listed, 2 from a file, 3 by hand, 4 SurvivorsForge lets it in (verified,
// scanned), 5 it waits for the player's OK (flagged, unscanned), 6 never (blocked).
export struct BadgeRow {
    text: string,
    kind: int,
}

// An addon in AddOns. `badge-kind` (the Initials' colour): 0 Discord Verified, 1 added by link,
// 2 from a file, 3 by hand, 4 SurvivorsForge only. `badges`: every badge that applies, shown in
// place of `badge` when there are any. `state-kind`: 0 plain, 1 an update, 2 needs a look. `icon`:
// its icon from SurvivorsForge, empty until the window holds it (the initials show).
export struct AddonRow {
    id: string,
    initials: string,
    icon: image,
    name: string,
    badge: string,
    badge-kind: int,
    badges: [BadgeRow],
    author: string,
    version: string,
    released: string,
    update: string,
    state: string,
    state-kind: int,
    on: bool,
    switchable: bool,
    problem: string,
    problems: string,
    notes: string,
    notes-title: string,
    back-to: string,
    pinned: bool,
    can-pin: bool,
    can-update: bool,
    has-page: bool,
    replace-with: string,
    installing: bool,
    // About the other PCs; `share-kind`: 0 plain, 1 news, 2 needs a look.
    share: string,
    share-kind: int,
    shared: bool,
    local-only: bool,
    settings-per-pc: bool,
    // Its settings changed here and on this PC: the player picks.
    ask-pc: string,
    // Another PC has it; it comes here at the next Play.
    incoming: bool,
    // SurvivorsForge's word against its update, as a sentence; `reason-kind` 1: it waits for the
    // player's OK (Update anyway), 2: never (no update button).
    reason: string,
    reason-kind: int,
    // The Safety column: SurvivorsForge's level (`safety`, coloured by `safety-kind` as its badge)
    // with "SurvivorsForge" under it (`safety-by`), else its badge's word on one line.
    safety: string,
    safety-kind: int,
    safety-by: string,
    // The Status column's one line; `status-kind` 0 plain, 1 good news, 2 needs a look, 3 never.
    status: string,
    status-kind: int,
}

// An addon removed on this PC (the Addons tab's Removed page).
export struct RemovedRow {
    id: string,
    initials: string,
    name: string,
    badge: string,
    badge-kind: int,
    version: string,
    when: string,
    detail: string,
    can-install: bool,
    note: string,
    // SurvivorsForge's word on the version it had: `reason-kind` 1 it waits for the player's OK
    // (its button reads Install anyway), 2 never (no button).
    reason: string,
    reason-kind: int,
}

// A block of a version's changes: `kind` 0 a paragraph, 1 a heading, 2 a point, 3 a point inside
// a point, 4 an aside in muted text (the game's notes: "The full notes are on the game's Discord").
export struct ChangelogBlock {
    kind: int,
    text: string,
}

export struct ChangelogEntry {
    version: string,
    date: string,
    blocks: [ChangelogBlock],
}

// The Settings fields as they are saved: Save lights up only when the form differs.
export struct SettingsForm {
    game-dir: string,
    sync: bool,
    folder: string,
    pc-name: string,
    start-with-windows: bool,
    desktop-shortcut: bool,
    notifications: bool,
    addons-auto: bool,
    addons-shared: bool,
    addons-forge: bool,
    pause-when-away: bool,
    theme: int,
    game-shared: bool,
    // Browse's view as saved (list, cards, table): not one of Settings' fields, so Save doesn't
    // light up for it.
    browse-view: string,
}

// An addon on offer in Browse: one card, list row or table row. `initials-kind` colours its
// Initials (0 our list, 4 SurvivorsForge only); `icon` stands in for them once the window holds it.
// `downloads`: "8,382 downloads", or empty. `action`, as its pane's: 0 Install, 1 Install anyway
// (it asks first: a click opens it), 2 Installing…, 3 Installed, 4 Update, 5 Update anyway (asks
// first, as 1). `installed`: in AddOns (a check mark after its name); `installed-id`: its row in
// the Installed tab, which Uninstall removes, and `installed-name` that row's name, which the
// question names (both empty when no row is this addon alone: no Uninstall). The lists it is on
// (`ours`, `forge`). The table's
// columns: who vouches for it (`safety`, coloured by `safety-kind` as its badge, with `safety-by`
// under it), its tags in a line, its downloads as a number (`popularity`, empty when unknown), and
// the Install column's button (`install-text`, the primary kind when `install-primary`).
export struct OfferRow {
    id: string,
    initials: string,
    icon: image,
    initials-kind: int,
    name: string,
    author: string,
    downloads: string,
    summary: string,
    badges: [BadgeRow],
    version: string,
    date: string,
    action: int,
    reason: string,
    warning: string,
    installed: bool,
    installed-id: string,
    installed-name: string,
    ours: bool,
    forge: bool,
    safety: string,
    safety-kind: int,
    safety-by: string,
    tags: string,
    popularity: string,
    install-text: string,
    install-primary: bool,
}

// A tag chip in Browse's filters, on or off (none on: every tag).
export struct TagRow {
    text: string,
    on: bool,
}

// One version's downloads in the panel: `share` of the largest count, for the bar's length.
export struct BarRow {
    label: string,
    count: string,
    share: float,
}

// One screenshot in an addon's pictures row: its shape, as its details give it, its caption, and
// its thumbnail once the window holds it (empty until then: the placeholder frame shows).
export struct PictureRow {
    width: int,
    height: int,
    caption: string,
    thumb: image,
}

// What Browse shows of the addon opened (the cards' panel, the list's open row, the table's pane);
// `id` names the offer it is for. `action`: 0 Install, 1 Install anyway, 2 Installing…,
// 3 Installed, 4 Update, 5 Update anyway (`reason` above 1 and 5). `pictures`: its pictures row.
export struct PanelRow {
    id: string,
    verified-author: bool,
    about: string,
    about-more: string,
    notes-title: string,
    notes: string,
    bars: [BarRow],
    scan: string,
    scan-more: bool,
    findings: [string],
    folders: string,
    pictures: [PictureRow],
    action: int,
    reason: string,
    loading: bool,
    error: string,
}

// One version in Versions…: `marks` ("installed", "kept on 20 Oct"), `detail` (date, downloads,
// size, the game range, what the scan found), SurvivorsForge's `badge`. `action`: 0 none, 1 Go back
// to this (`key` names its backup), 2 Install this version, 3 Install anyway (`key` its tag;
// `reason` says why it asks), 4 installing. `reason-kind` 1 it waits for an OK, 2 never.
export struct VersionItem {
    version: string,
    marks: string,
    detail: string,
    badge: string,
    badge-kind: int,
    action: int,
    key: string,
    reason: string,
    reason-kind: int,
}

// Versions… for one addon (`id`), newest first; `loading`: SurvivorsForge's versions on their way.
export struct VersionsRow {
    id: string,
    name: string,
    rows: [VersionItem],
    loading: bool,
}

// The app's own colours, each in a light and a dark version; `dark` follows the window's theme.
global Look {
    in-out property <bool> dark;
    out property <color> muted: dark ? #9aa1ab : #8a8f98;
    out property <color> green: dark ? #5ccb8c : #1f8a4c;
    out property <color> blue: dark ? #78a9f5 : #2361c4;
    out property <color> gold: dark ? #e0b453 : #a8770c;
    out property <color> amber: dark ? #f0a650 : #b56d00;
    out property <color> red: dark ? #f1867e : #b3312a;
    out property <color> violet: dark ? #b69cf5 : #6a3db8;
    // Text on the tinted panels: the Play tab's banner, a passing message.
    out property <color> ink: dark ? #e9edf3 : #1d2433;
    out property <color> note-paper: dark ? #1e2a3d : #eaf1fc;
    // Who vouches for an addon: Discord Verified, added by link, from a file, by hand; then
    // SurvivorsForge's word: it lets it in (violet), it waits for the player's OK (amber), never
    // (red). The three new inks read at 4.5:1 or more on their papers, in both themes.
    public pure function badge-ink(kind: int) -> color {
        kind == 0 ? green : kind == 1 ? blue : kind == 2 ? gold : kind == 4 ? violet
            : kind == 5 ? (dark ? amber : #9a5c00) : kind == 6 ? red : muted
    }
    public pure function badge-paper(kind: int) -> color {
        dark ? (kind == 0 ? #1d3a2a : kind == 1 ? #1e2c46 : kind == 2 ? #3d3220 : kind == 4 ? #2c2445
                : kind == 5 ? #3d2f17 : kind == 6 ? #43231f : #2b2f36)
            : (kind == 0 ? #e3f3e9 : kind == 1 ? #e6eefb : kind == 2 ? #f8efd9 : kind == 4 ? #f0eafb
                : kind == 5 ? #fcf0dc : kind == 6 ? #fbe9e7 : #eceef1)
    }
    // The Play tab's banner, by the tray's state.
    public pure function banner(state: TrayState) -> color {
        state == TrayState.needs-you ? (dark ? #43231f : #fbecea)
            : state == TrayState.offline ? (dark ? #3d2f17 : #fdf3e1)
            : state == TrayState.busy ? (dark ? #1e2a3d : #eaf1fc)
            : state == TrayState.playing ? (dark ? #3a3119 : #fbf4e2)
            : (dark ? #1b3326 : #e9f6ee)
    }
}

export component SatchelTray inherits SystemTrayIcon {
    in property <TrayState> state: TrayState.synced;
    in property <string> status: "Starting";
    in property <bool> sync-on;
    callback open-tab(int);
    callback play();
    callback sync-now();
    callback quit();

    icon: root.state == TrayState.busy ? @image-url("icons/satchel-blue.svg")
        : root.state == TrayState.playing ? @image-url("icons/satchel-gold.svg")
        : root.state == TrayState.needs-you ? @image-url("icons/satchel-red.svg")
        : root.state == TrayState.offline ? @image-url("icons/satchel-amber.svg")
        : @image-url("icons/satchel-green.svg");
    tooltip: "Survivor's Satchel · " + root.status;
    clicked => { root.open-tab(-1); }

    Menu {
        MenuItem {
            title: "Play Azeroth Survivors";
            activated => { root.play(); }
        }
        MenuItem {
            title: "Sync now";
            enabled: root.sync-on;
            activated => { root.sync-now(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Addons…";
            activated => { root.open-tab(1); }
        }
        MenuItem {
            title: "Saves…";
            activated => { root.open-tab(2); }
        }
        MenuItem {
            title: "Playtime…";
            activated => { root.open-tab(3); }
        }
        MenuItem {
            title: "Settings…";
            activated => { root.open-tab(4); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Exit";
            activated => { root.quit(); }
        }
    }
}

// The small card in the corner while Play runs; it grows with its lines.
export component PlayCard inherits Window {
    in property <[CardLine]> lines;
    in property <bool> asking;
    // The lines' text as it wraps at this width, counted by the app: a wrapped line isn't measured
    // until the card has been laid out once, and the card is placed before that.
    in property <int> text-lines: 1;
    out property <length> wanted-height: min(max(120px, 48px + root.text-lines * 20px + root.lines.length * 6px + (root.asking ? 46px : 0px)), 460px);
    callback cancel();
    callback play-anyway();
    // A newer Satchel downloaded from GitHub: its version, and the button that puts it in place.
    in property <string> update-version;
    callback update-now();
    // Dark or light, as Settings' theme says.
    in property <bool> dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }

    title: "Survivor's Satchel";
    no-frame: true;
    always-on-top: true;
    width: 380px;
    height: root.wanted-height;
    background: Palette.background;

    Rectangle {
        border-width: 1px;
        border-color: Palette.border;

        body := VerticalBox {
            alignment: start;
            Text {
                text: "Survivor's Satchel";
                font-weight: 700;
            }
            for line in root.lines: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: line.done ? "✓" : line.warn ? "!" : "…";
                    width: 14px;
                    color: line.warn ? Look.amber : line.done ? Look.green : Palette.foreground;
                    font-weight: 700;
                }
                Text {
                    text: line.text;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            if root.asking: HorizontalBox {
                padding: 0;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                if root.update-version != "": Button {
                    text: "Update now";
                    primary: true;
                    clicked => { root.update-now(); }
                }
                Button {
                    text: "Play anyway";
                    primary: root.update-version == "";
                    clicked => { root.play-anyway(); }
                }
            }
        }
    }
}

component Card inherits Rectangle {
    in property <string> heading;
    in property <string> main;
    in property <string> detail;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: root.heading;
            font-size: 11px;
            color: Look.muted;
        }
        Text {
            text: root.main;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: root.detail;
            wrap: word-wrap;
        }
    }
}

// A pick between two progresses: a card that can be selected.
component Choice inherits Rectangle {
    in property <bool> selected;
    in property <string> heading;
    in property <string> detail;
    callback picked();
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent-background : Palette.border;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: (root.selected ? "● " : "○ ") + root.heading;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            wrap: word-wrap;
            color: Look.muted;
        }
    }
    TouchArea {
        clicked => { root.picked(); }
    }
}

// A panel over the whole window, or over part of it; it swallows clicks meant for what is
// underneath. `hovered`: the mouse is over it (Browse's Legend stays open while it is).
component Overlay inherits Rectangle {
    out property <bool> hovered: touch.has-hover;
    background: Palette.background;
    touch := TouchArea { }
    @children
}

// A small rounded button that is on or off: the Addons tab's pages, Browse's lists and tags.
// `enabled: false` greys it out and it ignores clicks.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 26px;
    border-radius: 13px;
    border-width: root.active ? 0 : 1px;
    border-color: Palette.border;
    background: root.active ? Palette.accent-background : touch.has-hover && root.enabled ? Palette.alternate-background : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 12px;
            color: root.active ? Palette.accent-foreground : root.enabled ? Palette.foreground : Look.muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The square with an addon's initials, in the colour of who vouches for it; its icon from
// SurvivorsForge in their place once the window holds one. The square's size never changes.
component Initials inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <image> icon;
    width: 34px;
    height: 34px;
    border-radius: 7px;
    // An icon comes with the square's corners rounded already.
    background: root.icon.width > 0 ? transparent : Look.badge-paper(root.kind);
    clip: true;

    if root.icon.width == 0: Text {
        text: root.text;
        font-size: 12px;
        font-weight: 700;
        color: Look.badge-ink(root.kind);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon.width > 0: Image {
        source: root.icon;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
}

// Who vouches for an addon; always shown.
component Badge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    border-radius: 4px;
    background: Look.badge-paper(root.kind);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 600;
            color: Look.badge-ink(root.kind);
            vertical-alignment: center;
        }
    }
}

// An install under way, where its button was; `text` names another wait (a check for updates).
// `small`: in a table's cell, its spinner and words smaller.
component Installing inherits HorizontalLayout {
    in property <string> text: "Installing…";
    in property <bool> small;
    spacing: root.small ? 4px : 6px;
    alignment: start;
    // A fixed size overrides the spinner's own 30px minimum.
    Spinner {
        indeterminate: true;
        width: root.small ? 14px : 20px;
        height: root.small ? 14px : 20px;
    }
    if !root.small: Text {
        text: root.text;
        vertical-alignment: center;
        color: Look.muted;
    }
    if root.small: Text {
        text: root.text;
        font-size: 11px;
        vertical-alignment: center;
        color: Look.muted;
    }
}

// The green check mark after an installed addon's name.
component CheckMark inherits Rectangle {
    width: 12px;
    height: 12px;
    accessible-role: image;
    accessible-label: "installed";
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 2 6.5 L 5 9.5 L 10.5 3";
        stroke: Look.green;
        stroke-width: 2px;
        fill: transparent;
    }
}

// A small button in a table's cell: the primary kind filled, the plain one outlined.
component RowButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 24px;
    border-radius: 4px;
    border-width: root.primary ? 0 : 1px;
    border-color: Palette.border;
    background: !root.enabled ? Palette.alternate-background
        : root.primary ? (touch.has-hover ? Palette.accent-background.darker(10%) : Palette.accent-background)
        : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: root.primary ? 600 : 400;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: !root.enabled ? Look.muted : root.primary ? Palette.accent-foreground : Palette.foreground;
        }
    }
    // Greyed, a click on it still does nothing else: it never falls through to the row under it.
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// The Safety column's cell: who vouches for an addon, its level coloured as its badge, and who gave
// the level under it (`by`, empty: one line).
component SafetyText inherits VerticalLayout {
    in property <string> word;
    in property <int> kind;
    in property <string> by;
    alignment: center;
    Text {
        text: root.word;
        font-size: 11px;
        font-weight: 600;
        overflow: elide;
        color: Look.badge-ink(root.kind);
    }
    if root.by != "": Text {
        text: root.by;
        font-size: 10px;
        overflow: elide;
        color: Look.muted;
    }
}

// The Installed tab's columns, as wide as its rows and its headings both take them.
global InstalledColumns {
    out property <length> safety: 96px;
    out property <length> version: 120px;
    out property <length> released: 84px;
    out property <length> on: 52px;
    out property <length> spacing: 8px;
}

// One installed addon, a row of the Installed tab's columns: its square, name and author; who
// vouches for it; its version, and the one an update brings; when it was released; its status in
// one line (`status-width` wide); its switch. A click on the row opens what can be done with it
// under the row: its badges, every line about it whole, the problems, the notes, the buttons and the
// check boxes.
component AddonTableRow inherits Rectangle {
    in property <AddonRow> addon;
    in property <bool> open;
    in property <bool> busy;
    in property <length> status-width;
    callback toggle();
    callback switched(bool);
    callback update();
    // SurvivorsForge asks first about its update: the player OKs it.
    callback update-anyway();
    callback replace();
    callback back();
    callback keep(bool);
    callback page();
    callback folder();
    callback remove();
    callback local-only(bool);
    callback settings-per-pc(bool);
    callback settings-choice(bool);
    // Versions…, for an installed addon.
    callback versions();
    // An incoming addon that waits for the player's OK: Install anyway.
    callback install-anyway();
    border-radius: 4px;
    border-width: root.open ? 1px : 0;
    border-color: Palette.accent-background;
    property <color> status-ink: root.addon.status-kind == 1 ? Look.green
        : root.addon.status-kind == 2 ? Look.amber : root.addon.status-kind == 3 ? Look.red : Look.muted;

    VerticalLayout {
        Rectangle {
            height: 44px;
            border-radius: 4px;
            background: root.open ? Look.note-paper : row-touch.has-hover ? Palette.alternate-background : transparent;
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
            }
            HorizontalLayout {
                padding-left: 4px;
                // Clear of the scroll bar, as the headings are.
                padding-right: 14px;
                spacing: InstalledColumns.spacing;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    min-width: 140px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Initials {
                            text: root.addon.initials;
                            kind: root.addon.badge-kind;
                            icon: root.addon.icon;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.addon.name;
                            font-size: 12px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        if root.addon.author != "": Text {
                            text: root.addon.author;
                            font-size: 11px;
                            color: Look.muted;
                            overflow: elide;
                        }
                    }
                }
                SafetyText {
                    width: InstalledColumns.safety;
                    word: root.addon.safety;
                    kind: root.addon.safety-kind;
                    by: root.addon.safety-by;
                }
                HorizontalLayout {
                    width: InstalledColumns.version;
                    spacing: 4px;
                    Text {
                        text: root.addon.version;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.addon.update != "": Text {
                        text: "→ " + root.addon.update;
                        font-size: 11px;
                        font-weight: 600;
                        color: Look.green;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    width: InstalledColumns.released;
                    text: root.addon.released;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    width: root.status-width;
                    text: root.addon.status;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    color: root.status-ink;
                }
                VerticalLayout {
                    width: InstalledColumns.on;
                    alignment: center;
                    if !root.addon.incoming: HorizontalLayout {
                        alignment: end;
                        Switch {
                            checked: root.addon.on;
                            enabled: root.addon.switchable && !root.busy;
                            toggled => { root.switched(self.checked); }
                        }
                    }
                }
            }
        }
        if root.open: VerticalLayout {
            padding: 10px;
            padding-top: 6px;
            spacing: 6px;
            // Every badge that applies; a row without them shows its one badge.
            HorizontalLayout {
                spacing: 4px;
                if root.addon.badges.length == 0: VerticalLayout {
                    alignment: center;
                    Badge {
                        text: root.addon.badge;
                        kind: root.addon.badge-kind;
                    }
                }
                for badge in root.addon.badges: VerticalLayout {
                    alignment: center;
                    Badge {
                        text: badge.text;
                        kind: badge.kind;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // Every line about it, whole: where it stands, SurvivorsForge's word, the other PCs.
            if root.addon.state != "": Text {
                text: root.addon.state;
                font-size: 12px;
                wrap: word-wrap;
                color: root.addon.state-kind == 1 ? Look.green : root.addon.state-kind == 2 ? Look.amber : Look.muted;
            }
            if root.addon.reason != "": Text {
                text: root.addon.reason;
                font-size: 12px;
                wrap: word-wrap;
                color: root.addon.reason-kind == 2 ? Look.red : Look.amber;
            }
            if root.addon.share != "": Text {
                text: root.addon.share;
                font-size: 12px;
                wrap: word-wrap;
                color: root.addon.share-kind == 1 ? Look.green : root.addon.share-kind == 2 ? Look.amber : Look.muted;
            }
            if root.addon.problems != "": Text {
                text: root.addon.problems;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.amber;
            }
            if root.addon.notes != "": Text {
                text: root.addon.notes-title;
                font-size: 12px;
                font-weight: 600;
            }
            if root.addon.notes != "": Text {
                text: root.addon.notes;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.addon.ask-pc != "": HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button {
                    text: "Keep this PC's";
                    enabled: !root.busy;
                    clicked => { root.settings-choice(true); }
                }
                Button {
                    text: "Use " + root.addon.ask-pc + "'s";
                    enabled: !root.busy;
                    clicked => { root.settings-choice(false); }
                }
            }
            // Another PC has it, and SurvivorsForge asks first here: the player's OK, on its row.
            if root.addon.incoming: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.addon.installing: Installing {}
                if root.addon.reason-kind == 1 && !root.addon.installing: Button {
                    text: "Install anyway";
                    enabled: !root.busy;
                    clicked => { root.install-anyway(); }
                }
                if root.addon.has-page: Button {
                    text: "GitHub page";
                    clicked => { root.page(); }
                }
            }
            if !root.addon.incoming: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.addon.installing: Installing {}
                // Update now; Update anyway when SurvivorsForge asks first; none when it says never.
                if root.addon.can-update && !root.addon.installing && root.addon.reason-kind == 0: Button {
                    text: "Update now";
                    primary: true;
                    enabled: !root.busy;
                    clicked => { root.update(); }
                }
                if root.addon.can-update && !root.addon.installing && root.addon.reason-kind == 1: Button {
                    text: "Update anyway";
                    enabled: !root.busy;
                    clicked => { root.update-anyway(); }
                }
                if root.addon.replace-with != "" && !root.addon.installing && root.addon.reason-kind != 2: Button {
                    text: "Replace with " + root.addon.replace-with;
                    enabled: !root.busy;
                    clicked => { root.replace(); }
                }
                if root.addon.back-to != "": Button {
                    text: "Go back to " + root.addon.back-to;
                    enabled: !root.busy;
                    clicked => { root.back(); }
                }
                Button {
                    text: "Versions…";
                    clicked => { root.versions(); }
                }
            }
            if !root.addon.incoming: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.addon.has-page: Button {
                    text: "GitHub page";
                    clicked => { root.page(); }
                }
                Button {
                    text: "Folder";
                    clicked => { root.folder(); }
                }
                Button {
                    text: "Remove…";
                    enabled: !root.busy;
                    clicked => { root.remove(); }
                }
            }
            if root.addon.can-pin: CheckBox {
                text: "Keep this version: no updates until I untick this";
                checked: root.addon.pinned;
                toggled => { root.keep(self.checked); }
            }
            if root.addon.shared: CheckBox {
                text: "Only on this PC: not shared with my other PCs";
                checked: root.addon.local-only;
                toggled => { root.local-only(self.checked); }
            }
            if root.addon.shared && !root.addon.local-only: CheckBox {
                text: "Settings per PC: each PC keeps its own (on every PC)";
                checked: root.addon.settings-per-pc;
                toggled => { root.settings-per-pc(self.checked); }
            }
        }
    }
}

// One addon in Browse, as a card; a click anywhere but its button opens its panel. Its badges
// go one per line: two side by side don't fit a card of the two columns at 540 px, and Slint has
// no layout that wraps. Cards in one row of the grid share its height; the footer stays at the foot.
component OfferItem inherits Rectangle {
    in property <OfferRow> offer;
    // Its panel is open.
    in property <bool> current;
    in property <bool> busy;
    callback open();
    callback install();
    border-width: 1px;
    border-color: root.current ? Palette.accent-background : Palette.border;
    border-radius: 6px;
    background: touch.has-hover ? Palette.alternate-background : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.offer.name;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.offer.author + (root.offer.downloads != "" ? " · " + root.offer.downloads : "");
                    font-size: 11px;
                    color: Look.muted;
                    overflow: elide;
                }
            }
        }
        // Two lines at most.
        Text {
            text: root.offer.summary;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            max-height: 34px;
        }
        if root.offer.warning != "": Text {
            text: "⚠ " + root.offer.warning;
            font-size: 11px;
            wrap: word-wrap;
            color: Look.amber;
        }
        VerticalLayout {
            spacing: 3px;
            for badge in root.offer.badges: HorizontalLayout {
                Badge {
                    text: badge.text;
                    kind: badge.kind;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.offer.version + (root.offer.date != "" ? " · " + root.offer.date : "");
                font-size: 12px;
                color: Look.muted;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            // Installed, with a newer version or not (its panel has Update).
            if root.offer.action >= 3: Text {
                text: "Installed";
                font-size: 12px;
                color: Look.green;
                vertical-alignment: center;
            }
            if root.offer.action == 2: Installing {}
            if root.offer.action == 0: Button {
                text: "Install";
                enabled: !root.busy;
                clicked => { root.install(); }
            }
            // It asks first: the panel says why, with Install anyway.
            if root.offer.action == 1: Button {
                text: "Install…";
                enabled: !root.busy;
                clicked => { root.open(); }
            }
        }
    }
}

// A line of Browse's Legend: a badge, and what it means. The badge column fits the longest
// badge, "SurvivorsForge · no longer listed".
component LegendLine inherits HorizontalLayout {
    in property <string> badge;
    in property <int> kind;
    in property <string> text;
    spacing: 8px;
    VerticalLayout {
        alignment: start;
        width: 214px;
        HorizontalLayout {
            Badge {
                text: root.badge;
                kind: root.kind;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Text {
        text: root.text;
        font-size: 11px;
        wrap: word-wrap;
        horizontal-stretch: 1;
        color: Look.muted;
    }
}

// A label over a value, for what a lookup found.
// Text that does something when clicked.
// A heading in Settings' one scroll: General, Sync, Addons, Game, About.
component GroupHeading inherits VerticalLayout {
    in property <string> text;
    padding-top: 6px;
    spacing: 4px;
    Text {
        text: root.text;
        font-size: 15px;
        font-weight: 700;
    }
    Rectangle {
        height: 1px;
        background: Palette.border;
    }
}

// One group of Settings' scroll, its heading and fields together; the groups alternate their
// background, so each is easy to find.
component Section inherits Rectangle {
    in property <bool> alternate;
    border-radius: 6px;
    background: root.alternate ? Palette.alternate-background : Palette.background;
    VerticalLayout {
        padding: 10px;
        padding-top: 4px;
        spacing: 8px;
        @children
    }
}

component LinkText inherits Rectangle {
    in property <string> text;
    in property <color> ink: Look.muted;
    in property <length> font-size: 11px;
    callback clicked();
    HorizontalLayout {
        Text {
            text: root.text;
            font-size: root.font-size;
            color: touch.has-hover ? Palette.foreground : root.ink;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One of Browse's three views in its switch, as a small glyph (0 list, 1 cards, 2 table); marked
// when it is the view shown.
component ViewButton inherits Rectangle {
    in property <int> glyph;
    in property <bool> active;
    in property <string> label;
    callback clicked();
    property <color> ink: root.active ? Palette.accent-foreground : touch.has-hover ? Palette.foreground : Look.muted;
    width: 28px;
    height: 26px;
    border-radius: 5px;
    border-width: root.active ? 0 : 1px;
    border-color: Palette.border;
    background: root.active ? Palette.accent-background : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;

    // List: three lines.
    if root.glyph == 0: Rectangle {
        x: 7px;
        y: 7px;
        width: 14px;
        height: 12px;
        Rectangle { x: 0; y: 0; width: 14px; height: 2px; background: root.ink; }
        Rectangle { x: 0; y: 5px; width: 14px; height: 2px; background: root.ink; }
        Rectangle { x: 0; y: 10px; width: 14px; height: 2px; background: root.ink; }
    }
    // Cards: four of them.
    if root.glyph == 1: Rectangle {
        x: 7px;
        y: 7px;
        width: 14px;
        height: 12px;
        Rectangle { x: 0; y: 0; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 8px; y: 0; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 0; y: 7px; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 8px; y: 7px; width: 6px; height: 5px; border-radius: 1px; background: root.ink; }
    }
    // Table: a frame with its header and a column.
    if root.glyph == 2: Rectangle {
        x: 7px;
        y: 7px;
        width: 14px;
        height: 12px;
        border-width: 1.5px;
        border-color: root.ink;
        border-radius: 1px;
        Rectangle { x: 0; y: 3.5px; width: 14px; height: 1.5px; background: root.ink; }
        Rectangle { x: 5px; y: 3.5px; width: 1.5px; height: 8.5px; background: root.ink; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An addon's pictures as a row of thumbnails: as many 88 × 55 px frames as fit the width it has
// (`room`; four at the narrowest pane, five from about 490 px), the last one carrying "+N" over it
// when more pictures exist. Their thumbnails come from the app, asked for as soon as the row shows
// (`frames` says how many frames it shows); until one is here, or when it couldn't be decoded, its
// frame holds a small landscape. A click on a frame opens the viewer on that picture.
component PicturesRow inherits HorizontalLayout {
    in property <[PictureRow]> pictures;
    in property <length> room: 400px;
    callback open(int);
    callback frames(int);
    // Frames of 88 px and their 6 px gaps.
    property <int> fit: max(1, floor((root.room + 6px) / 94px));
    property <int> shown: min(root.fit, root.pictures.length);
    property <int> more: root.pictures.length - root.shown;
    init => { root.frames(root.shown); }
    changed shown => { root.frames(root.shown); }
    spacing: 6px;
    alignment: start;
    for i in root.shown: Rectangle {
        width: 88px;
        height: 55px;
        background: Palette.alternate-background;
        accessible-role: button;
        accessible-label: "Picture " + (i + 1) + (root.pictures[i].caption != "" ? ": " + root.pictures[i].caption : "")
            + (i == root.shown - 1 && root.more > 0 ? ", and " + root.more + " more" : "");
        // Until its thumbnail is here: a sun and a hill.
        if root.pictures[i].thumb.width == 0: Rectangle {
            Rectangle {
                x: parent.width / 2 + 6px;
                y: 13px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Look.muted;
            }
            Path {
                x: parent.width / 2 - 14px;
                y: 22px;
                width: 28px;
                height: 20px;
                viewbox-width: 20;
                viewbox-height: 14;
                commands: "M 0 14 L 6 5 L 10 10 L 13 7 L 20 14 Z";
                fill: Look.muted;
            }
        }
        if root.pictures[i].thumb.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.pictures[i].thumb;
            image-fit: cover;
        }
        // The last frame, when more pictures exist: how many more, over it.
        if i == root.shown - 1 && root.more > 0: Rectangle {
            background: #0b0e13a8;
            Text {
                text: "+" + root.more;
                font-size: 15px;
                font-weight: 700;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        // The frame's edge, over the picture.
        Rectangle {
            border-width: 1px;
            border-radius: 3px;
            border-color: frame-touch.has-hover ? Palette.accent-background : Palette.border;
        }
        frame-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(i); }
        }
    }
}

// The opened addon's button, as its card says until the app's answer: Install, Install anyway,
// Installing…, Installed, Update, Update anyway.
component OfferAction inherits HorizontalLayout {
    in property <int> action;
    in property <bool> busy;
    callback install();
    callback install-anyway();
    callback update();
    callback update-anyway();
    spacing: 8px;
    if root.action == 3: Text {
        text: "Installed";
        font-size: 12px;
        color: Look.green;
        vertical-alignment: center;
    }
    if root.action == 2: Installing {}
    if root.action == 0: Button {
        text: "Install";
        primary: true;
        enabled: !root.busy;
        clicked => { root.install(); }
    }
    if root.action == 1: Button {
        text: "Install anyway";
        enabled: !root.busy;
        clicked => { root.install-anyway(); }
    }
    if root.action == 4: Button {
        text: "Update";
        primary: true;
        enabled: !root.busy;
        clicked => { root.update(); }
    }
    if root.action == 5: Button {
        text: "Update anyway";
        enabled: !root.busy;
        clicked => { root.update-anyway(); }
    }
}

// What an addon's details say about it: About (shown at once, its longer text behind "more"),
// What's new, and its downloads per version.
component AboutBlock inherits VerticalLayout {
    in property <PanelRow> panel;
    // The app's content for this addon has come.
    in property <bool> ready;
    in property <string> about;
    in property <bool> more-open;
    in property <bool> notes: true;
    in property <bool> bars: true;
    // About and its "more"; without, What's new and the downloads only.
    in property <bool> about-part: true;
    callback toggle-more();
    spacing: 8px;
    if root.about-part && root.about != "": Text {
        text: "About";
        font-weight: 600;
    }
    if root.about-part && root.about != "": Text {
        text: root.about;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.about-part && root.ready && root.panel.about-more != "" && root.more-open: Text {
        text: root.panel.about-more;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.about-part && root.ready && root.panel.about-more != "": HorizontalLayout {
        LinkText {
            text: root.more-open ? "less" : "more";
            ink: Look.blue;
            font-size: 12px;
            clicked => { root.toggle-more(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.ready && root.notes && root.panel.notes != "": Text {
        text: root.panel.notes-title;
        font-weight: 600;
    }
    if root.ready && root.notes && root.panel.notes != "": Text {
        text: root.panel.notes;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.ready && root.bars && root.panel.bars.length > 0: VerticalLayout {
        spacing: 4px;
        Text {
            text: "Downloads per version";
            font-weight: 600;
        }
        for bar in root.panel.bars: HorizontalLayout {
            spacing: 8px;
            Text {
                text: bar.label;
                width: 110px;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Rectangle {
                    height: 10px;
                    border-radius: 3px;
                    background: Palette.alternate-background;
                    Rectangle {
                        x: 0;
                        width: parent.width * bar.share;
                        height: parent.height;
                        border-radius: 3px;
                        background: Look.blue;
                    }
                }
            }
            Text {
                text: bar.count;
                width: 64px;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// SurvivorsForge's scan of the version shown, and what it found when asked.
component ScanBlock inherits VerticalLayout {
    in property <PanelRow> panel;
    callback show-scan();
    spacing: 4px;
    Text {
        text: "Scan";
        font-weight: 600;
    }
    Text {
        text: root.panel.scan;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.panel.scan-more: HorizontalLayout {
        LinkText {
            text: "Show what it found";
            ink: Look.blue;
            font-size: 12px;
            clicked => { root.show-scan(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    for finding in root.panel.findings: Text {
        text: "• " + finding;
        font-size: 11px;
        wrap: word-wrap;
    }
}

// One version in Versions…, with its one button.
component VersionLineItem inherits Rectangle {
    in property <VersionItem> item;
    in property <bool> busy;
    callback install(bool);
    callback back();
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.version;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.item.badge != "": VerticalLayout {
                    alignment: center;
                    Badge {
                        text: root.item.badge;
                        kind: root.item.badge-kind;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.item.marks != "": Text {
                text: root.item.marks;
                font-size: 11px;
                wrap: word-wrap;
                color: Look.green;
            }
            if root.item.detail != "": Text {
                text: root.item.detail;
                font-size: 11px;
                wrap: word-wrap;
                color: Look.muted;
            }
            if root.item.reason != "": Text {
                text: root.item.reason;
                font-size: 11px;
                wrap: word-wrap;
                color: root.item.reason-kind == 2 ? Look.red : Look.amber;
            }
        }
        VerticalLayout {
            alignment: center;
            if root.item.action == 1: Button {
                text: "Go back to this";
                enabled: !root.busy;
                clicked => { root.back(); }
            }
            if root.item.action == 2: Button {
                text: "Install this version";
                enabled: !root.busy;
                clicked => { root.install(false); }
            }
            if root.item.action == 3: Button {
                text: "Install anyway";
                enabled: !root.busy;
                clicked => { root.install(true); }
            }
            if root.item.action == 4: Installing {}
        }
    }
}

// Versions… of one addon, newest first: the one installed, the ones kept for going back, every
// release and SurvivorsForge version known; one button each. It scrolls on its own.
component VersionsList inherits VerticalLayout {
    in property <VersionsRow> versions;
    // The app's list is for the addon asked for.
    in property <bool> ready;
    in property <bool> busy;
    callback install(string, bool);
    callback back(string);
    spacing: 6px;
    if !root.ready || root.versions.loading: Installing {
        text: "Loading…";
    }
    if root.ready && !root.versions.loading && root.versions.rows.length == 0: Text {
        text: "No versions of it are known here yet.";
        font-size: 12px;
        color: Look.muted;
    }
    versions-scroll := ScrollView {
        vertical-stretch: 1;
        content-height: versions-list.preferred-height;
        versions-list := VerticalLayout {
            width: versions-scroll.visible-width;
            height: self.preferred-height;
            alignment: start;
            spacing: 6px;
            if root.ready: VerticalLayout {
                spacing: 6px;
                for item in root.versions.rows: VersionLineItem {
                    item: item;
                    busy: root.busy;
                    install(anyway) => { root.install(item.key, anyway); }
                    back => { root.back(item.key); }
                }
            }
        }
    }
}

// One addon in Browse's list view, the whole width: the square, its name, author and badges, and
// under them one line with its summary, version and date. A click opens it in place (one row open
// at a time) with what its details say, its pictures, the scan in one line, Versions…, its GitHub
// page and its button.
component OfferListItem inherits Rectangle {
    in property <OfferRow> offer;
    in property <bool> open;
    in property <bool> busy;
    // The opened addon's content, once the app sent it for this row (`ready`).
    in property <PanelRow> panel;
    in property <bool> ready;
    in property <bool> more-open;
    callback toggle();
    callback toggle-more();
    callback picture(int);
    // Its pictures row shows this many frames.
    callback frames(int);
    callback versions();
    callback page();
    callback install();
    callback install-anyway();
    callback update();
    callback update-anyway();
    property <int> action: root.ready ? root.panel.action : root.offer.action;
    property <string> reason: root.ready ? root.panel.reason : root.offer.reason;
    property <string> about: root.ready && root.panel.about != "" ? root.panel.about : root.offer.summary;
    border-width: 1px;
    border-color: root.open ? Palette.accent-background : Palette.border;
    border-radius: 6px;
    background: touch.has-hover && !root.open ? Palette.alternate-background : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.offer.name;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.offer.author;
                        font-size: 11px;
                        color: Look.muted;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    for badge in root.offer.badges: VerticalLayout {
                        alignment: center;
                        Badge {
                            text: badge.text;
                            kind: badge.kind;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: (root.offer.summary != "" ? root.offer.summary + " · " : "") + root.offer.version + (root.offer.date != "" ? " · " + root.offer.date : "");
                    font-size: 12px;
                    color: Look.muted;
                    overflow: elide;
                }
            }
            // Installed, with a newer version or not (the row opened has Update).
            if !root.open && root.action >= 3: VerticalLayout {
                alignment: center;
                Text {
                    text: "Installed";
                    font-size: 12px;
                    color: Look.green;
                }
            }
            if !root.open && root.action == 2: VerticalLayout {
                alignment: center;
                Installing {}
            }
        }
        if root.open: VerticalLayout {
            spacing: 8px;
            if !root.ready || root.panel.loading: Installing {
                text: "Loading…";
            }
            if root.ready && root.panel.error != "": Text {
                text: root.panel.error;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.amber;
            }
            if root.ready && root.panel.pictures.length > 0: PicturesRow {
                pictures: root.panel.pictures;
                room: root.width - 16px;
                open(i) => { root.picture(i); }
                frames(n) => { root.frames(n); }
            }
            AboutBlock {
                panel: root.panel;
                ready: root.ready;
                about: root.about;
                more-open: root.more-open;
                notes: false;
                bars: false;
                toggle-more => { root.toggle-more(); }
            }
            if root.ready && root.panel.scan != "": Text {
                text: "Scan: " + root.panel.scan;
                font-size: 12px;
                overflow: elide;
            }
            if root.offer.warning != "" && root.action < 3: Text {
                text: "⚠ " + root.offer.warning;
                font-size: 11px;
                wrap: word-wrap;
                color: Look.amber;
            }
            if (root.action == 1 || root.action == 5) && root.reason != "": Text {
                text: root.reason;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.amber;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Versions…";
                    clicked => { root.versions(); }
                }
                VerticalLayout {
                    alignment: center;
                    LinkText {
                        text: "GitHub page";
                        ink: Look.blue;
                        font-size: 12px;
                        clicked => { root.page(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                OfferAction {
                    action: root.action;
                    busy: root.busy;
                    install => { root.install(); }
                    install-anyway => { root.install-anyway(); }
                    update => { root.update(); }
                    update-anyway => { root.update-anyway(); }
                }
            }
        }
    }
}

// A column's heading in Browse's table; a sorting one says which way it sorts when it is the one
// sorted by (`mark`), and sorts by itself when clicked.
component TableHead inherits Rectangle {
    in property <string> text;
    in property <string> mark;
    in property <bool> sorts;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    callback clicked();
    height: 22px;
    HorizontalLayout {
        Text {
            text: root.text + (root.mark != "" ? " " + root.mark : "");
            font-size: 10px;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: root.align;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.mark != "" || (root.sorts && head-touch.has-hover) ? Palette.foreground : Look.muted;
        }
    }
    head-touch := TouchArea {
        enabled: root.sorts;
        mouse-cursor: root.sorts ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Browse's table's columns, as wide as its rows and its headings both take them.
global TableColumns {
    out property <length> safety: 96px;
    out property <length> version: 54px;
    out property <length> tags: 120px;
    out property <length> updated: 80px;
    out property <length> popularity: 64px;
    out property <length> install: 84px;
    out property <length> spacing: 6px;
}

// One addon in Browse's table: the square, its name (a check mark after it when it is installed)
// and author; who vouches for it; its version; its tags (`wide` only); Last updated; Popularity;
// and its Install column's button. A click on the row selects it; a click on the button does what
// it says, and selects the row only where the pane must say why it asks first (Install…, Update…).
component OfferTableRow inherits Rectangle {
    in property <OfferRow> offer;
    in property <bool> current;
    in property <bool> wide;
    in property <bool> busy;
    callback select();
    callback install();
    callback update();
    callback uninstall();
    height: 44px;
    border-radius: 4px;
    background: root.current ? Look.note-paper : row-touch.has-hover ? Palette.alternate-background : transparent;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    HorizontalLayout {
        padding-left: 4px;
        // Clear of the scroll bar, as the headings are.
        padding-right: 14px;
        spacing: TableColumns.spacing;
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 110px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: root.offer.name;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.offer.installed: VerticalLayout {
                        alignment: center;
                        CheckMark {}
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.offer.author;
                    font-size: 11px;
                    color: Look.muted;
                    overflow: elide;
                }
            }
        }
        SafetyText {
            width: TableColumns.safety;
            word: root.offer.safety;
            kind: root.offer.safety-kind;
            by: root.offer.safety-by;
        }
        Text {
            width: TableColumns.version;
            text: root.offer.version;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.wide: Text {
            width: TableColumns.tags;
            text: root.offer.tags;
            font-size: 11px;
            color: Look.muted;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            width: TableColumns.updated;
            text: root.offer.date;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            width: TableColumns.popularity;
            text: root.offer.popularity;
            font-size: 11px;
            horizontal-alignment: right;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            width: TableColumns.install;
            alignment: center;
            if root.offer.action == 2: Installing {
                small: true;
                text: root.offer.install-text;
            }
            // Installed, and the Installed tab's row isn't known: no Uninstall to offer.
            if root.offer.action == 3 && root.offer.installed-id == "": Text {
                text: "Installed";
                font-size: 11px;
                color: Look.green;
            }
            if root.offer.action != 2 && root.offer.install-text != "" && !(root.offer.action == 3 && root.offer.installed-id == ""): RowButton {
                text: root.offer.install-text;
                primary: root.offer.install-primary;
                enabled: !root.busy;
                clicked => {
                    if (root.offer.action == 0) {
                        root.install();
                    } else if (root.offer.action == 3) {
                        root.uninstall();
                    } else if (root.offer.action == 4) {
                        root.update();
                    } else {
                        // Install… and Update…: the pane says why it asks, with its button.
                        root.select();
                    }
                }
            }
        }
    }
}

// When the game isn't on this PC, or the Satchel can't find it: the way to it, in a column of the
// other tabs' width, centred.
component NoGame inherits Rectangle {
    callback find();
    callback choose();
    callback get-game();
    VerticalBox {
        width: min(680px, parent.width);
        height: parent.height;
        x: (parent.width - self.width) / 2;
        y: 0;
        alignment: center;
        Text {
            text: "Azeroth Survivors isn't here";
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "The Satchel can't find the game on this PC. If it's installed, let the Satchel look for it, or choose its folder. If it isn't, it comes from the game's website.";
            wrap: word-wrap;
            horizontal-alignment: center;
            color: Look.muted;
        }
        HorizontalBox {
            alignment: center;
            Button {
                text: "Find it";
                primary: true;
                clicked => { root.find(); }
            }
            Button {
                text: "Choose its folder";
                clicked => { root.choose(); }
            }
            Button {
                text: "Get the game";
                clicked => { root.get-game(); }
            }
        }
    }
}

// An addon removed on this PC, and the way back.
component RemovedItem inherits Rectangle {
    in property <RemovedRow> removed;
    in property <bool> busy;
    callback install();
    // SurvivorsForge asks first about the version it had: the player's OK.
    callback install-anyway();
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            Initials {
                text: root.removed.initials;
                kind: root.removed.badge-kind;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.removed.name;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Badge {
                        text: root.removed.badge;
                        kind: root.removed.badge-kind;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.removed.version + " · " + root.removed.when;
                font-size: 12px;
                wrap: word-wrap;
                color: Look.muted;
            }
            Text {
                text: root.removed.note != "" ? root.removed.note : root.removed.detail;
                font-size: 12px;
                wrap: word-wrap;
                color: root.removed.note != "" ? Look.amber : Look.muted;
            }
            // SurvivorsForge's word on that version: it waits for the player's OK, or never.
            if root.removed.reason != "": Text {
                text: root.removed.reason;
                font-size: 12px;
                wrap: word-wrap;
                color: root.removed.reason-kind == 2 ? Look.red : Look.amber;
            }
        }
        if root.removed.can-install && root.removed.reason-kind == 0: VerticalLayout {
            alignment: center;
            Button {
                text: "Install again";
                enabled: !root.busy;
                clicked => { root.install(); }
            }
        }
        if root.removed.can-install && root.removed.reason-kind == 1: VerticalLayout {
            alignment: center;
            Button {
                text: "Install anyway";
                enabled: !root.busy;
                clicked => { root.install-anyway(); }
            }
        }
    }
}

// A version's blocks, one under the other: What's new's and the game's patch notes'.
component BlockLines inherits VerticalLayout {
    in property <[ChangelogBlock]> blocks;
    spacing: 4px;
    for block in root.blocks: HorizontalLayout {
        padding-left: block.kind == 3 ? 30px : block.kind == 2 ? 12px : 0px;
        padding-top: block.kind == 1 ? 6px : 0px;
        spacing: 6px;
        if block.kind == 2 || block.kind == 3: Text {
            text: block.kind == 3 ? "–" : "•";
            color: Look.muted;
        }
        Text {
            text: block.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
            font-weight: block.kind == 1 ? 600 : 400;
            color: block.kind == 4 ? Look.muted : Palette.foreground;
        }
    }
}

// One version in What's new; a click opens what changed in it.
component ChangelogItem inherits Rectangle {
    in property <ChangelogEntry> entry;
    in property <bool> current;
    in property <bool> open;
    callback toggle();
    border-width: 1px;
    border-color: root.open ? Palette.accent-background : Palette.border;
    border-radius: 6px;

    TouchArea {
        clicked => { root.toggle(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: (root.open ? "▾ " : "▸ ") + root.entry.version;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.current: VerticalLayout {
                alignment: center;
                Badge {
                    text: "This version";
                    kind: 0;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.entry.date;
                font-size: 12px;
                color: Look.muted;
                vertical-alignment: center;
            }
        }
        if root.open: BlockLines {
            blocks: root.entry.blocks;
        }
    }
}

// One version of the game's patch notes, open as it is: the version and its date (when one is
// known), the newest build marked, then its paragraph and lines.
component GameNoteItem inherits Rectangle {
    in property <ChangelogEntry> entry;
    in property <bool> current;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.entry.version;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.current: VerticalLayout {
                alignment: center;
                Badge {
                    text: "Newest build";
                    kind: 0;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.entry.date;
                font-size: 12px;
                color: Look.muted;
                vertical-alignment: center;
            }
        }
        if root.entry.blocks.length > 0: BlockLines {
            blocks: root.entry.blocks;
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 1px;
    Text {
        text: root.label;
        font-size: 11px;
        color: Look.muted;
    }
    Text {
        text: root.value;
        wrap: word-wrap;
    }
}

// The table's selected addon, beside the table: its name and badges, the tabs About and Versions,
// its button at the foot; ✕ closes it. About: its pictures row, what it does (its longer text
// behind "more"), one Safety line (SurvivorsForge's scan of the version shown, with what it found
// when asked; for an addon on our list it doesn't scan, the game's verified-addons channel), one
// Folders line, then What's new and its downloads per version.
component TablePane inherits Rectangle {
    in property <OfferRow> offer;
    in property <PanelRow> panel;
    // The app's content for this addon has come.
    in property <bool> ready;
    in-out property <int> tab;
    in property <bool> more-open;
    in property <bool> busy;
    in property <VersionsRow> versions;
    in property <bool> versions-ready;
    // The day the built-in list was last compared with the game's verified-addons channel.
    in property <string> discord-checked;
    callback close();
    callback tab-picked(int);
    callback toggle-more();
    callback show-scan();
    callback picture(int);
    // Its pictures row shows this many frames.
    callback frames(int);
    callback page();
    callback install();
    callback install-anyway();
    callback update();
    callback update-anyway();
    callback version-install(string, bool);
    callback version-back(string);
    property <int> action: root.ready ? root.panel.action : root.offer.action;
    property <string> reason: root.ready ? root.panel.reason : root.offer.reason;
    property <string> about: root.ready && root.panel.about != "" ? root.panel.about : root.offer.summary;
    function pick(tab: int) {
        root.tab = tab;
        root.tab-picked(tab);
    }
    // Opened on the tab left open before (Versions, say): what it shows is asked for.
    init => { root.tab-picked(root.tab); }
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Initials {
                    text: root.offer.initials;
                    kind: root.offer.initials-kind;
                    icon: root.offer.icon;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.offer.name;
                    font-size: 15px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.offer.author + (root.ready && root.panel.verified-author ? " · verified author" : "")
                        + (root.offer.downloads != "" ? " · " + root.offer.downloads : "");
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }
            }
            VerticalLayout {
                alignment: start;
                Button {
                    text: "✕";
                    clicked => { root.close(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            for badge in root.offer.badges: VerticalLayout {
                alignment: center;
                Badge {
                    text: badge.text;
                    kind: badge.kind;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 4px;
            Chip {
                text: "About";
                active: root.tab == 0;
                clicked => { root.pick(0); }
            }
            Chip {
                text: "Versions";
                active: root.tab == 1;
                clicked => { root.pick(1); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.tab == 0: pane-scroll := ScrollView {
            vertical-stretch: 1;
            content-height: pane-list.preferred-height;
            pane-list := VerticalLayout {
                width: pane-scroll.visible-width;
                height: self.preferred-height;
                alignment: start;
                spacing: 8px;
                // Details and versions on their way.
                if !root.ready || root.panel.loading: Installing {
                    text: "Loading…";
                }
                if root.ready && root.panel.error != "": Text {
                    text: root.panel.error;
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.amber;
                }
                if root.ready && root.panel.pictures.length > 0: PicturesRow {
                    pictures: root.panel.pictures;
                    room: pane-scroll.visible-width;
                    open(i) => { root.picture(i); }
                    frames(n) => { root.frames(n); }
                }
                AboutBlock {
                    panel: root.panel;
                    ready: root.ready;
                    about: root.about;
                    more-open: root.more-open;
                    notes: false;
                    bars: false;
                    toggle-more => { root.toggle-more(); }
                }
                if root.ready && root.panel.scan != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Safety: " + root.panel.scan;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.panel.scan-more: HorizontalLayout {
                        LinkText {
                            text: "Show what it found";
                            ink: Look.blue;
                            font-size: 12px;
                            clicked => { root.show-scan(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    for finding in root.panel.findings: Text {
                        text: "• " + finding;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                if root.ready && root.panel.scan == "" && root.offer.ours: Text {
                    text: "Safety: Discord Verified · on the game's verified-addons channel"
                        + (root.discord-checked != "" ? ", checked on " + root.discord-checked : "");
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.ready: Text {
                    text: root.panel.folders != "" ? root.panel.folders : "Its folders show once it is installed.";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.offer.warning != "" && root.action < 3: Text {
                    text: "⚠ " + root.offer.warning;
                    font-size: 11px;
                    wrap: word-wrap;
                    color: Look.amber;
                }
                AboutBlock {
                    panel: root.panel;
                    ready: root.ready;
                    about-part: false;
                }
            }
        }
        if root.tab == 1: VersionsList {
            vertical-stretch: 1;
            versions: root.versions;
            ready: root.versions-ready;
            busy: root.busy;
            install(tag, anyway) => { root.version-install(tag, anyway); }
            back(backup) => { root.version-back(backup); }
        }
        // The action stays in sight at the foot, the reason above it.
        if (root.action == 1 || root.action == 5) && root.reason != "": Text {
            text: root.reason;
            font-size: 12px;
            wrap: word-wrap;
            color: Look.amber;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.offer.version + (root.offer.date != "" ? " · " + root.offer.date : "");
                font-size: 12px;
                color: Look.muted;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: "View on GitHub";
                clicked => { root.page(); }
            }
            OfferAction {
                action: root.action;
                busy: root.busy;
                install => { root.install(); }
                install-anyway => { root.install-anyway(); }
                update => { root.update(); }
                update-anyway => { root.update-anyway(); }
            }
        }
    }
}

// Previous or next (`next`) on the viewer's picture: a round button on its edge, greyed at the
// ends. Greyed, a click on it still does nothing else: it never closes the viewer.
component RoundButton inherits Rectangle {
    in property <bool> next;
    in property <bool> enabled: true;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: !root.enabled ? #00000033 : touch.has-hover ? #000000c4 : #00000094;
    accessible-role: button;
    accessible-label: root.next ? "Next picture" : "Previous picture";
    Path {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.next ? "M 7.5 4 L 13.5 10 L 7.5 16" : "M 12.5 4 L 6.5 10 L 12.5 16";
        stroke: root.enabled ? #ffffff : #ffffff59;
        stroke-width: 2.5px;
        fill: transparent;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component MainWindow inherits Window {
    // The Play tab.
    in property <TrayState> state;
    in property <string> banner;
    in property <bool> busy;
    in property <bool> sync-on;
    in property <string> here-title;
    in property <string> here-main;
    in property <string> here-detail;
    in property <string> other-title;
    in property <string> other-main;
    in property <string> other-detail;
    in property <[RecentLine]> recent;
    callback play();
    callback sync-now();
    callback open-folder();

    // The Addons tab: 0 Installed, 1 Browse, 2 Add, 3 Removed.
    in-out property <int> addons-page: 0;
    in property <[AddonRow]> addon-rows;
    in property <int> addons-count;
    in property <string> addons-header;
    in property <string> addons-share;
    in property <bool> can-update-all;
    in property <string> addons-footer;
    in property <string> addons-notice;
    in property <string> addons-message;
    in-out property <string> addon-open;
    callback addon-switch(string, bool);
    callback addon-update(string);
    // SurvivorsForge asks first about this update, and the player OKs it.
    callback addon-update-anyway(string);
    callback addon-back(string);
    callback addon-keep(string, bool);
    callback addon-remove(string, bool);
    callback addon-page(string);
    callback addon-folder(string);
    callback addon-local-only(string, bool);
    callback addon-settings-per-pc(string, bool);
    callback addon-settings-choice(string, bool);
    callback addons-check();
    callback addons-update-all();
    callback addons-open-folder();
    // Browse: the ones shown are filtered on the UI thread (`browse-filter`) by the search, the list
    // (`browse-origin`: 0 all, 1 Discord Verified, 2 SurvivorsForge) and the tags that are on (none
    // on: all), and sorted by `browse-sort` (0 name, 1 last updated, 2 popularity, the one it
    // starts with: the most downloads first).
    in property <[OfferRow]> offer-rows;
    in property <string> browse-note;
    in-out property <string> browse-search;
    in-out property <int> browse-origin: 0;
    in-out property <int> browse-sort: 2;
    // The tag chips, line by line (made for the narrowest window; Slint has no wrapping layout);
    // a click turns one on or off where it is.
    in-out property <[[TagRow]]> browse-tags;
    in property <int> browse-tags-on;
    // Every tag, for the Legend: "Combat · Cursors · …".
    in property <string> browse-tag-line;
    // The list choice's counts, from every line.
    in property <int> browse-count-all;
    in property <int> browse-count-ours;
    in property <int> browse-count-forge;
    in-out property <bool> browse-filters-open: false;
    property <int> browse-filters-active: root.browse-tags-on + (root.browse-origin != 0 ? 1 : 0) + (root.browse-view == "table" ? root.browse-trust-on : 0);
    // The grid: two columns, three from about 900 px; rows of cards.
    property <int> browse-cols: root.width >= 900px ? 3 : 2;
    property <int> browse-card-rows: floor((root.offer-rows.length + root.browse-cols - 1) / root.browse-cols);
    // The panel: the offer whose panel is open ("" none), its card (kept current by the app), and
    // what the app sends for it; it shows only while `panel.id` is the open one.
    in-out property <string> browse-panel-id;
    in-out property <OfferRow> panel-offer;
    in property <PanelRow> panel;
    property <bool> panel-ready: root.panel.id == root.browse-panel-id && root.browse-panel-id != "";
    property <bool> panel-about-open;
    // The Legend, pinned open by a click.
    in-out property <bool> legend-pinned;
    // SurvivorsForge: Browse's status line ("" nothing to say), Settings' line under its switch,
    // and whether it hasn't answered for an hour (both lines amber).
    in property <string> forge-status;
    in property <string> forge-answer;
    in property <bool> forge-offline;
    // The day the built-in list was last compared with the game's verified-addons channel.
    in property <string> discord-checked;
    // SurvivorsForge's repository and website: the credit's links in Settings and About.
    in property <string> forge-repo-url;
    in property <string> forge-site-url;
    callback browse-install(string);
    callback browse-filter();
    callback browse-open(string);
    callback browse-close();
    callback browse-install-anyway(string);
    callback forge-show-scan(string);
    // Browse's three views, one shown at a time (`browse-view`: list, cards, table, the default),
    // as kept in settings.toml; the switch tells the app.
    in-out property <string> browse-view: "table";
    callback browse-view-changed(string);
    function pick-view(view: string) {
        root.browse-view = view;
        root.browse-view-changed(view);
        // The table picked: its top row opens when nothing is.
        root.table-fresh = view == "table";
        root.browse-filter();
    }
    // An addon opened in Browse, as a click on it opens it: its panel, row or pane, and the app
    // asked for what it shows. The app opens the table's top row with it too.
    public function open-offer(offer: OfferRow) {
        root.panel-about-open = false;
        root.panel-offer = offer;
        root.browse-panel-id = offer.id;
        root.browse-open(offer.id);
        if (root.browse-view == "table" && root.table-tab == 1) {
            root.versions-id = offer.id;
            root.versions-open(offer.id);
        }
    }
    // Browse entered, or the table picked, since the last filter: the app opens the table's top
    // row when no addon is open (`browse-filter`).
    in-out property <bool> table-fresh;
    // The open addon's pictures row shows this many frames: the app asks for their thumbnails.
    callback thumbs-shown(string, int);
    // A table column's heading clicked: sorted by it, or the other way round when it already is.
    function sort-table(column: int) {
        if (root.browse-sort == column) {
            root.browse-sort-reverse = !root.browse-sort-reverse;
        } else {
            root.browse-sort = column;
            root.browse-sort-reverse = false;
        }
        root.browse-filter();
    }
    // The table: its column's direction (the other way round from each sort's own when set), its
    // own filters (the trust words on, any of them; installed only) and the tags as check boxes;
    // the selected addon beside it, at every size the window takes.
    in-out property <bool> browse-sort-reverse;
    in-out property <[TagRow]> browse-trust;
    in property <int> browse-trust-on;
    in-out property <bool> browse-installed-only;
    in-out property <[[TagRow]]> browse-tag-checks;
    callback browse-tag-toggled(string);
    callback browse-trust-toggled(string);
    // The selected addon's tab: 0 About, 1 Versions.
    in-out property <int> table-tab: 0;
    // The Addons tab, or its Installed or Browse page, came into view (-1: left): their icons.
    // Browse entered: the table's top row opens when no addon is open.
    callback addons-shown(int);
    function addons-view-changed() {
        root.addons-shown(root.tab == 1 ? root.addons-page : -1);
        if (root.tab == 1 && root.addons-page == 1) {
            root.table-fresh = true;
            root.browse-filter();
        }
    }
    changed tab => { root.addons-view-changed(); }
    changed addons-page => { root.addons-view-changed(); }
    // The picture viewer, over the window: the open addon's screenshot `viewer-index`, its pixels
    // from the app (`viewer-state` 0 loading, 1 shown, 2 not available). Only the one shown is held.
    in-out property <bool> viewer-open;
    in-out property <int> viewer-index;
    in-out property <image> viewer-image;
    in-out property <int> viewer-state;
    callback picture-show(string, int);
    callback picture-close();
    // Versions…: the addon it is asked for (`versions-id`), and what the app sends for it; over the
    // window when `versions-overlay`, else in the table's Versions tab.
    in property <VersionsRow> versions;
    in-out property <string> versions-id;
    in-out property <bool> versions-overlay;
    callback versions-open(string);
    callback versions-close();
    callback version-install(string, string, bool);
    callback version-back(string, string);
    function open-versions(id: string) {
        root.versions-id = id;
        root.versions-overlay = true;
        root.versions-open(id);
    }
    function close-versions() {
        root.versions-overlay = false;
        root.versions-id = "";
        root.versions-close();
    }
    // An incoming addon's, and a removed one's, Install anyway: the player's OK.
    callback incoming-install-anyway(string);
    callback install-again-anyway(string);
    // A SurvivorsForge link; the app opens only its repository and website, and GitHub
    // repositories.
    callback open-link(string);
    // Add: 0 nothing yet, 1 looking, 2 found, 3 failed.
    in-out property <string> link-text;
    in property <int> link-state;
    in property <string> link-message;
    in property <string> link-owner;
    in property <string> link-release;
    in property <string> link-goes;
    in property <string> link-note;
    in property <bool> link-warn;
    in property <bool> link-installing;
    callback link-lookup(string);
    callback link-install();
    callback link-clear();
    callback import-zip();
    // "Remove…" asks first.
    in-out property <string> remove-id;
    in-out property <string> remove-name;
    in-out property <bool> remove-settings;

    // The Saves tab.
    in property <[[StandardListViewItem]]> save-rows;
    in property <string> saves-note;
    in-out property <int> save-row: -1;
    callback show-in-folder(int);
    callback bring-back(int);

    // The Playtime tab.
    in property <string> today;
    in property <string> week;
    in property <string> all-time;
    in property <[PcTime]> pc-times;
    in property <[string]> sessions;

    // The Settings tab (and the first start, which shows the same fields).
    in-out property <string> game-dir;
    in property <string> game-status;
    in-out property <bool> sync-switch;
    in-out property <string> sync-folder;
    in property <string> folder-status;
    in-out property <string> pc-name;
    // Why the name typed wasn't saved (another PC syncing there has it); empty otherwise.
    in-out property <string> name-status;
    in-out property <bool> start-with-windows;
    in-out property <bool> desktop-shortcut;
    in-out property <bool> notifications;
    in-out property <bool> addons-auto;
    in-out property <bool> addons-shared;
    in-out property <bool> addons-forge;
    in-out property <bool> pause-when-away;
    in property <string> settings-path;
    callback detect-game();
    callback save-settings();
    callback default-settings();
    // 0 System, 1 Light, 2 Dark.
    in-out property <int> theme;
    in-out property <bool> game-shared;
    // Where the game's own settings stand with the other PCs; `game-line-kind` 0 plain, 1 news,
    // 2 needs a look. `game-ask-pc`: they changed here and there, the player picks.
    in property <string> game-line;
    in property <int> game-line-kind;
    in property <string> game-ask-pc;
    callback game-settings-choice(bool);
    // This PC's own game settings from before it joined, kept on the NAS ("Use them instead"),
    // and the last answer about the game's settings.
    in property <string> game-own;
    in property <string> game-note;
    callback game-settings-own();
    // A newer Satchel: the Play tab's line, the version Update now puts in place (empty: none
    // downloaded yet), and whether nothing syncs until then.
    in property <string> update-text;
    in property <string> update-version;
    in property <bool> update-gated;
    callback update-now();
    // About's Check for updates, and what it found (empty before a check). `checking`: from the
    // click until the answer, "Checking…" stands where the button was.
    callback check-updates();
    in-out property <string> check-result;
    in property <bool> checking;
    in property <SettingsForm> saved-form;
    property <bool> settings-changed: root.game-dir != root.saved-form.game-dir || root.sync-switch != root.saved-form.sync
        || root.sync-folder != root.saved-form.folder || root.pc-name != root.saved-form.pc-name
        || root.start-with-windows != root.saved-form.start-with-windows || root.desktop-shortcut != root.saved-form.desktop-shortcut
        || root.notifications != root.saved-form.notifications || root.addons-auto != root.saved-form.addons-auto
        || root.addons-shared != root.saved-form.addons-shared || root.addons-forge != root.saved-form.addons-forge
        || root.pause-when-away != root.saved-form.pause-when-away
        || root.theme != root.saved-form.theme || root.game-shared != root.saved-form.game-shared;

    // About the Satchel itself, and What's new (every version's changes).
    in property <string> app-version;
    in property <string> app-released;
    in property <string> app-build;
    in property <string> repo-url;
    // Report a problem: the repository's bug report form with this version filled in (there
    // whenever `repo-url` is).
    in property <string> issue-url;
    in property <[ChangelogEntry]> changelog;
    // The Play tab's last line; `version-new`: it says "Updated to …".
    in property <string> version-line;
    in property <bool> version-new;
    in-out property <bool> whats-new-open;
    in-out property <string> changelog-open;
    callback whats-new-seen();
    callback open-url(string);
    function open-whats-new() {
        root.changelog-open = root.app-version;
        root.whats-new-open = true;
        root.whats-new-seen();
    }
    // The game's patch notes: the Play tab's line ("Azeroth Survivors 0.141.0 · what's new",
    // empty when no build is known here; `game-news-new`: not opened for that build yet), the
    // panel's versions, newest first, in What's new's shape, its last line when older ones are
    // left out, what it says with nothing cached, and About's two answer times.
    in property <string> game-news-line;
    in property <bool> game-news-new;
    in property <string> game-news-version;
    in property <[ChangelogEntry]> game-notes;
    in property <string> game-notes-footer;
    in property <string> game-notes-empty;
    in property <string> game-news-latest-answer;
    in property <string> game-news-notes-answer;
    in-out property <bool> game-news-open;
    callback game-news-seen();
    function open-game-news() {
        root.game-news-open = true;
        root.game-news-seen();
    }

    // The game isn't in its folder: Play, Addons, Saves and Playtime say so.
    in property <bool> game-found: true;
    callback find-game();
    callback open-game-site();

    // The Addons tab's Removed page.
    in property <[RemovedRow]> removed-rows;
    callback install-again(string);

    // Dark or light, as Settings' theme says.
    in property <bool> dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        Look.dark = root.dark;
    }

    // Play, Addons, Saves, Playtime, Settings.
    in-out property <int> tab: 0;

    // "Needs you": two PCs moved on separately.
    in property <bool> needs-you;
    in property <string> needs-here;
    in property <string> needs-other;
    in property <string> needs-other-pc;
    callback keep-here();
    callback use-other();
    callback decide-later();

    // First start.
    in property <bool> setup;
    in property <bool> setup-pick;
    in property <string> setup-here;
    in property <string> setup-other;
    in-out property <int> setup-choice: 0;
    callback finish-setup();

    title: "Survivor's Satchel";
    icon: @image-url("icons/satchel.svg");
    // 16:9, and never smaller than 960 × 540, so Browse's table and the addon beside it fit.
    preferred-width: 1120px;
    preferred-height: 630px;
    min-width: 960px;
    min-height: 540px;

    TabWidget {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        current-index <=> root.tab;

        Tab {
            title: "Play";
            VerticalBox {
                // The tab's own column, at its width from before the window grew, centred.
                width: min(680px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                Rectangle {
                    border-radius: 6px;
                    background: Look.banner(root.state);
                    HorizontalLayout {
                        padding: 10px;
                        Text {
                            text: root.banner;
                            wrap: word-wrap;
                            color: Look.ink;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.update-text != "": HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.update-text;
                        color: root.update-gated ? Look.amber : Look.blue;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if root.update-version != "": Button {
                        text: "Update now";
                        enabled: !root.busy;
                        clicked => { root.update-now(); }
                    }
                }
                HorizontalBox {
                    padding: 0;
                    Card {
                        heading: root.here-title;
                        main: root.here-main;
                        detail: root.here-detail;
                    }
                    Card {
                        heading: root.other-title;
                        main: root.other-main;
                        detail: root.other-detail;
                    }
                }
                HorizontalBox {
                    padding: 0;
                    alignment: start;
                    Button {
                        text: "Play Azeroth Survivors";
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.play(); }
                    }
                    if root.sync-on: Button {
                        text: "Sync now";
                        enabled: !root.busy;
                        clicked => { root.sync-now(); }
                    }
                    if root.sync-on: Button {
                        text: "Open the network folder";
                        clicked => { root.open-folder(); }
                    }
                }
                // The game's newest build, once its update server has named one; a click opens
                // the game's patch notes. Blue until they have been opened for that build.
                if root.game-news-line != "": HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: root.game-news-line;
                        ink: root.game-news-new ? Look.blue : Look.muted;
                        font-size: 12px;
                        clicked => { root.open-game-news(); }
                    }
                }
                Text {
                    text: "Recent on this PC";
                    font-weight: 600;
                }
                for line in root.recent: HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 14px;
                            height: 14px;
                            source: line.kind == 1 ? @image-url("icons/kind-addon.svg")
                                : line.kind == 2 ? @image-url("icons/kind-game.svg")
                                : line.kind == 3 ? @image-url("icons/kind-playtime.svg")
                                : line.kind == 4 ? @image-url("icons/kind-warning.svg")
                                : line.kind == 5 ? @image-url("icons/kind-satchel.svg")
                                : @image-url("icons/kind-sync.svg");
                            colorize: line.kind == 4 ? Look.amber : line.kind == 1 ? Look.blue : line.kind == 2 ? Look.gold : Look.muted;
                        }
                    }
                    Text {
                        text: line.text;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                // The Satchel's own version; a click opens What's new.
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    LinkText {
                        text: root.version-line;
                        ink: root.version-new ? Look.blue : Look.muted;
                        clicked => { root.open-whats-new(); }
                    }
                }
            }
            if !root.game-found: Overlay {
                NoGame {
                    find => { root.find-game(); }
                    choose => { root.tab = 4; }
                    get-game => { root.open-game-site(); }
                }
            }
        }

        Tab {
            title: "Addons";
            VerticalBox {
                HorizontalLayout {
                    spacing: 6px;
                    Chip {
                        text: "Installed · " + root.addons-count;
                        active: root.addons-page == 0;
                        clicked => { root.addons-page = 0; }
                    }
                    Chip {
                        text: "Browse";
                        active: root.addons-page == 1;
                        clicked => { root.addons-page = 1; }
                    }
                    Chip {
                        text: "Add";
                        active: root.addons-page == 2;
                        clicked => { root.addons-page = 2; }
                    }
                    Chip {
                        text: root.removed-rows.length > 0 ? "Removed · " + root.removed-rows.length : "Removed";
                        active: root.addons-page == 3;
                        clicked => { root.addons-page = 3; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.addons-message != "": Rectangle {
                    border-radius: 6px;
                    background: Look.note-paper;
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.addons-message;
                            wrap: word-wrap;
                            color: Look.ink;
                        }
                    }
                }
                if root.addons-notice != "": Text {
                    text: root.addons-notice;
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }

                if root.addons-page == 0: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.addons-header;
                            font-weight: 600;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            color: root.can-update-all ? Look.green : Palette.foreground;
                        }
                        if root.can-update-all: Button {
                            text: "Update all";
                            enabled: !root.busy;
                            clicked => { root.addons-update-all(); }
                        }
                    }
                    if root.addons-share != "": Text {
                        text: root.addons-share;
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Look.muted;
                    }
                    // The columns, in the table's style: the name takes what the others leave, and
                    // the status line a share of it.
                    installed-box := VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 2px;
                        property <length> fixed: InstalledColumns.safety + InstalledColumns.version + InstalledColumns.released + InstalledColumns.on
                            + 5 * InstalledColumns.spacing + 18px;
                        property <length> status-width: clamp((self.width - self.fixed) * 0.55, 150px, 460px);
                        // The headings over their columns, both clear of the scroll bar, which is
                        // drawn over the rows' right edge.
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 14px;
                            spacing: InstalledColumns.spacing;
                            TableHead {
                                horizontal-stretch: 1;
                                min-width: 140px;
                                text: "Name";
                            }
                            TableHead {
                                width: InstalledColumns.safety;
                                text: "Safety";
                            }
                            TableHead {
                                width: InstalledColumns.version;
                                text: "Version";
                            }
                            TableHead {
                                width: InstalledColumns.released;
                                text: "Released";
                            }
                            TableHead {
                                width: installed-box.status-width;
                                text: "Status";
                            }
                            TableHead {
                                width: InstalledColumns.on;
                                text: "On";
                                align: TextHorizontalAlignment.right;
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Palette.border;
                        }
                        // The viewport is as tall as the whole list, so the rows keep their height and scroll.
                        installed-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-height: installed-list.preferred-height;
                            installed-list := VerticalLayout {
                                width: installed-scroll.visible-width;
                                height: self.preferred-height;
                                alignment: start;
                                spacing: 1px;
                                for row in root.addon-rows: AddonTableRow {
                                    addon: row;
                                    open: root.addon-open == row.id;
                                    busy: root.busy;
                                    status-width: installed-box.status-width;
                                    toggle => { root.addon-open = root.addon-open == row.id ? "" : row.id; }
                                    switched(on) => { root.addon-switch(row.id, on); }
                                    update => { root.addon-update(row.id); }
                                    update-anyway => { root.addon-update-anyway(row.id); }
                                    replace => { root.browse-install(row.id); }
                                    back => { root.addon-back(row.id); }
                                    keep(on) => { root.addon-keep(row.id, on); }
                                    page => { root.addon-page(row.id); }
                                    folder => { root.addon-folder(row.id); }
                                    local-only(on) => { root.addon-local-only(row.id, on); }
                                    settings-per-pc(on) => { root.addon-settings-per-pc(row.id, on); }
                                    settings-choice(keep) => { root.addon-settings-choice(row.id, keep); }
                                    versions => { root.open-versions(row.id); }
                                    install-anyway => { root.incoming-install-anyway(row.id); }
                                    remove => {
                                        root.remove-settings = false;
                                        root.remove-name = row.name;
                                        root.remove-id = row.id;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.addons-footer;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            color: Look.muted;
                        }
                        Button {
                            text: "Check now";
                            clicked => { root.addons-check(); }
                        }
                        Button {
                            text: "Open AddOns folder";
                            clicked => { root.addons-open-folder(); }
                        }
                    }
                }

                // Browse in one of three views, each a subtree of its own bound to `browse-view`:
                // cards, a panel sliding in over them from the right; the list, its rows opening in
                // place; the table, the selected addon beside it (or in its place, narrower). The
                // Legend opens under its link. The panel and the Legend are placed over the page,
                // not in its layout.
                if root.addons-page == 1: Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    // Esc closes the addon opened (the panel, the row, the table's pane), else
                    // unpins the Legend; a key a field doesn't take comes up to here.
                    browse-keys := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Escape && root.browse-panel-id != "") {
                                root.browse-panel-id = "";
                                root.browse-close();
                                return accept;
                            }
                            if (event.text == Key.Escape && root.legend-pinned) {
                                root.legend-pinned = false;
                                return accept;
                            }
                            return reject;
                        }
                        VerticalLayout {
                            spacing: 8px;
                            top-row := HorizontalLayout {
                                spacing: 6px;
                                // Narrow enough, with the sort's width held, for the whole row at 540 px.
                                LineEdit {
                                    placeholder-text: "Search addons";
                                    text <=> root.browse-search;
                                    horizontal-stretch: 1;
                                    min-width: 110px;
                                    edited => { root.browse-filter(); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    Chip {
                                        text: (root.browse-filters-active > 0 ? "Filters · " + root.browse-filters-active : "Filters")
                                            + (root.browse-filters-open ? " ▴" : " ▾");
                                        active: root.browse-filters-open;
                                        clicked => { root.browse-filters-open = !root.browse-filters-open; }
                                    }
                                }
                                ComboBox {
                                    horizontal-stretch: 0;
                                    width: 136px;
                                    model: ["Name", "Last updated", "Popularity"];
                                    current-index <=> root.browse-sort;
                                    selected => {
                                        root.browse-sort-reverse = false;
                                        root.browse-filter();
                                    }
                                }
                                // The switch: list, cards, table.
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 2px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        ViewButton {
                                            glyph: 0;
                                            label: "List";
                                            active: root.browse-view == "list";
                                            clicked => { root.pick-view("list"); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ViewButton {
                                            glyph: 1;
                                            label: "Cards";
                                            active: root.browse-view != "list" && root.browse-view != "table";
                                            clicked => { root.pick-view("cards"); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ViewButton {
                                            glyph: 2;
                                            label: "Table";
                                            active: root.browse-view == "table";
                                            clicked => { root.pick-view("table"); }
                                        }
                                    }
                                }
                                // The row's whole height answers the mouse, so it can go down
                                // onto the Legend without the Legend closing.
                                Rectangle {
                                    horizontal-stretch: 0;
                                    legend-hover := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.legend-pinned = !root.legend-pinned; }
                                    }
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: "Legend";
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            color: legend-hover.has-hover || root.legend-pinned ? Palette.foreground : Look.blue;
                                        }
                                    }
                                }
                            }
                            if root.forge-status != "": Text {
                                text: root.forge-status;
                                font-size: 12px;
                                wrap: word-wrap;
                                color: root.forge-offline ? Look.amber : Look.muted;
                            }
                            // The lists as one choice, then the tags (any number on).
                            if root.browse-filters-open && root.browse-view != "table": VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Chip {
                                        text: "All · " + root.browse-count-all;
                                        active: root.browse-origin == 0;
                                        clicked => {
                                            root.browse-origin = 0;
                                            root.browse-filter();
                                        }
                                    }
                                    Chip {
                                        text: "Discord Verified · " + root.browse-count-ours;
                                        active: root.browse-origin == 1;
                                        clicked => {
                                            root.browse-origin = 1;
                                            root.browse-filter();
                                        }
                                    }
                                    // Off in Settings (as saved): greyed, and it can't be picked.
                                    Chip {
                                        text: root.saved-form.addons-forge ? "SurvivorsForge · " + root.browse-count-forge : "SurvivorsForge · off in Settings";
                                        enabled: root.saved-form.addons-forge;
                                        active: root.browse-origin == 2 && root.saved-form.addons-forge;
                                        clicked => {
                                            root.browse-origin = 2;
                                            root.browse-filter();
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                for line in root.browse-tags: HorizontalLayout {
                                    spacing: 4px;
                                    for tag in line: Chip {
                                        text: tag.text;
                                        active: tag.on;
                                        clicked => {
                                            tag.on = !tag.on;
                                            root.browse-filter();
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            // The table's filters, as check boxes: each list, each trust word, each
                            // tag, and installed only.
                            if root.browse-filters-open && root.browse-view == "table": VerticalLayout {
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Lists";
                                        width: 92px;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    CheckBox {
                                        text: "Discord Verified · " + root.browse-count-ours;
                                        checked: root.browse-origin == 0 || root.browse-origin == 1;
                                        toggled => {
                                            root.browse-origin = self.checked
                                                ? (root.browse-origin == 2 ? 0 : 1)
                                                : (root.browse-origin == 0 ? 2 : 3);
                                            root.browse-filter();
                                        }
                                    }
                                    CheckBox {
                                        text: "SurvivorsForge · " + root.browse-count-forge;
                                        enabled: root.saved-form.addons-forge;
                                        checked: root.saved-form.addons-forge && (root.browse-origin == 0 || root.browse-origin == 2);
                                        toggled => {
                                            root.browse-origin = self.checked
                                                ? (root.browse-origin == 1 ? 0 : 2)
                                                : (root.browse-origin == 0 ? 1 : 3);
                                            root.browse-filter();
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // SurvivorsForge's levels, as the Safety column shows them.
                                if root.browse-trust.length > 0: HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Safety";
                                        width: 92px;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    for level in root.browse-trust: CheckBox {
                                        text: level.text;
                                        checked: level.on;
                                        toggled => { root.browse-trust-toggled(level.text); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                for line[i] in root.browse-tag-checks: HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: i == 0 ? "Tags" : "";
                                        width: 92px;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    for tag in line: CheckBox {
                                        text: tag.text;
                                        checked: tag.on;
                                        toggled => { root.browse-tag-toggled(tag.text); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle { width: 92px; }
                                    CheckBox {
                                        text: "Installed only";
                                        checked <=> root.browse-installed-only;
                                        toggled => { root.browse-filter(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            // Cards: two columns, three from about 900 px; each row as tall as its
                            // tallest card.
                            if root.browse-view != "list" && root.browse-view != "table": offer-scroll := ScrollView {
                                vertical-stretch: 1;
                                content-height: offer-grid.preferred-height;
                                offer-grid := VerticalLayout {
                                    width: offer-scroll.visible-width;
                                    height: self.preferred-height;
                                    alignment: start;
                                    spacing: 8px;
                                    for r in root.browse-card-rows: HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        for c in min(root.browse-cols, root.offer-rows.length - r * root.browse-cols): OfferItem {
                                            width: (offer-scroll.visible-width - (root.browse-cols - 1) * 8px) / root.browse-cols;
                                            offer: root.offer-rows[r * root.browse-cols + c];
                                            current: root.browse-panel-id == self.offer.id;
                                            busy: root.busy;
                                            install => { root.browse-install(self.offer.id); }
                                            // The panel opens at its top; the app sends its content
                                            // (browse-open), and browse-filter shows what it has.
                                            open => {
                                                root.open-offer(self.offer);
                                                panel-scroll.content-y = 0;
                                                browse-keys.focus();
                                                root.browse-filter();
                                            }
                                        }
                                    }
                                }
                            }
                            // The list: one row per addon, the whole width; one open at a time.
                            if root.browse-view == "list": list-scroll := ScrollView {
                                vertical-stretch: 1;
                                content-height: list-rows.preferred-height;
                                list-rows := VerticalLayout {
                                    width: list-scroll.visible-width;
                                    height: self.preferred-height;
                                    alignment: start;
                                    spacing: 6px;
                                    for offer in root.offer-rows: OfferListItem {
                                        offer: offer;
                                        open: root.browse-panel-id == offer.id;
                                        busy: root.busy;
                                        panel: root.panel;
                                        ready: root.panel-ready && root.browse-panel-id == offer.id;
                                        more-open: root.panel-about-open;
                                        toggle => {
                                            if (root.browse-panel-id == offer.id) {
                                                root.browse-panel-id = "";
                                                root.browse-close();
                                            } else {
                                                root.open-offer(offer);
                                                browse-keys.focus();
                                                root.browse-filter();
                                            }
                                        }
                                        toggle-more => { root.panel-about-open = !root.panel-about-open; }
                                        picture(i) => { root.picture-show(offer.id, i); }
                                        frames(n) => { root.thumbs-shown(offer.id, n); }
                                        versions => { root.open-versions(offer.id); }
                                        page => { root.addon-page(offer.id); }
                                        install => { root.browse-install(offer.id); }
                                        install-anyway => { root.browse-install-anyway(offer.id); }
                                        update => { root.addon-update(offer.id); }
                                        update-anyway => { root.addon-update-anyway(offer.id); }
                                    }
                                }
                            }
                            // The table, and the selected addon beside it, at every size the window
                            // takes (from 960 px).
                            if root.browse-view == "table": HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 10px;
                                table-box := VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    // The tags too, where the table has room for them beside the pane.
                                    property <bool> wide: root.width >= 1240px;
                                    // The marks of the column sorted by: ▲ A to Z, oldest or fewest
                                    // first; ▼ the other way.
                                    property <string> down: root.browse-sort-reverse ? "▲" : "▼";
                                    property <string> up: root.browse-sort-reverse ? "▼" : "▲";
                                    // The headings over their columns, both clear of the scroll bar,
                                    // which is drawn over the rows' right edge.
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 14px;
                                        spacing: TableColumns.spacing;
                                        TableHead {
                                            horizontal-stretch: 1;
                                            min-width: 110px;
                                            text: "Name";
                                            sorts: true;
                                            mark: root.browse-sort == 0 ? table-box.up : "";
                                            clicked => { root.sort-table(0); }
                                        }
                                        TableHead {
                                            width: TableColumns.safety;
                                            text: "Safety";
                                        }
                                        TableHead {
                                            width: TableColumns.version;
                                            text: "Version";
                                        }
                                        if table-box.wide: TableHead {
                                            width: TableColumns.tags;
                                            text: "Tags";
                                        }
                                        TableHead {
                                            width: TableColumns.updated;
                                            text: "Last updated";
                                            sorts: true;
                                            mark: root.browse-sort == 1 ? table-box.down : "";
                                            clicked => { root.sort-table(1); }
                                        }
                                        TableHead {
                                            width: TableColumns.popularity;
                                            text: "Popularity";
                                            align: TextHorizontalAlignment.right;
                                            sorts: true;
                                            mark: root.browse-sort == 2 ? table-box.down : "";
                                            clicked => { root.sort-table(2); }
                                        }
                                        TableHead {
                                            width: TableColumns.install;
                                            text: "Install";
                                        }
                                    }
                                    Rectangle {
                                        height: 1px;
                                        background: Palette.border;
                                    }
                                    table-scroll := ScrollView {
                                        vertical-stretch: 1;
                                        content-height: table-rows.preferred-height;
                                        table-rows := VerticalLayout {
                                            width: table-scroll.visible-width;
                                            height: self.preferred-height;
                                            alignment: start;
                                            spacing: 1px;
                                            for offer in root.offer-rows: OfferTableRow {
                                                offer: offer;
                                                wide: table-box.wide;
                                                busy: root.busy;
                                                current: root.browse-panel-id == offer.id;
                                                select => {
                                                    if (root.browse-panel-id != offer.id) {
                                                        root.open-offer(offer);
                                                        browse-keys.focus();
                                                        root.browse-filter();
                                                    }
                                                }
                                                install => { root.browse-install(offer.id); }
                                                update => { root.addon-update(offer.id); }
                                                // The question the Installed tab's Remove… asks,
                                                // naming the row it removes.
                                                uninstall => {
                                                    root.remove-settings = false;
                                                    root.remove-name = offer.installed-name;
                                                    root.remove-id = offer.installed-id;
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.browse-panel-id != "": TablePane {
                                    width: max(400px, parent.width * 0.42);
                                    offer: root.panel-offer;
                                    panel: root.panel;
                                    ready: root.panel-ready;
                                    tab <=> root.table-tab;
                                    more-open: root.panel-about-open;
                                    busy: root.busy;
                                    versions: root.versions;
                                    versions-ready: root.versions.id == root.browse-panel-id && root.versions-id == root.browse-panel-id;
                                    discord-checked: root.discord-checked;
                                    close => {
                                        root.browse-panel-id = "";
                                        root.browse-close();
                                    }
                                    tab-picked(tab) => {
                                        if (tab == 1) {
                                            root.versions-id = root.browse-panel-id;
                                            root.versions-open(root.browse-panel-id);
                                        }
                                    }
                                    toggle-more => { root.panel-about-open = !root.panel-about-open; }
                                    show-scan => { root.forge-show-scan(root.browse-panel-id); }
                                    picture(i) => { root.picture-show(root.browse-panel-id, i); }
                                    frames(n) => { root.thumbs-shown(root.browse-panel-id, n); }
                                    page => { root.addon-page(root.browse-panel-id); }
                                    install => { root.browse-install(root.browse-panel-id); }
                                    install-anyway => { root.browse-install-anyway(root.browse-panel-id); }
                                    update => { root.addon-update(root.browse-panel-id); }
                                    update-anyway => { root.addon-update-anyway(root.browse-panel-id); }
                                    version-install(tag, anyway) => { root.version-install(root.browse-panel-id, tag, anyway); }
                                    version-back(backup) => { root.version-back(root.browse-panel-id, backup); }
                                }
                            }
                            Text {
                                text: root.browse-note;
                                font-size: 11px;
                                wrap: word-wrap;
                                color: Look.muted;
                            }
                        }

                        // The cards' panel: under the top row, against the right edge, at most
                        // 560 px wide; it slides in, and scrolls on its own. ✕ or Esc closes it.
                        // The list and the table show the same content in their own places.
                        panel-box := Overlay {
                            property <float> slide: root.browse-panel-id != "" && root.browse-view != "list" && root.browse-view != "table" ? 1 : 0;
                            // Before the app's answer, what the card says.
                            property <int> action: root.panel-ready ? root.panel.action : root.panel-offer.action;
                            property <string> reason: root.panel-ready ? root.panel.reason : root.panel-offer.reason;
                            property <string> about: root.panel-ready && root.panel.about != "" ? root.panel.about : root.panel-offer.summary;
                            animate slide {
                                duration: 180ms;
                                easing: ease-out;
                            }
                            visible: self.slide > 0;
                            width: min(560px, parent.width);
                            x: parent.width - self.width * self.slide;
                            y: top-row.y + top-row.height + 6px;
                            height: parent.height - self.y;
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: start;
                                        Initials {
                                            text: root.panel-offer.initials;
                                            kind: root.panel-offer.initials-kind;
                                            icon: root.panel-offer.icon;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: root.panel-offer.name;
                                            font-size: 15px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.panel-offer.author + (root.panel-ready && root.panel.verified-author ? " · verified author" : "")
                                                + (root.panel-offer.downloads != "" ? " · " + root.panel-offer.downloads : "");
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            color: Look.muted;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: start;
                                        Button {
                                            text: "✕";
                                            clicked => {
                                                root.browse-panel-id = "";
                                                root.browse-close();
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    for badge in root.panel-offer.badges: VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: badge.text;
                                            kind: badge.kind;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                panel-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    content-height: panel-list.preferred-height;
                                    panel-list := VerticalLayout {
                                        width: panel-scroll.visible-width;
                                        height: self.preferred-height;
                                        alignment: start;
                                        spacing: 8px;
                                        // Details and versions on their way.
                                        if !root.panel-ready || root.panel.loading: Installing {
                                            text: "Loading…";
                                        }
                                        if root.panel-ready && root.panel.error != "": Text {
                                            text: root.panel.error;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            color: Look.amber;
                                        }
                                        // Only while the cards show it: the panel stays in place,
                                        // hidden, in the other views.
                                        if root.browse-view != "list" && root.browse-view != "table" && root.panel-ready && root.panel.pictures.length > 0: PicturesRow {
                                            pictures: root.panel.pictures;
                                            room: panel-scroll.visible-width;
                                            open(i) => { root.picture-show(root.browse-panel-id, i); }
                                            frames(n) => { root.thumbs-shown(root.browse-panel-id, n); }
                                        }
                                        AboutBlock {
                                            panel: root.panel;
                                            ready: root.panel-ready;
                                            about: panel-box.about;
                                            more-open: root.panel-about-open;
                                            notes: false;
                                            bars: false;
                                            toggle-more => { root.panel-about-open = !root.panel-about-open; }
                                        }
                                        AboutBlock {
                                            panel: root.panel;
                                            ready: root.panel-ready;
                                            about-part: false;
                                        }
                                        if root.panel-ready && root.panel.scan != "": ScanBlock {
                                            panel: root.panel;
                                            show-scan => { root.forge-show-scan(root.panel.id); }
                                        }
                                        if root.panel-ready && root.panel.folders != "": Text {
                                            text: root.panel.folders;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            color: Look.muted;
                                        }
                                    }
                                }
                                // The action stays in sight at the foot, the reason above it.
                                if (panel-box.action == 1 || panel-box.action == 5) && panel-box.reason != "": Text {
                                    text: panel-box.reason;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    color: Look.amber;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.panel-offer.version + (root.panel-offer.date != "" ? " · " + root.panel-offer.date : "");
                                        font-size: 12px;
                                        color: Look.muted;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        text: "Versions…";
                                        clicked => { root.open-versions(root.browse-panel-id); }
                                    }
                                    Button {
                                        text: "View on GitHub";
                                        clicked => { root.addon-page(root.browse-panel-id); }
                                    }
                                    OfferAction {
                                        action: panel-box.action;
                                        busy: root.busy;
                                        install => { root.browse-install(root.browse-panel-id); }
                                        install-anyway => { root.browse-install-anyway(root.browse-panel-id); }
                                        update => { root.addon-update(root.browse-panel-id); }
                                        update-anyway => { root.addon-update-anyway(root.browse-panel-id); }
                                    }
                                }
                            }
                        }

                        // The Legend, under its link: shown while the mouse is on the link or on
                        // it, or pinned by a click on the link (✕ or a second click unpins it).
                        // Not a PopupWindow, which would close at any click outside it.
                        legend-card := Overlay {
                            visible: legend-hover.has-hover || self.hovered || root.legend-pinned;
                            x: parent.width - self.width;
                            y: top-row.y + top-row.height;
                            width: min(460px, parent.width);
                            height: legend-list.preferred-height;
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: 6px;
                            // Every badge Browse, Installed and Removed can show; short lines, so
                            // it fits under the top row at the smallest window.
                            legend-list := VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Legend";
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    if root.legend-pinned: Button {
                                        text: "✕";
                                        clicked => { root.legend-pinned = false; }
                                    }
                                }
                                LegendLine {
                                    badge: "Discord Verified";
                                    kind: 0;
                                    text: "In the game's verified-addons channel" + (root.discord-checked != "" ? ", checked on " + root.discord-checked : "");
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · verified";
                                    kind: 4;
                                    text: "An admin approved this exact file";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · scanned";
                                    kind: 4;
                                    text: "Its scan found nothing; no admin has looked yet";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · flagged";
                                    kind: 5;
                                    text: "Its scan found something: it waits for your OK";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · unscanned";
                                    kind: 5;
                                    text: "Not scanned yet: it waits for your OK";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · no longer listed";
                                    kind: 5;
                                    text: "It left SurvivorsForge's list: it waits for your OK until checked";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge · blocked";
                                    kind: 6;
                                    text: "Also · source changed and · another file: never installed; a copy you have stays, without updates";
                                }
                                LegendLine {
                                    badge: "SurvivorsForge";
                                    kind: 4;
                                    text: "From SurvivorsForge; no level when removed, off or not answering";
                                }
                                LegendLine {
                                    badge: "Added by you";
                                    kind: 1;
                                    text: "Added by its GitHub link; it asks before each update";
                                }
                                LegendLine {
                                    badge: "From a file";
                                    kind: 2;
                                    text: "Imported from a zip file";
                                }
                                LegendLine {
                                    badge: "Installed by hand";
                                    kind: 3;
                                    text: "Found in AddOns, not installed by the Satchel";
                                }
                                LegendLine {
                                    badge: "No longer listed";
                                    kind: 1;
                                    text: "It left the Discord Verified list: no updates";
                                }
                                Text {
                                    text: "Tags: our list's groups and SurvivorsForge's categories";
                                    font-size: 11px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.browse-tag-line;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    color: Look.muted;
                                }
                            }
                        }
                    }
                }

                if root.addons-page == 2: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    Text {
                        text: "A GitHub link, or owner/name";
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.link-text;
                            placeholder-text: "github.com/owner/addon";
                            horizontal-stretch: 1;
                            accepted(text) => { root.link-lookup(text); }
                        }
                        Button {
                            text: "Look up";
                            enabled: root.link-text != "" && root.link-state != 1;
                            clicked => { root.link-lookup(root.link-text); }
                        }
                    }
                    if root.link-state == 1: Text {
                        text: root.link-message;
                        color: Look.muted;
                    }
                    if root.link-state == 3: Text {
                        text: root.link-message;
                        wrap: word-wrap;
                        color: Look.red;
                    }
                    if root.link-state == 2: Rectangle {
                        border-width: root.link-warn ? 2px : 1px;
                        border-color: root.link-warn ? Look.red : Palette.border;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Field {
                                label: "Owner";
                                value: root.link-owner;
                            }
                            Field {
                                label: "Latest release";
                                value: root.link-release;
                            }
                            Field {
                                label: "Goes into AddOns";
                                value: root.link-goes;
                            }
                            Text {
                                text: root.link-note;
                                wrap: word-wrap;
                                font-weight: root.link-warn ? 600 : 400;
                                color: root.link-warn ? Look.red : Look.muted;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "Or a zip file, as friends share them on Discord. Addons are text, pictures, fonts and sounds; anything else in a zip is left out.";
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Look.muted;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: "Import a zip file…";
                            enabled: !root.busy;
                            clicked => { root.import-zip(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if (root.link-state == 2 || root.link-state == 3) && !root.link-installing: Button {
                            text: "Cancel";
                            clicked => { root.link-clear(); }
                        }
                        if root.link-installing: Installing {}
                        if !root.link-installing: Button {
                            text: "Install";
                            primary: true;
                            enabled: root.link-state == 2 && !root.busy;
                            clicked => { root.link-install(); }
                        }
                    }
                }

                if root.addons-page == 3: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    Text {
                        text: root.removed-rows.length == 0
                            ? "Nothing removed on this PC yet. Addons you remove show here, with the way back."
                            : "Removed on this PC, newest first. Their folders are in the Recycle Bin; Install again brings back the version each had.";
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Look.muted;
                    }
                    removed-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-height: removed-list.preferred-height;
                        removed-list := VerticalLayout {
                            width: removed-scroll.visible-width;
                            height: self.preferred-height;
                            alignment: start;
                            spacing: 6px;
                            for row in root.removed-rows: RemovedItem {
                                removed: row;
                                busy: root.busy;
                                install => { root.install-again(row.id); }
                                install-anyway => { root.install-again-anyway(row.id); }
                            }
                        }
                    }
                }
            }
            if !root.game-found: Overlay {
                NoGame {
                    find => { root.find-game(); }
                    choose => { root.tab = 4; }
                    get-game => { root.open-game-site(); }
                }
            }
        }

        Tab {
            title: "Saves";
            VerticalBox {
                // The tab's own column, at its width from before the window grew, centred.
                width: min(680px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                Text {
                    text: root.saves-note;
                    wrap: word-wrap;
                    color: Look.muted;
                }
                StandardTableView {
                    vertical-stretch: 1;
                    columns: [
                        { title: "#", width: 44px },
                        { title: "Saved", width: 130px },
                        { title: "PC", width: 116px },
                        { title: "Size", width: 76px },
                        { title: "", horizontal-stretch: 1 }
                    ];
                    rows: root.save-rows;
                    current-row <=> root.save-row;
                }
                HorizontalBox {
                    padding: 0;
                    alignment: end;
                    Button {
                        text: "Show in folder";
                        enabled: root.save-row >= 0;
                        clicked => { root.show-in-folder(root.save-row); }
                    }
                    Button {
                        text: "Bring this one in";
                        enabled: root.save-row >= 0 && !root.busy;
                        clicked => { root.bring-back(root.save-row); }
                    }
                }
            }
            if !root.game-found: Overlay {
                NoGame {
                    find => { root.find-game(); }
                    choose => { root.tab = 4; }
                    get-game => { root.open-game-site(); }
                }
            }
        }

        Tab {
            title: "Playtime";
            VerticalBox {
                // The tab's own column, at its width from before the window grew, centred.
                width: min(680px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                HorizontalBox {
                    padding: 0;
                    Card {
                        heading: "Today";
                        main: root.today;
                    }
                    Card {
                        heading: "This week";
                        main: root.week;
                    }
                    Card {
                        heading: "All time";
                        main: root.all-time;
                    }
                }
                Text {
                    text: "This week, per PC";
                    font-weight: 600;
                }
                for row in root.pc-times: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: row.name;
                        width: 100px;
                        overflow: elide;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Rectangle {
                            height: 14px;
                            border-radius: 3px;
                            background: Palette.alternate-background;
                            Rectangle {
                                x: 0;
                                width: parent.width * row.share;
                                height: parent.height;
                                border-radius: 3px;
                                background: Look.blue;
                            }
                        }
                    }
                    Text {
                        text: row.time;
                        width: 80px;
                        horizontal-alignment: right;
                    }
                }
                Text {
                    text: "Last sessions";
                    font-weight: 600;
                }
                for line in root.sessions: Text {
                    text: line;
                    overflow: elide;
                }
                Rectangle { vertical-stretch: 1; }
            }
            if !root.game-found: Overlay {
                NoGame {
                    find => { root.find-game(); }
                    choose => { root.tab = 4; }
                    get-game => { root.open-game-site(); }
                }
            }
        }

        Tab {
            title: "Settings";
            VerticalBox {
                // The tab's own column, at its width from before the window grew, centred.
                width: min(680px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                // The fields scroll; Default and Save stay at the foot.
                settings-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-height: settings-list.preferred-height;
                    settings-list := VerticalLayout {
                        width: settings-scroll.visible-width - 14px;
                        height: self.preferred-height;
                        alignment: start;
                        spacing: 8px;
                        Section {
                            GroupHeading { text: "General"; }
                            Text {
                                text: "Game folder";
                                font-weight: 600;
                            }
                            HorizontalBox {
                                padding: 0;
                                LineEdit {
                                    text <=> root.game-dir;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Find it";
                                    clicked => { root.detect-game(); }
                                }
                            }
                            Text {
                                text: root.game-status;
                                color: Look.muted;
                            }
                            Text {
                                text: "This PC's name";
                                font-weight: 600;
                            }
                            LineEdit {
                                text <=> root.pc-name;
                            }
                            if root.name-status != "": Text {
                                text: root.name-status;
                                color: Look.muted;
                                wrap: word-wrap;
                            }
                            CheckBox {
                                text: "Start with Windows, in the tray";
                                checked <=> root.start-with-windows;
                            }
                            CheckBox {
                                text: "Desktop shortcut \"Play Azeroth Survivors\"";
                                checked <=> root.desktop-shortcut;
                            }
                            CheckBox {
                                text: "Windows notifications";
                                checked <=> root.notifications;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Theme";
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["System", "Light", "Dark"];
                                    current-index <=> root.theme;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        Section {
                            alternate: true;
                            GroupHeading { text: "Sync"; }
                            CheckBox {
                                text: "Sync my progress across PCs";
                                checked <=> root.sync-switch;
                            }
                            if root.sync-switch: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    Text {
                                        text: "◉ Local network folder";
                                    }
                                    Text {
                                        text: "○ Cloud (maybe later)";
                                        color: Look.muted;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                LineEdit {
                                    text <=> root.sync-folder;
                                    placeholder-text: "Network folder, e.g. \\\\server\\share\\Azeroth Survivors Saves";
                                }
                                Text {
                                    text: root.folder-status;
                                    color: Look.muted;
                                    wrap: word-wrap;
                                }
                            }
                            if root.sync-switch: CheckBox {
                                text: "The game's own settings on every PC";
                                checked <=> root.game-shared;
                            }
                            if root.sync-switch && root.game-shared: Text {
                                text: "Interface options, key bindings, macros, chat, camera, where windows sit, and the HUD switches. Graphics stay on each PC.";
                                font-size: 11px;
                                color: Look.muted;
                                wrap: word-wrap;
                            }
                            if root.sync-switch && root.game-shared && root.game-line != "": Text {
                                text: root.game-line;
                                font-size: 11px;
                                color: root.game-line-kind == 2 ? Look.amber : root.game-line-kind == 1 ? Look.blue : Look.muted;
                                wrap: word-wrap;
                            }
                            if root.sync-switch && root.game-shared && root.game-ask-pc != "": HorizontalBox {
                                padding: 0;
                                alignment: start;
                                Button {
                                    text: "Keep this PC's";
                                    clicked => { root.game-settings-choice(true); }
                                }
                                Button {
                                    text: "Use " + root.game-ask-pc + "'s";
                                    clicked => { root.game-settings-choice(false); }
                                }
                            }
                            if root.sync-switch && root.game-shared && root.game-own != "": HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.game-own;
                                    font-size: 11px;
                                    color: Look.muted;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Use them instead";
                                    clicked => { root.game-settings-own(); }
                                }
                            }
                            if root.game-note != "": Text {
                                text: root.game-note;
                                font-size: 11px;
                                color: Look.blue;
                                wrap: word-wrap;
                            }
                        }
                        Section {
                            GroupHeading { text: "Addons"; }
                            CheckBox {
                                text: "Updates go in by themselves before Play";
                                checked <=> root.addons-auto;
                            }
                            // A CheckBox's words stay on one line: who it is for goes under it.
                            Text {
                                text: "For Discord Verified and SurvivorsForge addons; one you added by link always asks first.";
                                font-size: 11px;
                                wrap: word-wrap;
                                color: Look.muted;
                            }
                            if root.sync-switch: CheckBox {
                                text: "The same addons and their settings on every PC";
                                checked <=> root.addons-shared;
                            }
                            // Sources: where addons come from. Inside this Section, so the groups'
                            // alternating backgrounds stay as they are.
                            Text {
                                text: "Sources";
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "✓";
                                    width: 14px;
                                    color: Look.green;
                                }
                                Text {
                                    text: "Discord Verified: the addons in the game's verified-addons channel"
                                        + (root.discord-checked != "" ? ", checked on " + root.discord-checked : "")
                                        + "; built into this Satchel";
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                            CheckBox {
                                text: "More addons, descriptions and trust levels from SurvivorsForge";
                                checked <=> root.addons-forge;
                            }
                            HorizontalLayout {
                                padding-left: 28px;
                                spacing: 12px;
                                LinkText {
                                    text: "SurvivorsForge on GitHub";
                                    ink: Look.blue;
                                    font-size: 12px;
                                    clicked => { root.open-link(root.forge-repo-url); }
                                }
                                LinkText {
                                    text: "SurvivorsForge website";
                                    ink: Look.blue;
                                    font-size: 12px;
                                    clicked => { root.open-link(root.forge-site-url); }
                                }
                                Text {
                                    text: root.forge-answer;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    color: root.forge-offline ? Look.amber : Look.muted;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "✓";
                                    width: 14px;
                                    color: Look.green;
                                }
                                Text {
                                    text: "Addons you add by link or from a zip file";
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        Section {
                            alternate: true;
                            GroupHeading { text: "Game"; }
                            CheckBox {
                                text: "Pause the game when I switch away (experimental)";
                                checked <=> root.pause-when-away;
                            }
                            if root.pause-when-away: Text {
                                text: "When the game stops being the window in front (Alt-Tab, the Windows key, a click elsewhere), the Satchel presses Esc in it. If a menu is already open, that Esc closes it.";
                                font-size: 11px;
                                color: Look.muted;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Saved in " + root.settings-path;
                                font-size: 11px;
                                color: Look.muted;
                                wrap: word-wrap;
                            }
                        }
                        Section {
                            GroupHeading { text: "About"; }
                            Rectangle {
                                border-width: 1px;
                                border-color: Palette.border;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: start;
                                        Image {
                                            source: @image-url("icons/satchel.svg");
                                            width: 48px;
                                            height: 48px;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text {
                                            text: "Survivor's Satchel";
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: root.app-version;
                                            font-size: 24px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: (root.app-released != "" ? root.app-released + " · " : "") + root.app-build;
                                            font-size: 11px;
                                            color: Look.muted;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Button {
                                                text: "What's new";
                                                clicked => { root.open-whats-new(); }
                                            }
                                            // "Checking…" in its place until the answer: a second
                                            // click can't ask again.
                                            if !root.checking: Button {
                                                text: "Check for updates";
                                                clicked => { root.check-updates(); }
                                            }
                                            if root.checking: Installing {
                                                text: "Checking…";
                                            }
                                            if root.update-version != "": Button {
                                                text: "Update to " + root.update-version;
                                                primary: true;
                                                enabled: !root.busy;
                                                clicked => { root.update-now(); }
                                            }
                                        }
                                        // Hidden while a check runs (the last result would
                                        // mislead) until its answer.
                                        if root.check-result != "" && !root.checking: Text {
                                            text: root.check-result;
                                            font-size: 11px;
                                            color: Look.muted;
                                            wrap: word-wrap;
                                        }
                                        // Report a problem opens the bug report form with this
                                        // version filled in.
                                        if root.repo-url != "": HorizontalLayout {
                                            spacing: 12px;
                                            alignment: start;
                                            // The link's line, centred beside the button.
                                            VerticalLayout {
                                                alignment: center;
                                                LinkText {
                                                    text: "Source and issues on GitHub";
                                                    ink: Look.blue;
                                                    font-size: 12px;
                                                    clicked => { root.open-url(root.repo-url); }
                                                }
                                            }
                                            Button {
                                                text: "Report a problem";
                                                clicked => { root.open-url(root.issue-url); }
                                            }
                                        }
                                        // Slint's licence asks for this in an About screen until the
                                        // README carries its badge; the logo scales with the width.
                                        // In a row of its own: a fixed width straight in this column
                                        // would cap the column's width, and wrap the lines above.
                                        HorizontalLayout {
                                            AboutSlint {
                                                width: 180px;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }
                            }
                            // Where addons come from: both lists, and SurvivorsForge's credit.
                            Rectangle {
                                border-width: 1px;
                                border-color: Palette.border;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text {
                                        text: "Where addons come from";
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Discord Verified: the addons confirmed in the game's verified-addons channel on Discord. The list is built into the Satchel"
                                            + (root.discord-checked != "" ? ", as we last checked the channel on " + root.discord-checked : "")
                                            + ", and each addon downloads from its author's own GitHub releases.";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "SurvivorsForge: Rezondes' addon registry, which scans every version of the addons it lists, while its admins approve exact files. The Satchel shows its trust levels and follows them: a version it blocks never installs, and one it flags, or hasn't scanned yet, waits for your OK. It can be turned off above, under Addons.";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        LinkText {
                                            text: "SurvivorsForge on GitHub";
                                            ink: Look.blue;
                                            font-size: 12px;
                                            clicked => { root.open-link(root.forge-repo-url); }
                                        }
                                        LinkText {
                                            text: "SurvivorsForge website";
                                            ink: Look.blue;
                                            font-size: 12px;
                                            clicked => { root.open-link(root.forge-site-url); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                            // Where the game's patch notes come from: its update server, and the
                            // notes file in the Satchel's repository, with when each last answered.
                            Rectangle {
                                border-width: 1px;
                                border-color: Palette.border;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text {
                                        text: "Where the game's patch notes come from";
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "The newest build's note comes from the game's own update server, the file Azeroth Survivors reads to update itself (" + root.game-news-latest-answer + ").";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "The full notes come from game/patch-notes.md in the Satchel's repository, kept by hand from the game's Discord posts; an edit there reaches every PC within half an hour, without an update of the Satchel (" + root.game-news-notes-answer + ").";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Button {
                                            text: "What's new in the game";
                                            clicked => { root.open-game-news(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalBox {
                    padding: 0;
                    alignment: end;
                    Button {
                        text: "Default";
                        clicked => { root.default-settings(); }
                    }
                    Button {
                        text: "Save";
                        primary: root.settings-changed;
                        enabled: root.settings-changed;
                        clicked => { root.save-settings(); }
                    }
                }
            }
        }
    }

    // Versions… over the window, for the addon it was asked for: newest first, one button each.
    // Esc or Close closes it.
    if root.versions-overlay: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        versions-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-versions();
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                // Its column, at most 760 px wide, centred.
                width: min(760px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Versions of " + (root.versions.id == root.versions-id && root.versions.name != "" ? root.versions.name : "…");
                        font-size: 20px;
                        font-weight: 700;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: start;
                        Button {
                            text: "Close";
                            clicked => { root.close-versions(); }
                        }
                    }
                }
                Text {
                    text: "Newest first: the version installed, the ones kept on this PC to go back to, and every release known. A version you install or go back to here stays until you let it update.";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }
                // What the last action did, as the Addons tab says it under this.
                if root.addons-message != "": Rectangle {
                    border-radius: 6px;
                    background: Look.note-paper;
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.addons-message;
                            wrap: word-wrap;
                            color: Look.ink;
                        }
                    }
                }
                VersionsList {
                    vertical-stretch: 1;
                    versions: root.versions;
                    ready: root.versions.id == root.versions-id;
                    busy: root.busy;
                    install(tag, anyway) => { root.version-install(root.versions-id, tag, anyway); }
                    back(backup) => { root.version-back(root.versions-id, backup); }
                }
            }
        }
    }

    // The picture viewer: a box over the window, the window darkened behind it. In the box, the
    // title line with ✕, the open addon's screenshot `viewer-index` fitted inside at most 80 % of
    // the window's height, previous and next as round buttons on its edges (the arrow keys too),
    // and its caption under it. Esc, ✕, a click on the picture or on the darkened window closes it;
    // the buttons never do. Its pixels come from the app, and only the one shown is held.
    if root.viewer-open: viewer-box := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        property <int> count: root.panel-ready ? root.panel.pictures.length : 0;
        property <string> caption: self.count > root.viewer-index ? root.panel.pictures[root.viewer-index].caption : "";
        property <bool> has-previous: root.viewer-index > 0;
        property <bool> has-next: root.viewer-index + 1 < self.count;
        // The box's width; the picture's area as tall as its shape asks, at most 80 % of the
        // window's height and always room for the title line and the caption.
        property <length> box-width: min(1000px, root.width * 0.8);
        property <float> shape: self.count > root.viewer-index && root.panel.pictures[root.viewer-index].width > 0
            ? root.panel.pictures[root.viewer-index].height / root.panel.pictures[root.viewer-index].width : 0.5625;
        property <length> picture-height: min(min(root.height * 0.8, root.height - 116px), (self.box-width - 24px) * self.shape);
        viewer-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.picture-close();
                    return accept;
                }
                if (event.text == Key.LeftArrow && viewer-box.has-previous) {
                    root.picture-show(root.browse-panel-id, root.viewer-index - 1);
                    return accept;
                }
                if (event.text == Key.RightArrow && viewer-box.has-next) {
                    root.picture-show(root.browse-panel-id, root.viewer-index + 1);
                    return accept;
                }
                return reject;
            }
            // The window darkened behind the box: a click on it closes the viewer.
            Rectangle {
                background: #000000a6;
            }
            TouchArea {
                clicked => { root.picture-close(); }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: viewer-box.box-width;
                height: box-layout.preferred-height;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;
                // A click on the box, off the picture and the buttons, does nothing.
                TouchArea { }
                box-layout := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.panel-offer.name + " · picture " + (root.viewer-index + 1) + " of " + max(1, viewer-box.count);
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "✕";
                            clicked => { root.picture-close(); }
                        }
                    }
                    Rectangle {
                        height: viewer-box.picture-height;
                        border-radius: 6px;
                        background: Look.dark ? #0b0e13 : #1d2433;
                        if root.viewer-state == 1: Image {
                            source: root.viewer-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                            accessible-role: image;
                            accessible-label: viewer-box.caption != "" ? viewer-box.caption : "Picture " + (root.viewer-index + 1);
                        }
                        if root.viewer-state == 0: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Spinner {
                                    indeterminate: true;
                                    width: 28px;
                                    height: 28px;
                                }
                            }
                        }
                        if root.viewer-state == 2: Text {
                            text: "This picture isn't available.";
                            color: #c7ccd4;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // A click on the picture closes the viewer.
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.picture-close(); }
                        }
                        RoundButton {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            next: false;
                            enabled: viewer-box.has-previous;
                            clicked => { root.picture-show(root.browse-panel-id, root.viewer-index - 1); }
                        }
                        RoundButton {
                            x: parent.width - self.width - 10px;
                            y: (parent.height - self.height) / 2;
                            next: true;
                            enabled: viewer-box.has-next;
                            clicked => { root.picture-show(root.browse-panel-id, root.viewer-index + 1); }
                        }
                    }
                    if viewer-box.caption != "": Text {
                        text: viewer-box.caption;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    if root.whats-new-open: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at most 760 px wide, centred.
            width: min(760px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "What's new";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    text: "Close";
                    clicked => { root.whats-new-open = false; }
                }
            }
            Text {
                text: "Survivor's Satchel " + root.app-version + (root.app-released != "" ? ", " + root.app-released : "") + ". What changed in each version, newest first.";
                font-size: 12px;
                wrap: word-wrap;
                color: Look.muted;
            }
            changelog-scroll := ScrollView {
                vertical-stretch: 1;
                content-height: changelog-list.preferred-height;
                changelog-list := VerticalLayout {
                    width: changelog-scroll.visible-width - 14px;
                    height: self.preferred-height;
                    alignment: start;
                    spacing: 6px;
                    for entry in root.changelog: ChangelogItem {
                        entry: entry;
                        current: entry.version == root.app-version;
                        open: root.changelog-open == entry.version;
                        toggle => { root.changelog-open = root.changelog-open == entry.version ? "" : entry.version; }
                    }
                }
            }
        }
    }

    // The game's patch notes over the window, newest first, every version open: the newest
    // build's note from the game's update server, the full notes from the Satchel's repository.
    // Esc or Close closes it.
    if root.game-news-open: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        news-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.game-news-open = false;
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                // Its column, at most 760 px wide, centred.
                width: min(760px, parent.width);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                y: 0;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "What's new in the game";
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Close";
                        clicked => { root.game-news-open = false; }
                    }
                }
                Text {
                    text: "Azeroth Survivors' patch notes, newest first: the newest build's note from the game's own update server, and the full notes kept with the Satchel. The text is the game developer's.";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Look.muted;
                }
                if root.game-notes-empty != "": Text {
                    text: root.game-notes-empty;
                    wrap: word-wrap;
                }
                news-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-height: news-list.preferred-height;
                    news-list := VerticalLayout {
                        width: news-scroll.visible-width - 14px;
                        height: self.preferred-height;
                        alignment: start;
                        spacing: 6px;
                        for entry in root.game-notes: GameNoteItem {
                            entry: entry;
                            current: entry.version == root.game-news-version;
                        }
                        if root.game-notes-footer != "": Text {
                            text: root.game-notes-footer;
                            font-size: 12px;
                            color: Look.muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    if root.remove-id != "": Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at most 760 px wide, centred.
            width: min(760px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            alignment: start;
            Text {
                text: "Remove " + root.remove-name + "?";
                font-size: 20px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: "Its folder goes to the Recycle Bin, so you can still get it back from there.";
                wrap: word-wrap;
            }
            CheckBox {
                text: "Also remove its settings (where its windows sit, what it shows)";
                checked <=> root.remove-settings;
            }
            Text {
                text: "A copy of its settings stays in the Satchel's backups either way.";
                font-size: 12px;
                wrap: word-wrap;
                color: Look.muted;
            }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.remove-id = ""; }
                }
                Button {
                    text: "Remove";
                    primary: true;
                    clicked => {
                        root.addon-remove(root.remove-id, !root.remove-settings);
                        root.remove-id = "";
                    }
                }
            }
        }
    }

    if root.needs-you: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at most 760 px wide, centred.
            width: min(760px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            alignment: start;
            Text {
                text: "Needs you";
                font-size: 20px;
                font-weight: 700;
                color: Look.red;
            }
            Text {
                text: "Two PCs moved on separately";
                font-weight: 600;
            }
            Text {
                text: "Your progress changed here and on " + root.needs-other-pc + " since this PC last synced. Pick the one to continue with. The other one is kept as a version.";
                wrap: word-wrap;
            }
            HorizontalBox {
                padding: 0;
                Card {
                    heading: "This PC";
                    main: "Keep this PC's";
                    detail: root.needs-here;
                }
                Card {
                    heading: "Network folder · from " + root.needs-other-pc;
                    main: "Use " + root.needs-other-pc + "'s";
                    detail: root.needs-other;
                }
            }
            HorizontalBox {
                padding: 0;
                Button {
                    text: "Keep this PC's";
                    horizontal-stretch: 1;
                    clicked => { root.keep-here(); }
                }
                Button {
                    text: "Use " + root.needs-other-pc + "'s";
                    horizontal-stretch: 1;
                    clicked => { root.use-other(); }
                }
            }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button {
                    text: "Decide later";
                    clicked => { root.decide-later(); }
                }
            }
        }
    }

    if root.setup: Overlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalBox {
            // Its column, at the other tabs' width, centred.
            width: min(680px, parent.width);
            height: parent.height;
            x: (parent.width - self.width) / 2;
            y: 0;
            alignment: start;
            Text {
                text: "Welcome to Survivor's Satchel";
                font-size: 20px;
                font-weight: 700;
            }
            Text {
                text: "1 · The game";
                font-weight: 600;
            }
            HorizontalBox {
                padding: 0;
                LineEdit {
                    text <=> root.game-dir;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Find it";
                    clicked => { root.detect-game(); }
                }
            }
            Text {
                text: root.game-status;
                color: Look.muted;
            }
            Text {
                text: "2 · Do you play on more than one PC?";
                font-weight: 600;
            }
            CheckBox {
                text: "Yes: sync my progress across PCs";
                checked <=> root.sync-switch;
            }
            if root.sync-switch: VerticalLayout {
                spacing: 4px;
                LineEdit {
                    text <=> root.sync-folder;
                    placeholder-text: "Network folder, e.g. \\\\server\\share\\Azeroth Survivors Saves";
                }
                if root.folder-status != "": Text {
                    text: root.folder-status;
                    color: Look.muted;
                    wrap: word-wrap;
                }
            }
            Text {
                text: "3 · This PC";
                font-weight: 600;
            }
            LineEdit {
                text <=> root.pc-name;
            }
            if root.setup-pick && root.sync-switch: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Start from which progress? Whichever you pick, the other one is kept.";
                    wrap: word-wrap;
                }
                Choice {
                    selected: root.setup-choice == 0;
                    heading: "This PC's";
                    detail: root.setup-here;
                    picked => { root.setup-choice = 0; }
                }
                Choice {
                    selected: root.setup-choice == 1;
                    heading: "The newest in the network folder";
                    detail: root.setup-other;
                    picked => { root.setup-choice = 1; }
                }
            }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button {
                    text: "Finish";
                    primary: true;
                    clicked => { root.finish-setup(); }
                }
            }
        }
    }
}
